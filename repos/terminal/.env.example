# Terminal Vessel Configuration

# Instance identifier
INSTANCE_ID=terminal-vessel-1

# Server mode: 'http' | 'stdio' | 'both'
MODE=http

# HTTP server port (for vessel discovery)
PORT=8080

# Vessel endpoint (how other vessels reach this one)
VESSEL_ENDPOINT=http://localhost:8080

# Activity API endpoint (for vessel registration)
ACTIVITY_API_ENDPOINT=https://activity.metabob.local

# Environment
NODE_ENV=development
