{
  "name": "@metabob/proto",
  "version": "0.1.0",
  "description": "Protocol Buffer definitions for the Metabob ecosystem",
  "main": "gen/typescript/index.ts",
  "types": "gen/typescript/index.d.ts",
  "scripts": {
    "generate": "./scripts/generate.sh",
    "generate:python": "protoc --python_out=gen/python --pyi_out=gen/python --proto_path=proto proto/metabob/**/*.proto",
    "lint": "../buf lint",
    "format": "../buf format -w",
    "breaking": "../buf breaking --against '.git#branch=main'",
    "clean": "rm -rf gen/"
  },
  "keywords": [
    "protobuf",
    "metabob",
    "activity-system",
    "types"
  ],
  "author": "Metabob",
  "license": "PROPRIETARY",
  "devDependencies": {
    "@bufbuild/buf": "^1.47.2",
    "@types/node": "^25.2.1",
    "ts-proto": "^2.11.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "long": "^5.2.3"
  },
  "files": [
    "gen/typescript/**/*",
    "gen/python/**/*",
    "proto/**/*.proto"
  ]
}
