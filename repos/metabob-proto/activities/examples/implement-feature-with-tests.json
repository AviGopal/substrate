{
  "id": "example-implement-feature-tdd",
  "name": "Implement Feature (Test-Driven)",
  "description": "Implement a feature with comprehensive test validation",
  "tags": [
    "example.code.implementation",
    "validation.external.test",
    "tdd"
  ],
  "input_shapes": ["goal", "existing_code", "test_specification"],
  "output_shapes": ["source_code", "test_code", "test_results"],
  "tasks": [
    {
      "id": "write-tests",
      "description": "Write comprehensive test cases following TDD approach",
      "resolver": "llm",
      "prompt": {
        "template": "Write test cases for: {{goal}}\n\nTest framework: Bun Test\n\nExisting code context:\n{{impulse:existing_code}}\n\nRequirements:\n- Test the happy path (expected successful behavior)\n- Test edge cases (boundary conditions, empty inputs, etc.)\n- Test error handling (invalid inputs, error states)\n- Use descriptive test names\n- Follow Bun Test syntax with describe/it/expect\n- Each test should be independent and not rely on others\n\nReturn the complete test file content."
      },
      "impulseReferences": [
        {
          "id": "existing_code",
          "ref": "file:{{sourceFilePath}}",
          "priority": "high",
          "budget": 3000
        }
      ],
      "validation": {
        "requiredPatterns": [
          "describe\\(",
          "it\\(",
          "expect\\("
        ]
      }
    },
    {
      "id": "save-tests",
      "description": "Save test file",
      "resolver": "file",
      "resolverRequirements": {
        "resolver": "file",
        "config": {
          "operation": "write"
        }
      },
      "impulseReferences": [
        {
          "id": "file_path",
          "ref": "memo:{{testFilePath}}",
          "priority": "required",
          "budget": 100
        },
        {
          "id": "content",
          "ref": "task-write-tests-output",
          "priority": "required",
          "budget": 3000
        }
      ]
    },
    {
      "id": "implement-feature",
      "description": "Implement feature to pass the tests",
      "resolver": "llm",
      "prompt": {
        "template": "Implement: {{goal}}\n\nTests to pass:\n{{impulse:test_code}}\n\nExisting code:\n{{impulse:existing_code}}\n\nRequirements:\n- Implement only what's needed to pass the tests\n- Follow existing code style and conventions\n- Add proper error handling\n- Include JSDoc comments for public functions\n- Keep code clean and maintainable\n\nReturn the complete implementation."
      },
      "impulseReferences": [
        {
          "id": "test_code",
          "ref": "task-write-tests-output",
          "priority": "required",
          "budget": 3000
        },
        {
          "id": "existing_code",
          "ref": "file:{{sourceFilePath}}",
          "priority": "high",
          "budget": 3000
        }
      ],
      "validation": {
        "requiredPatterns": [
          "function|const|class|export"
        ],
        "forbiddenPatterns": [
          {
            "file": "{{sourceFilePath}}",
            "pattern": "console\\.log|debugger"
          }
        ]
      }
    },
    {
      "id": "save-implementation",
      "description": "Save implementation file",
      "resolver": "file",
      "resolverRequirements": {
        "resolver": "file",
        "config": {
          "operation": "write"
        }
      },
      "impulseReferences": [
        {
          "id": "file_path",
          "ref": "memo:{{sourceFilePath}}",
          "priority": "required",
          "budget": 100
        },
        {
          "id": "content",
          "ref": "task-implement-feature-output",
          "priority": "required",
          "budget": 5000
        }
      ]
    },
    {
      "id": "run-tests",
      "description": "Run test suite to validate implementation",
      "resolver": "external-validation",
      "resolverRequirements": {
        "resolver": "external-validation",
        "config": {
          "validationType": "test_suite",
          "command": "bun test {{testFilePath}}",
          "framework": "bun",
          "minimumPassed": 3,
          "timeout": 30000
        }
      },
      "retry": {
        "maxAttempts": 2,
        "strategy": "progressive-context",
        "contextEnhancement": {
          "onRetry": "Include test failure details in context for debugging"
        }
      }
    },
    {
      "id": "run-lint",
      "description": "Check code quality with linter",
      "resolver": "external-validation",
      "resolverRequirements": {
        "resolver": "external-validation",
        "config": {
          "validationType": "command",
          "command": "bun run lint {{sourceFilePath}}",
          "expectedOutput": "0 errors",
          "retriable": false,
          "timeout": 10000
        }
      }
    }
  ],
  "variables": [
    {
      "name": "goal",
      "type": "string",
      "description": "Feature to implement (e.g., 'user authentication with JWT')"
    },
    {
      "name": "sourceFilePath",
      "type": "string",
      "description": "Path to source file to implement (e.g., 'src/auth.ts')"
    },
    {
      "name": "testFilePath",
      "type": "string",
      "description": "Path to test file (e.g., 'test/auth.test.ts')"
    }
  ],
  "metadata": {
    "created_by": "system",
    "created_at": "2026-04-08",
    "purpose": "Example template demonstrating TDD with external test validation",
    "external_validation": true,
    "external_validation_types": ["test_suite", "command"]
  }
}
