{
  "tabular_data": {
    "type": "data-table-v2",
    "defaults": { "pageSize": 20 }
  },
  "activityExecutionTrace": {
    "type": "container",
    "defaults": { "layout": "vertical" },
    "children": [
      { "type": "progress", "defaults": {} },
      { "type": "data-table-v2", "defaults": { "pageSize": 10 } }
    ]
  },
  "markdown_document": {
    "type": "text",
    "defaults": { "variant": "prose" }
  },
  "bash_output": {
    "type": "code",
    "defaults": { "language": "bash", "showLineNumbers": false }
  },
  "activity_execution_trace": {
    "type": "container",
    "defaults": { "layout": "vertical" },
    "children": [
      { "type": "progress", "defaults": {} },
      { "type": "data-table-v2", "defaults": { "pageSize": 10 } }
    ]
  },
  "activityTemplate": {
    "type": "data-table-v2",
    "defaults": { "pageSize": 10, "columns": ["id", "name", "category", "description"] }
  },
  "executionTraceList": {
    "type": "data-table-v2",
    "defaults": { "pageSize": 20, "columns": ["id", "templateId", "status", "durationMs", "createdAt"] }
  },
  "concept": {
    "type": "container",
    "defaults": { "layout": "vertical" },
    "children": [
      { "type": "text", "defaults": {} },
      { "type": "badge", "defaults": {} }
    ]
  },
  "conceptGraph": {
    "type": "graph",
    "defaults": {}
  },
  "validation_result": {
    "type": "container",
    "defaults": { "layout": "vertical" },
    "children": [
      { "type": "badge", "defaults": {} },
      { "type": "text", "defaults": {} }
    ]
  },
  "goal": {
    "type": "container",
    "defaults": { "layout": "vertical" },
    "children": [
      { "type": "text", "defaults": {} },
      { "type": "progress", "defaults": {} }
    ]
  },
  "source_code": {
    "type": "code",
    "defaults": { "language": "typescript", "showLineNumbers": true }
  },
  "problem_detection": {
    "type": "data-table-v2",
    "defaults": { "pageSize": 20, "columns": ["severity", "message", "file", "line"] }
  },
  "user_intent": {
    "type": "container",
    "defaults": { "layout": "vertical" }
  },
  "activityMetrics": {
    "type": "chart",
    "defaults": { "chartType": "bar" }
  },
  "vesselPerformanceMetrics": {
    "type": "data-table-v2",
    "defaults": { "pageSize": 20 }
  }
}
