{
  "id": "react-renderer",
  "version": "0.1.0",
  "name": "React Renderer",
  "description": "UI rendering vessel - resolves ui_component impulses to rendered primitives",

  "resolvers": [
    {
      "type": "ui_component",
      "description": "Renders primitive compositions as React components",
      "protocol": "http",
      "endpoint": "/resolve/ui_component"
    },
    {
      "type": "ui_state",
      "description": "Resolves UI application state paths",
      "protocol": "http",
      "endpoint": "/resolve/ui_state"
    },
    {
      "type": "viewport_state",
      "description": "Resolves current viewport configuration",
      "protocol": "http",
      "endpoint": "/resolve/viewport_state"
    },
    {
      "type": "layout_change",
      "description": "Patches position, size, or layer on an existing ui_component impulse",
      "protocol": "http",
      "endpoint": "/resolve/layout_change"
    },
    {
      "type": "style_change",
      "description": "Patches className or variant on the root primitive of a ui_component impulse",
      "protocol": "http",
      "endpoint": "/resolve/style_change"
    },
    {
      "type": "component_change",
      "description": "Replaces the root primitive on an existing ui_component impulse",
      "protocol": "http",
      "endpoint": "/resolve/component_change"
    },
    {
      "type": "data_source_change",
      "description": "Patches the data field on a data-table or chart primitive",
      "protocol": "http",
      "endpoint": "/resolve/data_source_change"
    },
    {
      "type": "ui_event",
      "description": "Dequeues one browser action event from the in-process event queue",
      "protocol": "http",
      "endpoint": "/resolve/ui_event"
    },
    {
      "type": "composition_metric",
      "description": "Records UI composition outcome metrics to activity-api",
      "protocol": "http",
      "endpoint": "/resolve/composition_metric"
    }
  ],

  "activities": [
    {
      "id": "render-impulse-collection",
      "category": "ui",
      "description": "Render a collection of impulses as UI components",
      "templatePath": "templates/render-impulse-collection.json"
    },
    {
      "id": "synthesize-ui-from-data",
      "category": "ui",
      "description": "Synthesize a UI composition from raw data impulses",
      "templatePath": "templates/synthesize-ui-from-data.json"
    },
    {
      "id": "handle-user-interaction",
      "category": "ui",
      "description": "Convert user events into activity execution",
      "templatePath": "templates/handle-user-interaction.json"
    },
    {
      "id": "render-live-execution-monitor",
      "category": "tool",
      "description": "Renders a live execution monitor showing task progress, status badges, and task log table",
      "templatePath": "templates/render-live-execution-monitor.json"
    },
    {
      "id": "render-data-exploration",
      "category": "tool",
      "description": "Renders a data exploration interface with summary badges and sortable filterable table",
      "templatePath": "templates/render-data-exploration.json"
    },
    {
      "id": "render-wizard",
      "category": "tool",
      "description": "Renders a multi-step form wizard driven by a goal impulse",
      "templatePath": "templates/render-wizard.json"
    },
    {
      "id": "render-dashboard",
      "category": "tool",
      "description": "Renders a performance dashboard with KPI grid, line chart, and breakdown table",
      "templatePath": "templates/render-dashboard.json"
    },
    {
      "id": "render-conversation",
      "category": "tool",
      "description": "Renders a conversational interface with a message thread and text input box",
      "templatePath": "templates/render-conversation.json"
    }
  ],

  "dependencies": {
    "vessels": [],
    "services": ["metabob-activity-api", "surrealdb"]
  },

  "endpoints": {
    "http": "http://react-renderer.activity-system.svc.cluster.local:3000",
    "health": "/health",
    "resolve": "/resolve",
    "activities": "/activities",
    "websocket": "/ws"
  },

  "development": {
    "enabled": true,
    "cacheStrategy": "backend-first",
    "promotion": {
      "minExecutions": 5,
      "minSuccessRate": 0.8,
      "autoPromote": true
    }
  },

  "discovery": {
    "enabled": true,
    "heartbeatIntervalMs": 60000,
    "retryAttempts": 3,
    "bootstrapDelayMs": 0,
    "metadata": {
      "protocols": ["http", "websocket"],
      "primitiveTypes": [
        "container",
        "text",
        "data-table",
        "data-table-v2",
        "chart",
        "graph",
        "input",
        "button",
        "badge",
        "progress",
        "code",
        "image",
        "custom"
      ],
      "wsPath": "/ws",
      "maxConnections": 1000
    }
  },

  "environment": {
    "PORT": 3000,
    "HOST": "0.0.0.0",
    "WS_PATH": "/ws",
    "WS_MAX_CONNECTIONS": 1000,
    "LOG_LEVEL": "info"
  }
}
