{
  "id": "render-wizard",
  "name": "Render Multi-Step Wizard",
  "category": "tool",
  "description": "Renders a multi-step form wizard. The agent declares the step and field schema via the goal impulse.",
  "inputShapes": ["goal"],
  "outputShapes": ["ui_component"],
  "tasks": [
    {
      "id": "render_wizard_form",
      "description": "Render the wizard form with step indicator and TanStack Form fields",
      "resolver": "ui_component",
      "config": {
        "primitive": {
          "type": "container",
          "layout": "vertical",
          "gap": 16,
          "children": [
            {
              "type": "container",
              "layout": "horizontal",
              "gap": 8,
              "children": "{{goal.steps | map(s => { type: 'badge', text: s.label, variant: s.completed ? 'default' : 'secondary' })}"
            },
            {
              "type": "form",
              "fields": "{{goal.currentStep.fields}}",
              "submitLabel": "{{goal.currentStep.submitLabel || 'Next →'}}",
              "onSubmit": "wizard_step_submit"
            }
          ]
        },
        "position": { "type": "flow" },
        "animation": "slide"
      },
      "inputShapes": ["goal"],
      "outputShapes": ["ui_component"]
    }
  ]
}
