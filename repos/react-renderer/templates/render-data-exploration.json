{
  "id": "render-data-exploration",
  "name": "Render Data Exploration Interface",
  "category": "tool",
  "description": "Renders a data exploration interface with a summary chart and sortable filterable table for tabular data.",
  "inputShapes": ["tabular_data"],
  "outputShapes": ["ui_component"],
  "tasks": [
    {
      "id": "render_exploration",
      "description": "Render the data exploration layout",
      "resolver": "ui_component",
      "config": {
        "primitive": {
          "type": "container",
          "layout": "vertical",
          "gap": 16,
          "children": [
            {
              "type": "container",
              "layout": "horizontal",
              "gap": 8,
              "children": [
                { "type": "badge", "text": "{{tabular_data.rowCount}} rows", "variant": "secondary" },
                { "type": "badge", "text": "{{tabular_data.columnCount}} columns", "variant": "secondary" }
              ]
            },
            {
              "type": "data-table-v2",
              "columns": "{{tabular_data.columnSchema}}",
              "data": "{{tabular_data.rows}}",
              "pageSize": 25,
              "virtual": true
            }
          ]
        },
        "position": { "type": "flow" },
        "animation": "fade"
      },
      "inputShapes": ["tabular_data"],
      "outputShapes": ["ui_component"]
    }
  ]
}
