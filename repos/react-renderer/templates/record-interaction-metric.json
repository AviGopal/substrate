{
  "id": "record-interaction-metric",
  "name": "Record Interaction Metric",
  "category": "tool",
  "description": "Records a UI composition outcome (success, failure, render_failure) and emits a composition_metric impulse for Thompson Sampling feedback.",
  "inputShapes": ["composition_metric", "render_failure"],
  "outputShapes": ["composition_metric"],
  "tasks": [
    {
      "id": "check_render_failure",
      "description": "Check if a render_failure impulse is present",
      "resolver": "impulse_pool_selection",
      "config": {
        "targetShape": "render_failure",
        "action": "check_present"
      }
    },
    {
      "id": "record_failure_metric",
      "description": "Record failure metric when render_failure is present",
      "resolver": "composition_metric",
      "config": {
        "outcome": "failure",
        "failureMode": "render_error",
        "primitiveType": "{{render_failure.content.primitiveType}}",
        "templateId": "{{render_failure.content.templateId}}"
      },
      "condition": "{{check_render_failure.present}}"
    },
    {
      "id": "record_success_metric",
      "description": "Record success metric for standard compositions",
      "resolver": "composition_metric",
      "config": {
        "outcome": "success"
      },
      "condition": "{{!check_render_failure.present}}"
    }
  ]
}
