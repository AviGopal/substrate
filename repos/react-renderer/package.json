{
  "name": "@metabob/react-renderer",
  "version": "0.1.0",
  "description": "UI rendering vessel for impulse visualization",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "concurrently \"bun run src/index.ts\" \"vite\"",
    "dev:server": "bun --hot run src/index.ts",
    "dev:client": "vite",
    "dev:debug": "DEBUG=true bun --hot src/index.ts",
    "build": "bun build src/index.ts --outdir=dist --target=bun",
    "build:client": "vite build",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@metabob/vessel-discovery-client": "file:../../packages/vessel-discovery-client",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-query-persist-client": "^5.0.0",
    "@tanstack/query-sync-storage-persister": "^5.0.0",
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/react-form": "^0.28.0",
    "@tanstack/react-virtual": "^3.0.0",
    "@tanstack/react-table": "^8.0.0",
    "hono": "^4.0.0",
    "nanoid": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.12.0",
    "react-force-graph-2d": "^1.25.0",
    "react-markdown": "^9.0.0",
    "react-syntax-highlighter": "^15.5.0",
    "@radix-ui/react-slot": "^1.0.0",
    "lucide-react": "^0.400.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.2.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@metabob/test-helpers": "file:../../packages/test-helpers",
    "@playwright/test": "^1.59.1",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-syntax-highlighter": "^15.5.0",
    "@vitejs/plugin-react": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "bun-types": "^1.3.11",
    "concurrently": "^8.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite": "^5.0.0"
  }
}
