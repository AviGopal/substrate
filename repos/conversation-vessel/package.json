{
  "name": "conversation-vessel",
  "version": "0.1.0",
  "description": "Lightweight vessel for LLM conversations using ai-sdk",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts serve",
    "dev": "bun --watch run src/index.ts serve",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "keywords": ["vessel", "conversation", "ai-sdk", "llm"],
  "dependencies": {
    "ai": "^4.0.0",
    "@ai-sdk/anthropic": "^1.0.0",
    "@ai-sdk/openai": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.4.0"
  }
}
