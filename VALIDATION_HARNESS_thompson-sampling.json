{
  "specificationName": "thompson-sampling-in-rpc-api-only",
  "harnessFile": "tests/validation-harnesses/thompson-sampling-in-rpc-api-only-harness.ts",
  "description": "Validates architectural boundary: Thompson Sampling ONLY in RPC API, OpenCode delegates via HTTP",
  "testCases": [
    {
      "impulseId": "validation-thompson-sampling-case-1-no-ml-keywords",
      "name": "Zero ML keywords in OpenCode",
      "input": {
        "testType": "grep-ml-keywords",
        "config": {
          "repo": "metabob-opencode",
          "pattern": "thompson|beta|betavariate|sample_beta|sampleBeta",
          "excludePatterns": ["thompsonSampling:", "// Thompson Sampling", "thompson_sample:", "thompson_alpha:", "thompson_beta:"]
        }
      },
      "expectedOutput": {
        "pass": true,
        "matchCount": 0,
        "reason": "OpenCode must delegate Thompson Sampling to RPC API, not implement locally"
      }
    },
    {
      "impulseId": "validation-thompson-sampling-case-2-rpc-api-implementation",
      "name": "RPC API has Thompson Sampling implementation",
      "input": {
        "testType": "grep-ml-keywords",
        "config": {
          "repo": "metabob-rpc-api",
          "file": "server/actions/activity.py",
          "pattern": "def sample_beta|def select_variant_thompson_sampling|random.betavariate"
        }
      },
      "expectedOutput": {
        "pass": true,
        "functionsFound": ["sample_beta", "select_variant_thompson_sampling", "random.betavariate"],
        "reason": "RPC API must have Thompson Sampling implementation"
      }
    },
    {
      "impulseId": "validation-thompson-sampling-case-3-rpc-api-endpoint",
      "name": "RPC API exposes template selection endpoint",
      "input": {
        "testType": "api-endpoint",
        "config": {
          "file": "repos/metabob-rpc-api/server/routes/activity.py",
          "endpoint": "/templates/{activity_id}/select",
          "httpMethod": "POST"
        }
      },
      "expectedOutput": {
        "pass": true,
        "routeExists": true,
        "handlerExists": true,
        "reason": "RPC API must expose template selection endpoint for OpenCode to call"
      }
    },
    {
      "impulseId": "validation-thompson-sampling-case-4-opencode-delegation",
      "name": "OpenCode delegates to RPC API",
      "input": {
        "testType": "grep-ml-keywords",
        "config": {
          "file": "repos/metabob-opencode/packages/opencode/src/session/template-selector.ts",
          "requiredPatterns": ["RpcHttpClient.selectTemplateVariant", "rpcClient.selectTemplateVariant"],
          "forbiddenPatterns": ["Math.random", "betavariate", "sampleBeta", "sample_beta"]
        }
      },
      "expectedOutput": {
        "pass": true,
        "rpcDelegation": true,
        "forbiddenPatternsFound": [],
        "reason": "OpenCode must delegate to RPC API via HTTP, not implement sampling locally"
      }
    },
    {
      "impulseId": "validation-thompson-sampling-case-5-cache-aside-pattern",
      "name": "Phase 3: Cache-aside pattern in create_template",
      "input": {
        "testType": "cache-aside-pattern",
        "config": {
          "file": "repos/metabob-rpc-api/server/actions/activity.py",
          "function": "create_template",
          "expectSurrealDBFirst": true,
          "expectRedisSecond": true
        }
      },
      "expectedOutput": {
        "pass": true,
        "surrealdbFirst": true,
        "metricsOrderCorrect": true,
        "reason": "create_template must write to SurrealDB (primary) before Redis (cache)"
      }
    },
    {
      "impulseId": "validation-thompson-sampling-case-6-surrealdb-metrics",
      "name": "Phase 3: SurrealDB metrics initialization",
      "input": {
        "testType": "surrealdb-schema",
        "config": {
          "file": "repos/metabob-rpc-api/server/actions/activity.py",
          "functionCall": "create_metrics(variant_id)",
          "requiresImport": "create_metrics"
        }
      },
      "expectedOutput": {
        "pass": true,
        "imported": true,
        "called": true,
        "reason": "Metrics must be initialized in SurrealDB (primary storage)"
      }
    }
  ],
  "validationStrategy": {
    "phase2": {
      "description": "Architectural boundary enforcement",
      "validations": [
        "Zero ML keywords in OpenCode (grep search)",
        "Thompson Sampling implementation exists in RPC API",
        "RPC API exposes POST /templates/{id}/select endpoint",
        "OpenCode delegates to RPC API (no local sampling)"
      ]
    },
    "phase3": {
      "description": "Cache-aside pattern enforcement",
      "validations": [
        "create_template writes to SurrealDB before Redis",
        "create_metrics() called to initialize SurrealDB metrics",
        "Redis failures are non-fatal (logged warnings)"
      ]
    }
  },
  "executionInstructions": {
    "cli": "cd tests/validation-harnesses && npx tsx thompson-sampling-in-rpc-api-only-harness.ts",
    "programmatic": "import { runValidation } from './thompson-sampling-in-rpc-api-only-harness'; const result = await runValidation();",
    "exitCode": "0 on all pass, 1 on any failure"
  },
  "harnessImpulseId": "harness-thompson-sampling-in-rpc-api-only"
}
