{
  "testCaseName": "Config File Validation",
  "description": "Verifies that opencode.json exists and contains valid provider configuration",
  "input": "cat /workspace/.config/opencode/opencode.json",
  "expectedOutput": "Config valid",
  "expectedBehavior": {
    "fileExists": true,
    "containsAnthropicConfig": true,
    "apiKeySubstituted": true
  },
  "validationCriteria": [
    "Config file exists at /workspace/.config/opencode/opencode.json",
    "Contains 'anthropic' provider configuration",
    "API key is actual value, not ${ANTHROPIC_API_KEY} template"
  ]
}
