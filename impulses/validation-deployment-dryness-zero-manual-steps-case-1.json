{
  "testCase": "Clean Deployment Without Manual Steps",
  "input": {
    "namespace": "metabob",
    "helmfileEnvironment": "default",
    "rpcApiBaseUrl": "http://localhost:8000",
    "deploymentName": "metabob-rpc-api",
    "configMapName": "universal-config",
    "expectedEnvironment": "development",
    "expectedJwtSecretKey": "dev-secret-key-change-in-production-12345",
    "maxPodStartupSeconds": 120
  },
  "expectedOutput": {
    "helmChartValidation": {
      "pass": true,
      "configMapTemplate": true,
      "environmentVarsInDeployments": true
    },
    "cleanDeployment": {
      "pass": true,
      "exitCode": 0
    },
    "configMapCreation": {
      "pass": true,
      "exists": true
    },
    "podStartup": {
      "pass": true,
      "state": "Running",
      "noCrashLoop": true,
      "maxElapsedSeconds": 120
    },
    "environmentVariable": {
      "pass": true,
      "value": "development"
    },
    "jwtSecretKey": {
      "pass": true,
      "exists": true
    },
    "apiHealthCheck": {
      "pass": true,
      "status": 200
    },
    "zeroManualSteps": {
      "pass": true,
      "manualCommandsNeeded": 0
    }
  },
  "description": "Validates that a clean deployment (helmfile destroy && helmfile apply) succeeds without any manual kubectl commands. The RPC API pod should reach Running state with ENVIRONMENT=development and JWT_SECRET_KEY from the ConfigMap, all configured declaratively via helm values and templates."
}
