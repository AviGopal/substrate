{
  "id": "validation-activity-template-query-filtering-case-4",
  "type": "memo",
  "budget": 1000,
  "testCase": {
    "name": "Unauthenticated Access Restriction",
    "input": {
      "action": "GET /v2/activities/templates",
      "user": "None (unauthenticated)",
      "bearerToken": null
    },
    "expectedOutput": {
      "templates": "array",
      "orgScopedCount": 0,
      "projectScopedCount": 0,
      "onlyGlobalTemplates": true
    },
    "assertion": "Unauthenticated requests only return global templates (no org or project scoped)"
  }
}
