  "content": {
    "testCase": "V3: SurrealDB Problem Persistence",
    "description": "Tests problems persist to SurrealDB with correct schema",
    "input": {
      "query": "SELECT * FROM problems WHERE project_id = '{project_id}' ORDER BY created_at DESC LIMIT 10",
      "database": "SurrealDB",
      "waitTime": "5000ms (for Celery task completion)"
    },
    "expectedOutput": {
      "hasProblems": true,
      "schemaCompliant": true,
      "hasOrgId": true,
      "hasProjectId": true,
      "hasTimestamps": true,
      "temporalOrdering": true
    },
    "schemaFields": [
      "problem_id", "session_id", "project_id", "org_id",
      "file_path", "start_line", "end_line", "category",
      "severity", "description", "status", "created_at", "updated_at"
    ],
    "validationLogic": "Verify problems exist, all schema fields present, org_id and project_id match test data, timestamps are valid ISO 8601, problems are ordered by created_at DESC"
  }
}
