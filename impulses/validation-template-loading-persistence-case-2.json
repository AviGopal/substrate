{
  "impulseId": "validation-template-loading-persistence-case-2",
  "type": "memo",
  "description": "Test case 2: TTL expiration and automatic refresh from SurrealDB",
  "testCase": {
    "name": "TTL Expiration Recovery",
    "input": {
      "templateName": "Test Template TTL Expiration",
      "templateCategory": "bugfix",
      "rpcApiUrl": "http://localhost:8000",
      "kubectlContext": null
    },
    "expectedOutput": {
      "templateCreated": true,
      "existsInSurrealDB": true,
      "existsInRedisBeforeClear": true,
      "redisCleared": true,
      "loadedAfterClear": true,
      "existsInRedisAfterClear": true,
      "cacheRepopulated": true
    },
    "validationSteps": [
      "Create test template",
      "Verify template cached with TTL (TTL activity:template:{id} should be ~3600s)",
      "Manually expire cache key: DEL activity:template:{id}",
      "Load template (should trigger SurrealDB query)",
      "Verify cache repopulated with new TTL",
      "Verify logs show cache miss"
    ],
    "successCriteria": [
      "Template created and cached",
      "Initial TTL close to 3600s",
      "Cache key successfully deleted",
      "Template loads after expiration",
      "New TTL set after repopulation (~3600s)",
      "No errors during the process"
    ]
  }
}
