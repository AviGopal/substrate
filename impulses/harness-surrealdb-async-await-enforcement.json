{
  "id": "harness-surrealdb-async-await-enforcement",
  "type": "file",
  "category": "validation",
  "specification": "surrealdb-async-await-enforcement",
  "pointer": {
    "type": "file",
    "path": "tests/validation-harnesses/surrealdb-async-await-enforcement-harness.sh",
    "source": "local"
  },
  "metadata": {
    "description": "External validation harness for surrealdb-async-await-enforcement specification",
    "purpose": "Validates that async/await patterns are correctly enforced in metabob-rpc-api",
    "testStrategy": [
      "Create template via POST /v2/activities/templates",
      "Verify template returned in GET response (from Redis cache)",
      "Check pod logs for zero coroutine warnings",
      "Query SurrealDB directly via kubectl exec to confirm record persisted",
      "Flush Redis cache",
      "Query API again - template should still exist (loaded from SurrealDB)",
      "Verify Redis and SurrealDB are synchronized"
    ],
    "usage": {
      "command": "./tests/validation-harnesses/surrealdb-async-await-enforcement-harness.sh",
      "environment": {
        "RPC_API_URL": "http://localhost:8081",
        "NAMESPACE": "default",
        "REDIS_POD": "redis-0",
        "SURREALDB_POD": "surrealdb-0"
      },
      "exitCodes": {
        "0": "All tests passed",
        "1": "Some tests failed"
      }
    },
    "testCases": [
      {
        "id": "validation-surrealdb-async-await-enforcement-case-1",
        "name": "Template Creation and Persistence"
      },
      {
        "id": "validation-surrealdb-async-await-enforcement-case-2",
        "name": "Cache-Aside Pattern After Cache Flush"
      },
      {
        "id": "validation-surrealdb-async-await-enforcement-case-3",
        "name": "Execution Metrics Persistence and Learning Loop"
      }
    ],
    "integrationTests": [
      {
        "test": "API Health Check",
        "validates": "RPC API is accessible"
      },
      {
        "test": "Create Template",
        "validates": "POST endpoint works and returns variant_id"
      },
      {
        "test": "GET Template (Cache Hit)",
        "validates": "Template retrievable from Redis cache"
      },
      {
        "test": "Pod Log Check",
        "validates": "No 'coroutine was never awaited' warnings"
      },
      {
        "test": "SurrealDB Direct Query",
        "validates": "Template exists in primary storage"
      },
      {
        "test": "Flush Redis Cache",
        "validates": "Cache can be cleared"
      },
      {
        "test": "GET Template (Cache Miss)",
        "validates": "Template retrievable from SurrealDB after cache flush"
      },
      {
        "test": "Storage Synchronization",
        "validates": "Redis cache repopulated from SurrealDB"
      }
    ],
    "dependencies": [
      "kubectl (for pod log and direct DB access)",
      "curl (for API calls)",
      "jq (for JSON parsing)"
    ],
    "keywords": [
      "async-await",
      "surrealdb",
      "redis",
      "cache-aside",
      "persistence",
      "coroutine",
      "validation"
    ]
  },
  "budget": 2000,
  "createdAt": "2026-03-03T09:53:00Z"
}
