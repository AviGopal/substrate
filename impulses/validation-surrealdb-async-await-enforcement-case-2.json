{
  "id": "validation-surrealdb-async-await-enforcement-case-2",
  "type": "memo",
  "category": "validation",
  "specification": "surrealdb-async-await-enforcement",
  "testCase": {
    "name": "Cache-Aside Pattern After Cache Flush",
    "description": "Verify that templates are retrievable after Redis cache is flushed, proving they persist in SurrealDB",
    "input": {
      "setup": [
        "Create template via POST /v2/activities/templates",
        "Verify template exists via GET (from Redis cache)",
        "Flush Redis cache using FLUSHALL"
      ],
      "method": "GET",
      "endpoint": "/v2/activities/templates/<variant_id>",
      "context": "Redis cache has been flushed, forcing SurrealDB fallback"
    },
    "expectedOutput": {
      "apiResponse": {
        "variant_id": "<matches_created_template>",
        "activity_id": "<matches_created_template>",
        "description": "Template loaded from SurrealDB after cache miss"
      },
      "behavior": {
        "redisCacheHit": false,
        "surrealdbFallback": true,
        "cacheRepopulation": true
      },
      "logs": {
        "expectedMessages": [
          "Template cache miss",
          "loading from SurrealDB",
          "Template cached from SurrealDB"
        ]
      },
      "subsequentGet": {
        "redisCacheHit": true,
        "description": "Cache repopulated after SurrealDB load"
      }
    },
    "validationChecks": [
      "GET returns 200 status code after cache flush",
      "Response contains correct template data",
      "Logs show cache miss and SurrealDB fallback",
      "Subsequent GET hits Redis cache (repopulated)",
      "No errors in logs"
    ]
  },
  "budget": 1000,
  "createdAt": "2026-03-03T09:53:00Z"
}
