{
  "testCase": "HTTP Server Has ACP Endpoint",
  "impulseId": "validation-acp-network-transport-implementation-case-2",
  "type": "memo",
  "input": {
    "serverCommand": "opencode acp --port 18081",
    "endpoint": "POST /acp/stream",
    "headers": {
      "Content-Type": "application/x-ndjson"
    }
  },
  "expectedOutput": {
    "endpointExists": true,
    "acceptsHTTPPost": true,
    "responseCode": "not 404"
  },
  "validationCriteria": {
    "mustHave": [
      "POST /acp/stream route exists",
      "Server responds to HTTP requests",
      "Endpoint accessible on configured port"
    ],
    "mustNotHave": [
      "404 Not Found error",
      "Missing route error"
    ]
  }
}
