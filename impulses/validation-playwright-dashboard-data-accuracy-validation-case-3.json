{
  "id": "validation-playwright-dashboard-data-accuracy-validation-case-3",
  "type": "memo",
  "pointer": {
    "type": "memo",
    "content": {
      "testCase": "High Token Usage Activity Validation",
      "description": "Execute activity with multiple tasks to generate high token usage, verify accurate token count display",
      "input": {
        "templateName": "add-rest-endpoint",
        "templateVariables": {
          "method": "GET",
          "path": "/api/analytics/reports",
          "description": "Complex analytics endpoint with multiple data sources and transformations"
        },
        "devbobUrl": "http://devbob.metabob.local",
        "dashboardUrl": "http://app.metabob.local",
        "surrealdbUrl": "http://surrealdb.metabob.local:8000"
      },
      "expectedOutput": {
        "activityCompleted": true,
        "dataPersistedToSurrealDB": true,
        "dashboardDisplaysData": true,
        "checks": {
          "executionIdMatch": true,
          "templateNameMatch": true,
          "statusMatch": true,
          "costVarianceWithin1Percent": true,
          "durationVarianceWithin1Percent": true,
          "tokensAccurate": true,
          "taskCountMatch": true,
          "noConsoleErrors": true
        },
        "expectedFields": {
          "template_name": "add-rest-endpoint",
          "status": "completed",
          "tokens_used_min": 10000,
          "tokens_used_max": 200000,
          "task_count_min": 3,
          "task_count_max": 10,
          "cost_usd_min": 0.01,
          "cost_usd_max": 2.0
        }
      }
    },
    "source": "create-validation-harness activity"
  },
  "budget": 1000
}
