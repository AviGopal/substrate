{
  "id": "validation-complete-architecture-separation-cases-all",
  "type": "memo",
  "pointer": {
    "type": "memo",
    "content": {
      "specification": "complete-architecture-separation",
      "testCases": [
        {
          "impulseId": "validation-complete-architecture-separation-case-1",
          "name": "opencode has ZERO ML implementations",
          "input": {
            "searchPatterns": ["class.*Thompson", "function.*performThompsonSampling", "sample_beta\\(", "beta_distribution\\(", "def.*thompson"],
            "repo": "metabob-opencode"
          },
          "expectedOutput": {
            "implementationCount": 0
          }
        },
        {
          "impulseId": "validation-complete-architecture-separation-case-2",
          "name": "CLI has ZERO training logic",
          "input": {
            "searchPatterns": ["def.*train", "class.*Trainer", "beta_update", "alpha.*=.*success", "update_beta_distribution"],
            "repo": "metabob-cli"
          },
          "expectedOutput": {
            "trainingLogicCount": 0
          }
        },
        {
          "impulseId": "validation-complete-architecture-separation-case-3",
          "name": "RPC API has ALL learning endpoints",
          "input": {
            "requiredEndpoints": [
              {"name": "Thompson Sampling", "pattern": "def select_variant_thompson_sampling"},
              {"name": "Beta Sampling", "pattern": "sample_beta"},
              {"name": "Metrics Update", "pattern": "update_metrics_after_execution"}
            ],
            "repo": "metabob-rpc-api"
          },
          "expectedOutput": {
            "Thompson Sampling": true,
            "Beta Sampling": true,
            "Metrics Update": true
          }
        },
        {
          "impulseId": "validation-complete-architecture-separation-case-4",
          "name": "Data flow follows architecture boundaries",
          "input": {
            "checks": [
              {"name": "opencode uses RPC client", "pattern": "rpcHttpClient|POST.*activities.*select", "repo": "metabob-opencode"},
              {"name": "CLI forwards to RPC", "pattern": "call_api.*POST.*activities|await.*call_api", "repo": "metabob-cli"},
              {"name": "No direct DB access", "pattern": "surrealdb|surreal\\.", "repo": "metabob-opencode"}
            ]
          },
          "expectedOutput": {
            "opencodeUsesRpcClient": true,
            "cliForwardsToRpc": true,
            "opencodeDirectDbAccess": 0
          }
        },
        {
          "impulseId": "validation-complete-architecture-separation-case-5",
          "name": "thompson-sampler.ts deleted from opencode",
          "input": {
            "filePath": "repos/metabob-opencode/packages/opencode/src/ml/thompson-sampler.ts"
          },
          "expectedOutput": {
            "thompsonSamplerExists": false,
            "mlDirectoryExists": false
          }
        },
        {
          "impulseId": "validation-complete-architecture-separation-case-6",
          "name": "Template storage uses SurrealDB primary + Redis cache",
          "input": {
            "checks": [
              {"name": "SurrealDB storage", "pattern": "surrealdb.*template|activity_template.*surreal"},
              {"name": "Redis caching", "pattern": "redis.*cache|cache.*template|ttl"},
              {"name": "Cache miss logic", "pattern": "if.*not.*redis|cache.*miss|load.*from.*surreal"}
            ],
            "repo": "metabob-rpc-api"
          },
          "expectedOutput": {
            "surrealdbForTemplates": true,
            "redisForCaching": true,
            "cacheMissHandling": true
          }
        },
        {
          "impulseId": "validation-complete-architecture-separation-case-7",
          "name": "CLI MCP tools are pure proxies to RPC API",
          "input": {
            "checks": [
              {"name": "MCP tools delegate", "pattern": "await call_api|call_rpc_api"},
              {"name": "No local computation", "pattern": "calculate.*metric|compute.*score|local.*thompson"}
            ],
            "repo": "metabob-cli"
          },
          "expectedOutput": {
            "mcpToolsDelegateToRpc": true,
            "localComputationFound": 0
          }
        }
      ]
    },
    "source": "validation-harness"
  },
  "budget": 2000,
  "metadata": {
    "category": "validation-cases",
    "specification": "complete-architecture-separation",
    "totalCases": 7
  }
}
