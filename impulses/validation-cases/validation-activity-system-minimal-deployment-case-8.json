{
  "id": "validation-activity-system-minimal-deployment-case-8",
  "type": "memo",
  "testName": "Session Creation API",
  "description": "Verify POST /v2/session creates session and returns Bearer token",
  "input": {
    "service": "metabob-activity-api",
    "port": 8080,
    "endpoint": "/v2/session",
    "method": "POST",
    "headers": {
      "X-API-Key": "test-api-key-validation",
      "Content-Type": "application/json"
    },
    "body": {
      "org_id": "org_test",
      "project_id": "proj_test"
    }
  },
  "expectedOutput": {
    "statusCode": 200,
    "body": {
      "session": "{{base64_token}}"
    },
    "tokenFormat": "Base64",
    "tokenDecodes": true,
    "sessionIdPattern": "^sess_[a-zA-Z0-9]+$"
  }
}
