{
  "id": "validation-activity-system-minimal-deployment-case-4",
  "type": "memo",
  "testName": "Pod Running Status - All 5 Pods",
  "description": "Verify all 5 pods are in Running state: redis, surrealdb, 2x activity-api, minibob",
  "input": {
    "namespace": "activity-system",
    "expectedPods": 5,
    "podLabels": {
      "redis": "app.kubernetes.io/name=redis",
      "surrealdb": "app=surrealdb",
      "activity-api": "app.kubernetes.io/name=metabob-activity-api",
      "minibob": "app.kubernetes.io/name=minibob"
    }
  },
  "expectedOutput": {
    "totalPods": 5,
    "runningPods": 5,
    "allRunning": true,
    "pods": {
      "redis": { "status": "Running", "ready": "1/1" },
      "surrealdb": { "status": "Running", "ready": "1/1" },
      "activity-api-0": { "status": "Running", "ready": "1/1" },
      "activity-api-1": { "status": "Running", "ready": "1/1" },
      "minibob": { "status": "Running", "ready": "1/1" }
    }
  }
}
