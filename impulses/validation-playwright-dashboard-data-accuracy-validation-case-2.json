{
  "id": "validation-playwright-dashboard-data-accuracy-validation-case-2",
  "type": "memo",
  "pointer": {
    "type": "memo",
    "content": {
      "testCase": "Failed Activity Validation",
      "description": "Execute activity that intentionally fails, verify failure state propagates correctly through data flow",
      "input": {
        "templateName": "add-rest-endpoint",
        "templateVariables": {
          "method": "INVALID_METHOD",
          "path": "/api/invalid",
          "description": "This should fail"
        },
        "devbobUrl": "http://devbob.metabob.local",
        "dashboardUrl": "http://app.metabob.local",
        "surrealdbUrl": "http://surrealdb.metabob.local:8000"
      },
      "expectedOutput": {
        "activityCompleted": false,
        "dataPersistedToSurrealDB": true,
        "dashboardDisplaysData": true,
        "checks": {
          "executionIdMatch": true,
          "templateNameMatch": true,
          "statusMatch": true,
          "errorMessagePresent": true,
          "noConsoleErrors": true
        },
        "expectedFields": {
          "template_name": "add-rest-endpoint",
          "status": "failed",
          "error_message_present": true
        }
      }
    },
    "source": "create-validation-harness activity"
  },
  "budget": 1000
}
