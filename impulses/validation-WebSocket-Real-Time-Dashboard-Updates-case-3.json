{
  "id": "validation-WebSocket-Real-Time-Dashboard-Updates-case-3",
  "type": "memo",
  "testCase": "metrics-updates",
  "description": "Verify metrics updates contain all required fields with correct types",
  "input": {
    "testCase": "metrics-updates",
    "apiUrl": "ws://localhost:8080/ws",
    "timeout": 10000
  },
  "expectedOutput": {
    "metricsReceived": true,
    "metricsValid": true,
    "requiredFields": [
      "success_rate",
      "avg_duration_ms",
      "avg_cost_usd",
      "thompson_alpha",
      "thompson_beta"
    ]
  },
  "validationCriteria": [
    "template_updated event received",
    "Metrics object present in event data",
    "All 5 required fields present: success_rate, avg_duration_ms, avg_cost_usd, thompson_alpha, thompson_beta",
    "All fields are numbers",
    "success_rate between 0 and 1 (or 0 and 100 depending on format)",
    "thompson_alpha >= 1 (Bayesian prior)",
    "thompson_beta >= 1 (Bayesian prior)"
  ],
  "metricsSchema": {
    "success_rate": "number (0-1 or 0-100)",
    "avg_duration_ms": "number (>= 0)",
    "avg_cost_usd": "number (>= 0)",
    "thompson_alpha": "number (>= 1)",
    "thompson_beta": "number (>= 1)"
  },
  "passingConditions": {
    "metricsReceived": true,
    "allFieldsPresent": true,
    "allFieldsValidTypes": true,
    "noSchemaViolations": true
  }
}
