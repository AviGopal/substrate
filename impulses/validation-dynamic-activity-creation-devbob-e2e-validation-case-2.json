{
  "id": "validation-dynamic-activity-creation-devbob-e2e-validation-case-2",
  "type": "memo",
  "pointer": {
    "type": "testCase",
    "specification": "dynamic-activity-creation-devbob-e2e-validation",
    "testName": "Trailblazing Meta-Templates Execution"
  },
  "content": {
    "input": {
      "metaTemplates": ["create-activity", "evolve-activity", "debug-activity"],
      "trailblazingConfig": {
        "enabled": true,
        "maxCostPerTask": 1.0,
        "maxTotalCost": 5.0,
        "maxRecoveryAttempts": 3
      }
    },
    "expectedOutput": {
      "createActivityExecuted": true,
      "evolveActivityExecuted": true,
      "debugActivityExecuted": true,
      "trailblazingEnabled": true,
      "recoveryAttemptsVisible": true
    },
    "validationCommand": "kubectl logs -f deployment/devbob-opencode -n metabob --tail=200 | grep -E 'create-activity|evolve-activity|debug-activity|trailblazing|recovery'",
    "expectedResult": "Logs show meta-template execution with trailblazing recovery attempts"
  },
  "budget": 500,
  "loaded": true
}
