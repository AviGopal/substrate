  "pointer": {
    "type": "file",
    "path": "tests/validation-harnesses/metabob-cli-to-dashboard-e2e-data-flow-harness.ts",
    "description": "Validation harness that tests complete E2E data flow from metabob-cli to dashboard without requiring LLM. Executes 6 test cases (V1-V6) and returns PASS/FAIL with detailed results."
  },
  "content": {
    "file": "tests/validation-harnesses/metabob-cli-to-dashboard-e2e-data-flow-harness.ts",
    "testCases": [
      {
        "id": "V1",
        "name": "CLI Project Registration",
        "impulseId": "validation-metabob-cli-to-dashboard-e2e-data-flow-case-1",
        "function": "testProjectRegistration",
        "endpoint": "POST /auth/orgs/{org_id}/projects"
      },
      {
        "id": "V2",
        "name": "Session-Project Linking",
        "impulseId": "validation-metabob-cli-to-dashboard-e2e-data-flow-case-2",
        "function": "testSessionProjectLinking",
        "endpoint": "POST /v2/submit"
      },
      {
        "id": "V3",
        "name": "SurrealDB Problem Persistence",
        "impulseId": "validation-metabob-cli-to-dashboard-e2e-data-flow-case-3",
        "function": "testSurrealDBPersistence",
        "database": "SurrealDB"
      },
      {
        "id": "V4",
        "name": "Dashboard Problem Query",
        "impulseId": "validation-metabob-cli-to-dashboard-e2e-data-flow-case-4",
        "function": "testDashboardProblemQuery",
        "endpoint": "GET /auth/orgs/{org_id}/projects/{project_id}/problems"
      },
      {
        "id": "V5",
        "name": "Temporal Tracking",
        "impulseId": "validation-metabob-cli-to-dashboard-e2e-data-flow-case-5",
        "function": "testTemporalTracking",
        "validation": "Temporal ordering and timestamp validity"
      },
      {
        "id": "V6",
        "name": "Stats Updates",
        "impulseId": "validation-metabob-cli-to-dashboard-e2e-data-flow-case-6",
        "function": "testStatsUpdates",
        "endpoint": "GET /auth/orgs/{org_id}/projects"
      }
    ],
    "usage": {
      "standalone": "TEST_ORG_ID=<org_id> JWT_TOKEN=<token> RPC_API_URL=http://localhost:8000 node tests/validation-harnesses/metabob-cli-to-dashboard-e2e-data-flow-harness.ts",
      "programmatic": "import { runValidation } from './tests/validation-harnesses/metabob-cli-to-dashboard-e2e-data-flow-harness'; const result = await runValidation(config);"
    },
    "dependencies": [
      "axios",
      "form-data"
    ],
    "configuration": {
      "required": ["rpcApiUrl", "testOrgId", "jwtToken"],
      "optional": ["surrealDbUrl", "surrealDbNamespace", "surrealDbDatabase", "testUserId"]
    }
  }
