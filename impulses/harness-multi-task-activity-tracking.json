{
  "id": "harness-multi-task-activity-tracking",
  "type": "file",
  "specificationName": "Multi-Task Activity Tracking",
  "description": "Validation harness that executes a 7-task activity and verifies comprehensive task-level tracking, lifecycle logs, and metric aggregation",
  "timestamp": "2026-03-11T04:40:00Z",
  "pointer": {
    "type": "file",
    "path": "tests/validation-harnesses/multi-task-activity-tracking-harness.ts",
    "source": "validation-system"
  },
  "capabilities": [
    "Execute multi-task activities",
    "Capture and analyze lifecycle logs",
    "Verify task start/complete log patterns",
    "Extract and validate activity records from storage",
    "Check per-task metrics (duration, cost, sessions)",
    "Return deterministic PASS/FAIL without LLM"
  ],
  "validationStrategy": {
    "approach": "Execute 7-task activity and verify logs + storage",
    "steps": [
      "1. Execute trace-data-flow-single-feature activity (7 tasks)",
      "2. Capture all lifecycle logs to temporary file",
      "3. Count 'Task starting:' log occurrences (expect 7)",
      "4. Count 'Task completed:' log occurrences (expect 7)",
      "5. Verify task logs include proper metadata (taskId, description, duration, cost)",
      "6. Extract activity ID from logs",
      "7. Load activity record from storage (~/.local/share/opencode/storage/activity/)",
      "8. Verify executionEvidence.sessionsSpawned has 7 entries",
      "9. Verify each session has: sessionID, taskId, agentType, startTime, endTime, messageCount, toolCallCount, duration, cost",
      "10. Return PASS if all checks succeed, FAIL otherwise"
    ],
    "deterministic": true,
    "requiresLLM": false,
    "testCases": [
      "validation-multi-task-activity-tracking-case-1"
    ]
  },
  "interface": {
    "function": "runValidation",
    "input": {
      "templateId": "string (activity template ID)",
      "variables": "Record<string, any> (template variables)",
      "reason": "string (execution reason)",
      "expectedTaskCount": "number (expected number of tasks)",
      "timeout": "number (optional, timeout in seconds)",
      "verifyStorage": "boolean (optional, whether to verify activity storage)",
      "activityStoragePath": "string (optional, custom storage path)"
    },
    "output": {
      "pass": "boolean (overall pass/fail)",
      "timestamp": "number (validation timestamp)",
      "execution": {
        "command": "string (command executed)",
        "duration": "number (execution duration ms)",
        "exitCode": "number (process exit code)",
        "logFile": "string (log file path)",
        "logLines": "number (total log lines)"
      },
      "logs": {
        "taskStartCount": "number (task start logs found)",
        "taskCompleteCount": "number (task complete logs found)",
        "expectedTasks": "number (expected task count)",
        "patterns": "Record<string, PatternResult> (pattern match results)"
      },
      "activityRecord": {
        "activityId": "string | null (activity ID)",
        "recordFound": "boolean (record found in storage)",
        "sessionsSpawned": "number (sessions spawned count)",
        "expectedSessions": "number (expected sessions)",
        "hasTaskMetrics": "boolean (all sessions have duration/cost)",
        "sessionsWithDuration": "number (sessions with duration)",
        "sessionsWithCost": "number (sessions with cost)",
        "sessionsWithTaskId": "number (sessions with taskId)",
        "pass": "boolean (record validation pass)"
      },
      "summary": "string (human-readable summary)",
      "errors": "string[] (error messages)",
      "warnings": "string[] (warning messages)"
    }
  },
  "usage": {
