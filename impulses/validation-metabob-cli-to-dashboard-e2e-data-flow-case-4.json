  "content": {
    "testCase": "V4: Dashboard Problem Query",
    "description": "Tests GET /auth/orgs/{org_id}/projects/{project_id}/problems endpoint",
    "input": {
      "endpoint": "GET /auth/orgs/{org_id}/projects/{project_id}/problems?limit=100",
      "authentication": "JWT Bearer token"
    },
    "expectedOutput": {
      "hasProblems": true,
      "hasTotal": true,
      "hasGroupedByComponent": true,
      "hasSeverityDistribution": true,
      "hasPagination": true
    },
    "responseSchema": {
      "problems": "Array<ProblemData>",
      "total": "number",
      "hasMore": "boolean",
      "grouped_by_component": "Record<string, number>",
      "severity_distribution": "Record<string, number>"
    },
    "validationLogic": "Verify response contains problems array, total count, grouped_by_component object (problems by file_path), severity_distribution object (problems by severity), and hasMore pagination indicator"
  }
