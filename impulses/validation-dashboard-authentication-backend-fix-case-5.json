{
  "testCase": "Database Record Verification",
  "testNumber": 5,
  "description": "Query SurrealDB to verify user, organization, and user_organizations junction records exist after registration.",
  "input": {
    "surrealPodQuery": "kubectl exec -n metabob {SURREAL_POD} -- surreal sql",
    "queries": [
      {
        "query": "SELECT * FROM users WHERE email = '{TEST_EMAIL}';",
        "description": "Verify user record exists"
      },
      {
        "query": "SELECT * FROM organizations WHERE name = '{TEST_ORG}';",
        "description": "Verify organization record exists"
      },
      {
        "query": "SELECT * FROM user_organizations WHERE user_id = '{USER_ID}';",
        "description": "Verify user_organizations junction exists"
      }
    ],
    "namespace": "metabob",
    "database": "default"
  },
  "expectedOutput": {
    "userRecord": {
      "exists": true,
      "fields": {
        "user_id": "UUID format",
        "email": "matches registration email",
        "password_hash": "bcrypt hash (starts with $2b$)",
        "name": "matches registration name",
        "org_id": "UUID format",
        "role": "owner",
        "is_active": true,
        "created_at": "timestamp"
      }
    },
    "organizationRecord": {
      "exists": true,
      "fields": {
        "org_id": "UUID format",
        "name": "matches registration org_name",
        "created_at": "timestamp"
      }
    },
    "junctionRecord": {
      "exists": true,
      "fields": {
        "user_id": "matches user record",
        "org_id": "matches organization record",
        "role": "owner"
      }
    }
  },
  "passCriteria": [
    "User record found in SurrealDB with correct email",
    "User record contains password_hash field (bcrypt format)",
    "Organization record found with correct name",
    "user_organizations junction record links user to org",
    "All records contain proper UUIDs and timestamps"
  ],
  "failureIndicators": [
    "User record not found",
    "Password_hash missing or not bcrypt format",
    "Organization record not found",
    "Junction record missing",
    "Data integrity issues (missing UUIDs, timestamps)"
  ]
}
