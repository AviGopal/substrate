{
  "id": "validation-analytics-endpoint-fix-and-dashboard-local-mode-case-1",
  "type": "memo",
  "testCase": "Analytics endpoint returns valid JSON with template statistics",
  "input": {
    "endpoint": "http://localhost:8080/analytics/templates",
    "method": "GET",
    "headers": {}
  },
  "expectedOutput": {
    "statusCode": 200,
    "contentType": "application/json",
    "bodyStructure": {
      "templates": "array",
      "total_templates": "number",
      "total_executions": "number"
    },
    "templateItemStructure": {
      "template_id": "string",
      "execution_count": "number",
      "success_rate": "number",
      "avg_cost_usd": "number",
      "avg_duration_ms": "number",
      "avg_tokens": {
        "input": "number",
        "output": "number",
        "cache": "number"
      },
      "last_execution": "string|null"
    },
    "validations": [
      "Response status is 200 (not 500)",
      "Response body is valid JSON",
      "templates is an array",
      "Each template item has required fields",
      "No AttributeError in response",
      "execution_count is a number (not string)",
      "success_rate is between 0 and 1"
    ]
  }
}
