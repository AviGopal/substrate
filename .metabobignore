# Metabob File Watcher Ignore List
# Exclude large test fixture directories and common noise

# Test fixtures (10,000+ files)
repos/metabob-cli/tests/perf-repos/
repos/metabob-cli/tests/

# All test directories
**/tests/
**/__tests__/
**/test/

# Node modules and build artifacts
**/node_modules/
**/dist/
**/build/
**/.next/
**/.nuxt/

# Python artifacts
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/venv/
**/.venv/
**/.pytest_cache/

# Git and version control
**/.git/
**/.svn/
**/.hg/

# IDE and editor files
**/.vscode/
**/.idea/
**/.cursor/
**/*.swp
**/*.swo
**/*~

# Build and dependency files
**/target/
**/vendor/
**/.gradle/
**/.cargo/

# Large data files
**/*.db
**/*.sqlite
**/*.sqlite3

# Archives
**/*.zip
**/*.tar
**/*.gz
**/*.tgz

# Docker volumes
**/data/
**/volumes/

# Logs
**/*.log
**/logs/
