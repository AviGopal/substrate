 export async function applyOutcomeToPosteriors(
   trace: TraceForPosterior,
   db: DBQueryable,
   orgId: string,
 ): Promise<UpdateSummary> {
   const warnings: string[] = [];

+  // 2026-06-04 tier-restricted-bandit: skip canonical posterior writes when
+  // every task in this trace ran on a deterministic-tier resolver. Such
+  // cells have degenerate transition kernels — the Beta posterior on them
+  // captures propagated upstream uncertainty, not cell-local signal.
+  // Chain-credit propagation still fires below because ancestors may be
+  // stochastic.
+  const tasks = trace.tasks ?? [];
+  const allDeterministic =
+    tasks.length > 0 &&
+    tasks.every((t) => t?.resolver_tier === 'deterministic');
+  if (allDeterministic) {
+    const skipSummary: UpdateSummary = {
+      activity_id: normalizeActivityId(
+        trace.activity_variant_id ?? trace.variant_id ?? trace.activity_id,
+      ),
+      alpha_delta: 0,
+      beta_delta: 0,
+      failure_mode_type: trace.failure_mode?.type ?? null,
+      impulse_relevance_writes: 0,
+      warnings,
+      skipped_reason: 'all_deterministic',
+    };
+    emitPosteriorUpdateMetric(skipSummary);
+    // Still propagate chain credit — ancestors may be stochastic.
+    if (trace.composition_chain && trace.composition_chain.length > 0) {
+      propagateCreditAlongChain(
+        {
+          activity_id: skipSummary.activity_id,
+          composition_chain: trace.composition_chain,
+          success: trace.success,
+          failure_mode: trace.failure_mode,
+        },
+        db,
+        orgId,
+      ).catch((err) => {
+        logger.warn('posterior-update: propagateCreditAlongChain failed (tier-skip path)', {
+          activity_id: skipSummary.activity_id,
+          error: err instanceof Error ? err.message : String(err),
+        });
+      });
+    }
+    return skipSummary;
+  }
+
   const rawActivityId = trace.activity_variant_id ?? trace.variant_id ?? trace.activity_id;
