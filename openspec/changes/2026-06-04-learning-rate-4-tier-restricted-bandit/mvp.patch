@@ -0,0 +1,75 @@
+import { describe, expect, test } from 'bun:test';
+import { applyOutcomeToPosteriors, type DBQueryable, type TraceForPosterior } from './posterior-update';
+
+function makeMockDb(): { db: DBQueryable; queries: Array<{ sql: string; params?: any }> } {
+  const queries: Array<{ sql: string; params?: any }> = [];
+  const db: DBQueryable = {
+    async query(sql, params) {
+      queries.push({ sql, params });
+      return [] as any;
+    },
+  };
+  return { db, queries };
+}
+
+const baseTrace = (overrides: Partial<TraceForPosterior>): TraceForPosterior => ({
+  activity_id: 'tmpl-1',
+  success: true,
+  ...overrides,
+});
+
+describe('applyOutcomeToPosteriors — tier-restricted bandit', () => {
+  test('all-deterministic trace skips variant_performance_metrics UPDATE', async () => {
+    const { db, queries } = makeMockDb();
+    const trace = baseTrace({
+      tasks: [
+        { resolver: 'bash', resolver_tier: 'deterministic' },
+        { resolver: 'file_read', resolver_tier: 'deterministic' },
+      ],
+    });
+    const summary = await applyOutcomeToPosteriors(trace, db, 'org-x');
+    expect(summary.skipped_reason).toBe('all_deterministic');
+    expect(summary.alpha_delta).toBe(0);
+    expect(summary.beta_delta).toBe(0);
+    // No DB UPDATE issued on variant_performance_metrics
+    const vpm = queries.filter((q) => q.sql.includes('variant_performance_metrics'));
+    expect(vpm.length).toBe(0);
+  });
+
+  test('mixed-tier trace writes posterior as before', async () => {
+    const { db, queries } = makeMockDb();
+    const trace = baseTrace({
+      success: false,
+      failure_mode: { type: 'verifier_negative' } as any,
+      tasks: [
+        { resolver: 'bash', resolver_tier: 'deterministic' },
+        { resolver: 'llm-prompt', resolver_tier: 'llm' },
+      ],
+    });
+    const summary = await applyOutcomeToPosteriors(trace, db, 'org-x');
+    expect(summary.skipped_reason).toBeUndefined();
+    expect(summary.beta_delta).toBe(1);
+    const vpm = queries.filter((q) => q.sql.includes('variant_performance_metrics'));
+    expect(vpm.length).toBeGreaterThan(0);
+  });
+
+  test('all-stochastic (llm) trace writes posterior', async () => {
+    const { db, queries } = makeMockDb();
+    const trace = baseTrace({
+      tasks: [{ resolver: 'llm-prompt', resolver_tier: 'llm' }],
+    });
+    const summary = await applyOutcomeToPosteriors(trace, db, 'org-x');
+    expect(summary.skipped_reason).toBeUndefined();
+    expect(summary.alpha_delta).toBe(1);
+    const vpm = queries.filter((q) => q.sql.includes('variant_performance_metrics'));
+    expect(vpm.length).toBeGreaterThan(0);
+  });
+
+  test('trace without resolver_tier on tasks falls through to stochastic path', async () => {
+    const { db, queries } = makeMockDb();
+    const trace = baseTrace({ tasks: [{ resolver: 'bash' }] });
+    const summary = await applyOutcomeToPosteriors(trace, db, 'org-x');
+    expect(summary.skipped_reason).toBeUndefined();
+    const vpm = queries.filter((q) => q.sql.includes('variant_performance_metrics'));
+    expect(vpm.length).toBeGreaterThan(0);
+  });
+});
