{
  "specificationName": "Database Schema Initialization - Automatic Schema Creation on Fresh Deployment",
  "harnessFile": "tests/validation-harnesses/schema-init-harness.sh",
  "testCases": [
    {
      "impulseId": "validation-schema-init-case-1",
      "name": "Verify initSchema enabled in values",
      "input": "charts/surrealdb/values/default.surrealdb.values.yaml",
      "expectedOutput": "initSchema.enabled: true",
      "testFunction": "test_init_schema_enabled"
    },
    {
      "impulseId": "validation-schema-init-case-2",
      "name": "Verify Deployment has namespace/database args",
      "input": "charts/surrealdb/charts/templates/deployment.yaml",
      "expectedOutput": "Args include --ns and --db flags",
      "testFunction": "test_deployment_args"
    },
    {
      "impulseId": "validation-schema-init-case-3",
      "name": "Verify StatefulSet has namespace/database args",
      "input": "charts/surrealdb/charts/templates/statefulset.yaml",
      "expectedOutput": "Args include --ns and --db flags",
      "testFunction": "test_statefulset_args"
    },
    {
      "impulseId": "validation-schema-init-case-4",
      "name": "Clean deployment succeeds",
      "input": "helmfile destroy && helmfile apply",
      "expectedOutput": "Exit code 0, all resources created",
      "testFunction": "test_clean_deployment"
    },
    {
      "impulseId": "validation-schema-init-case-5",
      "name": "init-schema Job exists",
      "input": "kubectl get jobs -n metabob",
      "expectedOutput": "Job named *init-schema* exists",
      "testFunction": "test_init_schema_job_exists"
    },
    {
      "impulseId": "validation-schema-init-case-6",
      "name": "init-schema Job completes successfully",
      "input": "kubectl wait --for=condition=complete job/init-schema",
      "expectedOutput": "Job status.succeeded=1 within 5 minutes",
      "testFunction": "test_init_schema_job_completion"
    },
    {
      "impulseId": "validation-schema-init-case-7",
      "name": "init-schema Job logs show success",
      "input": "kubectl logs job/init-schema",
      "expectedOutput": "Schema initialization successful, 13/13 tables with PERMISSIONS FULL",
      "testFunction": "test_init_schema_job_logs"
    },
    {
      "impulseId": "validation-schema-init-case-8",
      "name": "SurrealDB pod is running",
      "input": "kubectl get pods -l app=surrealdb",
      "expectedOutput": "Pod status=Running and ready",
      "testFunction": "test_surrealdb_pod_running"
    },
    {
      "impulseId": "validation-schema-init-case-9",
      "name": "All 13 tables exist in SurrealDB",
      "input": "surreal sql 'INFO FOR DB;'",
      "expectedOutput": "13 tables: activity_template, activity_execution, activity_variants, variant_performance_metrics, vessel_registry, users, sessions, organizations, projects, subscriptions, api_keys, audit_logs, schema_versions",
      "testFunction": "test_surrealdb_tables_exist"
    },
    {
      "impulseId": "validation-schema-init-case-10",
      "name": "All 8 indexes exist in SurrealDB",
      "input": "surreal sql 'INFO FOR DB;'",
      "expectedOutput": "8 indexes: activity_template_id_idx, activity_template_category_idx, activity_template_org_idx, activity_execution_id_idx, activity_execution_template_idx, activity_execution_status_idx, vessel_registry_pod_name_idx, vessel_registry_status_idx",
      "testFunction": "test_surrealdb_indexes_exist"
    }
  ],
  "harnessImpulseId": "harness-Database Schema Initialization - Automatic Schema Creation on Fresh Deployment",
  "validationStrategy": {
    "phase1": "Configuration validation (non-destructive)",
    "phase2": "Clean deployment test (destructive, requires confirmation)",
    "phase3": "Runtime validation (Job completion, logs, database state)"
  },
  "usage": {
    "command": "./tests/validation-harnesses/schema-init-harness.sh",
    "requirements": [
      "kubectl configured for target cluster",
      "helmfile CLI installed",
      "metabob-apps repository cloned",
      "User confirmation for destructive tests"
    ]
  }
}
