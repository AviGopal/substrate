{
  "name": "Test Multi Task",
  "description": "Simple 3-task activity to test orchestration",
  "category": "infrastructure",
  "version": "1.0.0",
  "tasks": [
    {
      "id": "task-1",
      "description": "Create directory",
      "subagent": "general",
      "dependencies": [],
      "prompt": {
        "template": "Create a directory at /tmp/multi-task-test-{{testId}}/ using mkdir -p",
        "maxTokens": 2000,
        "compressionStrategy": "filter",
        "variables": [
          {
            "name": "testId",
            "type": "string",
            "required": true,
            "description": "Test identifier"
          }
        ]
      },
      "validation": {
        "requiredFiles": [],
        "requiredPatterns": [],
        "forbiddenPatterns": [],
        "commands": [
          {
            "command": "test -d /tmp/multi-task-test-{{testId}}",
            "expected_exit_code": 0
          }
        ]
      },
      "retry": {
        "maxAttempts": 1,
        "strategy": "simple"
      }
    },
    {
      "id": "task-2",
      "description": "Create first file",
      "subagent": "general",
      "dependencies": ["task-1"],
      "prompt": {
        "template": "Create a file at /tmp/multi-task-test-{{testId}}/file1.txt with content: Task 2 completed",
        "maxTokens": 2000,
        "compressionStrategy": "filter",
        "variables": [
          {
            "name": "testId",
            "type": "string",
            "required": true,
            "description": "Test identifier"
          }
        ]
      },
      "validation": {
        "requiredFiles": ["/tmp/multi-task-test-{{testId}}/file1.txt"],
        "requiredPatterns": ["Task 2 completed"],
        "forbiddenPatterns": [],
        "commands": []
      },
      "retry": {
        "maxAttempts": 1,
        "strategy": "simple"
      }
    },
    {
      "id": "task-3",
      "description": "Create second file",
      "subagent": "general",
      "dependencies": ["task-2"],
      "prompt": {
        "template": "Create a file at /tmp/multi-task-test-{{testId}}/file2.txt with content: Task 3 completed",
        "maxTokens": 2000,
        "compressionStrategy": "filter",
        "variables": [
          {
            "name": "testId",
            "type": "string",
            "required": true,
            "description": "Test identifier"
          }
        ]
      },
      "validation": {
        "requiredFiles": ["/tmp/multi-task-test-{{testId}}/file2.txt"],
        "requiredPatterns": ["Task 3 completed"],
        "forbiddenPatterns": [],
        "commands": []
      },
      "retry": {
        "maxAttempts": 1,
        "strategy": "simple"
      }
    }
  ]
}
