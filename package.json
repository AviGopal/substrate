{
  "name": "conversation-vessel",
  "version": "1.0.0",
  "description": "A MiniBob vessel for managing conversations with persistent context and memory",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "conversation-vessel": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "run-activity": "bun run .minibob/run-activity.ts",
    "gossip": "bun run .minibob/gossip.ts",
    "impulse": "bun run .minibob/impulse.ts",
    "test": "bun test",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "minibob",
    "vessel",
    "conversation",
    "context",
    "memory",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/node": "^20.0.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.0",
    "@metabob/minibob": "*"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "trustedDependencies": [
    "@metabob/minibob"
  ]
}