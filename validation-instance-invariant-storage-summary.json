{
  "specificationName": "instance-invariant-storage-with-vessel-flow",
  "harnessFile": "tests/validation-harnesses/invariant-storage-across-instances-with-vessel-flow-harness.ts",
  "testCases": [
    {
      "impulseId": "validation-invariant-storage-across-instances-with-vessel-flow-case-1",
      "name": "Vessel Flow Compliance",
      "input": {
        "impulseId": "test-impulse",
        "projectId": "test-project",
        "impulseData": { "id": "test-impulse", "type": "memo" }
      },
      "expectedOutput": {
        "noDirectImports": true,
        "usesCliTool": true,
        "callStack": ["opencode", "CLI MCP", "rpc-api"]
      },
      "description": "Verifies no direct RPC imports and impulse_store uses CLI MCP"
    },
    {
      "impulseId": "validation-invariant-storage-across-instances-with-vessel-flow-case-2",
      "name": "Cross-Instance Retrieval",
      "input": {},
      "expectedOutput": {
        "storeSuccess": true,
        "retrieveSuccess": true,
        "dataIntegrity": true
      },
      "description": "Instance A stores impulse, Instance B retrieves with same credentials"
    },
    {
      "impulseId": "validation-invariant-storage-across-instances-with-vessel-flow-case-3",
      "name": "Multi-Tenant Isolation",
      "input": {},
      "expectedOutput": {
        "accessDenied": true
      },
      "description": "Instance with different api_key cannot access other tenant's data"
    },
    {
      "impulseId": "validation-invariant-storage-across-instances-with-vessel-flow-case-4",
      "name": "Project Isolation",
      "input": {},
      "expectedOutput": {
        "projectIsolated": true
      },
      "description": "Same api_key, different project_id cannot access each other's data"
    },
    {
      "impulseId": "validation-invariant-storage-across-instances-with-vessel-flow-case-5",
      "name": "Pagination",
      "input": {},
      "expectedOutput": {
        "page1Count": 10,
        "page2Count": 5
      },
      "description": "Backend pagination works correctly for impulse list"
    },
    {
      "impulseId": "validation-invariant-storage-across-instances-with-vessel-flow-case-6",
      "name": "Backend Sync Enforcement (Dual-Write Pattern)",
      "input": {},
      "expectedOutput": {
        "hasImpulseBackendSync": true,
        "hasActivitySaveBackendSync": true,
        "hasActivityLoadBackendFallback": true,
        "hasDirectHTTP": false,
        "hasRequiredImports": true
      },
      "description": "Verifies 2026-02-27 enforcement: dual-write pattern and backend fallback"
    }
  ],
  "harnessImpulseId": "harness-instance-invariant-storage-with-vessel-flow",
  "executionInstructions": {
    "command": "cd tests/validation-harnesses && bun invariant-storage-across-instances-with-vessel-flow-harness.ts",
    "expectedExitCode": 0,
    "environment": {
      "required": [
        "METABOB_API_KEY (or TEST_API_KEY_1)",
        "METABOB_RPC_URL (default: http://localhost:8000)",
        "CLI_MCP_PORT (default: 3000)"
      ],
      "optional": [
        "TEST_API_KEY_2 (for multi-tenant testing)"
      ]
    }
  },
  "validationStrategy": {
    "approach": "Non-LLM automated pass/fail testing",
    "steps": [
      "1. Verify no direct RPC imports (vessel boundary enforcement)",
      "2. Test cross-instance impulse storage and retrieval",
      "3. Verify multi-tenant isolation (api_key scoping)",
      "4. Verify project isolation (project_id scoping)",
      "5. Test pagination",
      "6. Verify enforcement: dual-write pattern + backend fallback"
    ],
    "expectedBehavior": "All 6 test cases PASS with vessel flow enforced",
    "failureConditions": [
      "Direct RPC imports found in opencode",
      "Cross-instance retrieval fails",
      "Tenant isolation broken",
      "Project isolation broken",
      "Pagination broken",
      "Enforcement not applied (missing backend sync or fallback)"
    ]
  },
  "enforcementValidation": {
    "testCase": "case-6",
    "checks": [
      {
        "file": "repos/metabob-opencode/packages/opencode/src/tool/impulse-create.ts",
        "requirement": "Calls metabob_impulse_store via MCP.clients()",
        "method": "Static code analysis (grep for 'metabob_impulse_store' and 'MCP.clients()')"
      },
      {
        "file": "repos/metabob-opencode/packages/opencode/src/session/activity.ts",
        "requirement": "Activity.save calls metabob_activity_save via MCP.clients()",
        "method": "Static code analysis (grep for 'metabob_activity_save' and 'MCP.clients()')"
      },
      {
        "file": "repos/metabob-opencode/packages/opencode/src/session/activity.ts",
        "requirement": "Activity.load has try/catch with metabob_activity_load backend fallback",
        "method": "Static code analysis (grep for 'metabob_activity_load', 'backend fallback', 'try/catch')"
      },
      {
        "file": "repos/metabob-opencode/packages/opencode/src",
        "requirement": "No direct HTTP calls to metabob backend (vessel compliance)",
        "method": "Static code analysis (grep for 'fetch(' + 'metabob' in same context)"
      },
      {
        "file": "impulse-create.ts, activity.ts",
        "requirement": "Required imports: MCP, Instance",
        "method": "Static code analysis (grep for 'import { MCP }' and 'import { Instance }')"
      }
    ]
  }
}
