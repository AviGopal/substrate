{
  "name": "Activity System Validation",
  "description": "End-to-end validation of activity creation, registration, and execution with backend logging",
  "category": "infrastructure",
  "tasks": [
    {
      "id": "test-local-storage",
      "subagent": "general",
      "description": "Test local storage functionality",
      "dependencies": [],
      "executionMode": "deterministic",
      "toolSequence": [
        {
          "tool": "bash",
          "params": {
            "command": "echo '=== Activity System Validation ===' && echo 'Test message: {{testMessage}}' && echo 'Timestamp:' && date && echo 'Local storage test: SUCCESS'",
            "description": "Validate local execution"
          }
        }
      ],
      "validation": {
        "requiredFiles": [],
        "requiredPatterns": [],
        "forbiddenPatterns": [],
        "commands": []
      },
      "retry": {
        "maxAttempts": 1,
        "strategy": "simple"
      },
      "metrics": {
        "successRate": 0,
        "avgTokens": 0,
        "avgDuration": 0,
        "commonFailures": []
      }
    },
    {
      "id": "check-backend-connection",
      "subagent": "general",
      "description": "Verify backend connectivity",
      "dependencies": ["test-local-storage"],
      "executionMode": "deterministic",
      "toolSequence": [
        {
          "tool": "bash",
          "params": {
            "command": "echo 'Checking backend connectivity...' && curl -s http://api.metabob.local/ | jq -r '.status' && echo 'Backend check: SUCCESS'",
            "description": "Test backend API connectivity"
          }
        }
      ],
      "validation": {
        "requiredFiles": [],
        "requiredPatterns": [],
        "forbiddenPatterns": [],
        "commands": []
      },
      "retry": {
        "maxAttempts": 1,
        "strategy": "simple"
      },
      "metrics": {
        "successRate": 0,
        "avgTokens": 0,
        "avgDuration": 0,
        "commonFailures": []
      }
    },
    {
      "id": "verify-template-storage",
      "subagent": "general",
      "description": "Verify template was stored locally",
      "dependencies": ["check-backend-connection"],
      "executionMode": "deterministic",
      "toolSequence": [
        {
          "tool": "bash",
          "params": {
            "command": "echo 'Checking local template storage...' && ls -lh ~/.local/share/opencode/storage/activity-template/ | grep -i 'activity-system-validation' && echo 'Template storage: SUCCESS' || echo 'Template storage: NOT FOUND (expected on first run)'",
            "description": "Check template storage"
          }
        }
      ],
      "validation": {
        "requiredFiles": [],
        "requiredPatterns": [],
        "forbiddenPatterns": [],
        "commands": []
      },
      "retry": {
        "maxAttempts": 1,
        "strategy": "simple"
      },
      "metrics": {
        "successRate": 0,
        "avgTokens": 0,
        "avgDuration": 0,
        "commonFailures": []
      }
    }
  ],
  "integration": {
    "preChecks": [],
    "postChecks": [],
    "qualityGates": []
  },
  "metabob": {
    "enabled": false,
    "learningMode": false,
    "targetContextTokens": 0,
    "annotationStrategy": "key-components"
  }
}
