{
  "specificationName": "rpc-api-deployed-infrastructure-validation",
  "harnessFile": "tests/validation-harnesses/rpc-api-deployed-infrastructure-validation-harness.ts",
  "harnessType": "Infrastructure-Aware E2E Validation",
  "description": "Validates RPC API endpoints against actual deployed Kubernetes infrastructure with real SurrealDB/Redis backends",
  "testCases": [
    {
      "impulseId": "validation-rpc-api-deployed-infrastructure-validation-case-1",
      "testCase": "TC1-Infrastructure-Status",
      "input": {
        "method": "GET",
        "endpoint": "/",
        "kubeCheck": "metabob-rpc-api pod in metabob namespace"
      },
      "expectedOutput": {
        "kubeStatus": "Running",
        "statusCode": 200,
        "response": {"status": "ok"}
      }
    },
    {
      "impulseId": "validation-rpc-api-deployed-infrastructure-validation-case-2",
      "testCase": "TC2-Health-Check",
      "input": {
        "method": "GET",
        "endpoint": "/"
      },
      "expectedOutput": {
        "statusCode": 200,
        "response": {
          "status": "ok",
          "version": "0.16.4",
          "timestamp": "ISO8601"
        }
      }
    },
    {
      "impulseId": "validation-rpc-api-deployed-infrastructure-validation-case-3",
      "testCase": "TC3-List-Templates-Empty",
      "input": {
        "method": "GET",
        "endpoint": "/v2/activities/templates",
        "headers": {
          "x-tenant-id": "validation-harness",
          "x-org-id": "test-org",
          "x-project-id": "test-project"
        }
      },
      "expectedOutput": {
        "statusCode": 200,
        "response": {"templates": []}
      }
    },
    {
      "impulseId": "validation-rpc-api-deployed-infrastructure-validation-case-4",
      "testCase": "TC4-List-Templates-MultiTenant",
      "input": {
        "method": "GET",
        "endpoint": "/v2/activities/templates",
        "headers": {
          "x-tenant-id": "tenant-isolation-test",
          "x-org-id": "org-isolation-test",
          "x-project-id": "project-isolation-test"
        }
      },
      "expectedOutput": {
        "statusCode": 200,
        "response": {"templates": []}
      }
    },
    {
      "impulseId": "validation-rpc-api-deployed-infrastructure-validation-case-5",
      "testCase": "TC5-Create-Template-SurrealDB-Blocker",
      "input": {
        "method": "POST",
        "endpoint": "/v2/activities/templates",
        "headers": {
          "Content-Type": "application/json",
          "x-tenant-id": "validation-harness"
        },
        "body": {
          "name": "validation-harness-test-template",
          "category": "testing",
          "tasks": [{"id": "task-1"}]
        }
      },
      "expectedOutput": {
        "statusCode": 500,
        "error": "SurrealDB authentication failure (401)",
        "blockedBy": "SurrealDB v2.3.10 incompatible with Python client"
      }
    },
    {
      "impulseId": "validation-rpc-api-deployed-infrastructure-validation-case-6",
      "testCase": "TC6-Schema-Tolerance-Minimal",
      "input": {
        "method": "POST",
        "endpoint": "/api/v1/learning-loop/executions",
        "headers": {
          "Content-Type": "application/json",
          "x-tenant-id": "validation-harness"
        },
        "body": {
          "activity_id": "test-activity-harness-schema-tolerance",
          "duration_ms": 5000,
          "success": true
        }
      },
      "expectedOutput": {
        "statusCode": 201,
        "response": {
          "success": true,
          "execution_id": "string"
        }
      }
    },
    {
      "impulseId": "validation-rpc-api-deployed-infrastructure-validation-case-7",
      "testCase": "TC7-Error-Handling-Invalid-Tenant",
      "input": {
        "method": "GET",
        "endpoint": "/v2/activities/templates",
        "headers": {
          "x-tenant-id": "invalid-tenant-$$$"
        }
      },
      "expectedOutput": {
        "statusCode": 200,
        "response": {"templates": []}
      }
    },
    {
      "impulseId": "validation-rpc-api-deployed-infrastructure-validation-case-8",
      "testCase": "TC8-SurrealDB-Version-Check",
      "input": {
        "infraCheck": "kubectl exec surrealdb-pod -- /surreal version"
      },
      "expectedOutput": {
        "version": "2.3.10 for linux on x86_64",
        "incompatible": true,
        "requiredVersion": "v3.0+"
      }
    },
    {
      "impulseId": "validation-rpc-api-deployed-infrastructure-validation-case-9",
      "testCase": "TC9-Redis-Connectivity",
      "input": {
        "infraCheck": "kubectl exec redis-master-0 -- redis-cli PING"
      },
      "expectedOutput": {
        "response": "PONG",
        "connected": true
      }
    }
  ],
  "harnessImpulseId": "harness-rpc-api-deployed-infrastructure-validation",
  "harnessCapabilities": {
    "kubernetesIntegration": {
      "podStatusChecks": true,
      "podExecution": true,
      "namespaceScoped": true,
      "description": "Validates pod status and executes commands in SurrealDB/Redis pods"
    },
    "httpTesting": {
      "methods": ["GET", "POST", "PUT", "DELETE"],
      "headerSupport": true,
      "bodySupport": true,
      "description": "Makes real HTTP requests to api.metabob.local endpoints"
    },
    "databaseValidation": {
      "surrealdb": {
        "versionCheck": true,
        "directQuery": true,
        "authTesting": true,
        "description": "Validates SurrealDB version and data persistence"
      },
      "redis": {
        "connectivity": true,
        "cacheValidation": true,
        "description": "Validates Redis connection and caching behavior"
      }
    },
    "errorHandling": {
      "invalidTenant": true,
      "missingFields": true,
      "infrastructureFailures": true,
      "description": "Tests error scenarios and graceful degradation"
    }
  },
  "infrastructureChecks": {
    "preFlight": [
      "RPC API pod status in metabob namespace",
      "DevBob pod status in metabob namespace",
      "SurrealDB version check",
      "Redis connectivity (PING)"
    ],
    "perTest": [
      "Optional kubeCheck for pod status validation",
      "Optional surrealCheck for data persistence queries"
    ]
  },
  "knownBlockers": [
    {
      "blocker": "SurrealDB Version Mismatch",
      "severity": "CRITICAL",
      "affectedTests": ["TC5", "TC6 (partial)"],
      "workaround": "TC5 expected to fail, TC6 blocked for full DB validation",
      "resolution": "Upgrade SurrealDB to v3.0+ in metabob namespace"
    }
  ],
  "validationStrategy": {
    "approach": "Infrastructure-Aware E2E Testing",
    "realInfrastructure": true,
    "mockServices": false,
    "description": "Tests against actual deployed Kubernetes services with real backends",
    "benefits": [
      "Validates code changes are actually deployed",
      "Tests real infrastructure dependencies (SurrealDB, Redis)",
      "Verifies multi-tenant isolation with actual headers",
      "Catches deployment and configuration issues",
      "Confirms end-to-end data flow through real backends"
    ]
  },
  "usage": {
    "cli": "npx tsx tests/validation-harnesses/rpc-api-deployed-infrastructure-validation-harness.ts",
    "programmatic": "import { runValidation } from './harness'; await runValidation(input)",
    "environment": {
      "RPC_API_URL": "http://api.metabob.local (default)",
      "KUBE_NAMESPACE": "metabob (default)",
      "SURREAL_POD": "surrealdb-5bdddd9989-sdm5g (default)",
      "DEVBOB_POD": "devbob-766dcccf49-hfql6 (default)",
      "RPC_API_POD": "metabob-rpc-api-5c5dfb6b9b-rbhm8 (default)"
    }
  },
  "expectedResults": {
    "beforeInfrastructureUpgrade": {
      "passed": 3,
      "failed": 1,
      "skipped": 5,
      "details": "TC1, TC2, TC3, TC4 pass; TC5 fails (SurrealDB); TC6 blocked; TC7 passes; TC8, TC9 info only"
    },
    "afterInfrastructureUpgrade": {
      "passed": 7,
      "failed": 0,
      "skipped": 2,
      "details": "All HTTP tests pass after SurrealDB v3+ upgrade; TC8, TC9 info only"
    }
  }
}
