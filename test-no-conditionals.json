{
  "id": "test-no-conditionals",
  "name": "Test No Conditionals",
  "description": "Test with medium prompt but NO Handlebars conditionals",
  "category": "infrastructure",
  "tasks": [
    {
      "id": "no-conditional-task",
      "subagent": "general",
      "description": "Create file with only basic variable substitution",
      "dependencies": [],
      "tools": {
        "required": [],
        "optional": [],
        "disabled": []
      },
      "prompt": {
        "template": "Create a file called {{filename}} with the following content:\n\nTitle: {{title}}\nDescription: {{description}}\nNotes: {{notes}}\n\nThis is a longer prompt to test if length matters when there are no Handlebars conditionals. We're testing whether the issue is conditional syntax or just prompt length. This prompt is around 300 characters to provide a good test case.",
        "maxTokens": 2000,
        "compressionStrategy": "none",
        "variables": [
          {
            "name": "filename",
            "type": "string",
            "required": true,
            "description": "Filename"
          },
          {
            "name": "title",
            "type": "string",
            "required": true,
            "description": "Title"
          },
          {
            "name": "description",
            "type": "string",
            "required": true,
            "description": "Description"
          },
          {
            "name": "notes",
            "type": "string",
            "required": true,
            "description": "Notes"
          }
        ]
      },
      "validation": {
        "requiredFiles": [],
        "requiredPatterns": [],
        "forbiddenPatterns": [],
        "commands": []
      },
      "retry": {
        "maxAttempts": 3,
        "strategy": "simple"
      }
    }
  ],
  "contextRequirements": [],
  "integration": {
    "preChecks": [],
    "postChecks": [],
    "qualityGates": []
  },
  "metabob": {
    "enabled": false,
    "learningMode": false,
    "targetContextTokens": 1000,
    "annotationStrategy": "failures-only"
  }
}
