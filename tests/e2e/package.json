{
  "name": "@metabob/e2e-tests",
  "version": "0.1.0",
  "private": true,
  "description": "E2E tests for metabob multi-tenant RBAC system",
  "scripts": {
    "test": "playwright test",
    "test:m1": "playwright test m1-foundation.test.ts",
    "test:m2": "playwright test m2-data-flows.test.ts",
    "test:m3": "playwright test m3-isolation.test.ts",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report ../test-results/html",
    "setup": "bun run global-setup.ts",
    "teardown": "bun run global-teardown.ts"
  },
  "dependencies": {
    "@playwright/test": "^1.40.0",
    "surrealdb": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
