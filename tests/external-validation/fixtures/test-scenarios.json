{
  "$schema": "./test-scenarios.schema.json",
  "version": "1.0.0",
  "description": "External black-box validation scenarios for activity system",
  "scenarios": [
    {
      "id": "scenario-a-search",
      "name": "Search for Existing Activity",
      "description": "Validates that activity search works via CLI without direct tool calls",
      "category": "discovery",
      "command": "opencode activity search 'add REST endpoint'",
      "expectedPatterns": [
        {
          "pattern": "search_activities.*called",
          "description": "Search activities tool invoked",
          "severity": "required"
        },
        {
          "pattern": "templates.*returned",
          "description": "Templates returned from backend",
          "severity": "required"
        },
        {
          "pattern": "Template.*add-rest-endpoint",
          "description": "Specific template found in results",
          "severity": "optional"
        }
      ],
      "forbiddenPatterns": [
        {
          "pattern": "bash.*tool.*sessionID:.*root",
          "description": "Direct bash call in root session",
          "severity": "critical"
        },
        {
          "pattern": "read.*tool.*sessionID:.*root",
          "description": "Direct read call in root session",
          "severity": "critical"
        },
        {
          "pattern": "edit.*tool.*sessionID:.*root",
          "description": "Direct edit call in root session",
          "severity": "critical"
        },
        {
          "pattern": "write.*tool.*sessionID:.*root",
          "description": "Direct write call in root session",
          "severity": "critical"
        }
      ],
      "successCriteria": {
        "allRequiredPatternsFound": true,
        "noForbiddenPatternsFound": true,
        "exitCode": 0,
        "executionTime": {
          "max": 30000,
          "unit": "ms"
        }
      }
    },
    {
      "id": "scenario-b-execute",
      "name": "Execute Existing Activity",
      "description": "Validates that activity execution works with proper session isolation",
      "category": "execution",
      "command": "opencode activity add-rest-endpoint --variables '{\"method\":\"POST\",\"path\": \"/api/test\",\"requestSchema\":\"z.object({})\",\"responseSchema\":\"z.object({})\",\"handlerDescription\":\"Test handler\"}' --reason 'External validation test'",
      "expectedPatterns": [
        {
          "pattern": "Activity.*starting",
          "description": "Activity execution started",
          "severity": "required"
        },
        {
          "pattern": "Memory agent initializing",
          "description": "Memory agent initialized for context",
          "severity": "required"
        },
        {
          "pattern": "Task.*starting",
          "description": "Task execution started",
          "severity": "required"
        },
        {
          "pattern": "Task.*completed",
          "description": "Task execution completed",
          "severity": "required"
        },
        {
          "pattern": "Activity.*completed",
          "description": "Activity execution completed",
          "severity": "required"
        },
        {
          "pattern": "storage write confirmed",
          "description": "Execution recorded to storage",
          "severity": "required"
        }
      ],
      "forbiddenPatterns": [
        {
          "pattern": "bash.*tool.*sessionID:.*root-session",
          "description": "Direct bash call in root session",
          "severity": "critical"
        },
        {
          "pattern": "read.*tool.*sessionID:.*root-session",
          "description": "Direct read call in root session",
          "severity": "critical"
        },
        {
          "pattern": "edit.*tool.*sessionID:.*root-session",
          "description": "Direct edit call in root session",
          "severity": "critical"
        },
        {
          "pattern": "write.*tool.*sessionID:.*root-session",
          "description": "Direct write call in root session",
          "severity": "critical"
        }
      ],
      "allowedPatterns": [
        {
          "pattern": "bash.*tool.*sessionID:.*activity-",
          "description": "Bash calls in activity child session are allowed",
          "severity": "expected"
        },
        {
          "pattern": "read.*tool.*sessionID:.*activity-",
          "description": "Read calls in activity child session are allowed",
          "severity": "expected"
        },
        {
          "pattern": "edit.*tool.*sessionID:.*activity-",
          "description": "Edit calls in activity child session are allowed",
          "severity": "expected"
        }
      ],
      "successCriteria": {
        "allRequiredPatternsFound": true,
        "noForbiddenPatternsFound": true,
        "allLifecyclePatternsFound": true,
        "toolCallsInChildSessionOnly": true,
        "exitCode": 0,
        "executionTime": {
          "max": 300000,
          "unit": "ms"
        }
      }
    },
    {
      "id": "scenario-c-create",
      "name": "Create Activity via Goal-Seeking",
      "description": "Validates that goal-seeking activity creation works without executing the activity",
      "category": "creation",
      "command": "opencode activity create --goal 'Add health check endpoint that returns server status' --name 'Add Health Check Endpoint' --category 'feature'",
      "expectedPatterns": [
        {
          "pattern": "create_activity_goal_seeking.*called",
          "description": "Goal-seeking tool invoked",
          "severity": "required"
        },
        {
          "pattern": "Goal.*decomposed",
          "description": "Goal decomposed into sub-goals",
          "severity": "required"
        },
        {
          "pattern": "Searching.*existing.*activities",
          "description": "Searched for composable activities",
          "severity": "required"
        },
        {
          "pattern": "Template.*created",
          "description": "Template generated",
          "severity": "required"
        },
        {
          "pattern": "Registered.*backend|Template.*registered",
          "description": "Template registered to backend",
          "severity": "required"
        },
        {
          "pattern": "Template ID:.*add-health-check-endpoint",
          "description": "Template ID returned",
          "severity": "optional"
        }
      ],
      "forbiddenPatterns": [
        {
          "pattern": "Activity.*starting.*add-health-check-endpoint",
          "description": "Should NOT execute the created activity",
          "severity": "critical"
        },
        {
          "pattern": "Task.*starting",
          "description": "Should NOT execute any tasks",
          "severity": "critical"
        },
        {
          "pattern": "bash.*tool.*sessionID:.*root",
          "description": "Direct bash call in root session",
          "severity": "critical"
        }
      ],
      "successCriteria": {
        "allRequiredPatternsFound": true,
        "noForbiddenPatternsFound": true,
        "templateCreated": true,
        "templateNotExecuted": true,
        "exitCode": 0,
        "executionTime": {
          "max": 120000,
          "unit": "ms"
        }
      }
    }
  ],
  "globalValidation": {
    "description": "Validation criteria that apply to all scenarios",
    "forbiddenPatterns": [
      {
        "pattern": "TypeError|ReferenceError|SyntaxError",
        "description": "No runtime errors",
        "severity": "critical"
      },
      {
        "pattern": "FATAL|CRITICAL ERROR",
        "description": "No fatal errors",
        "severity": "critical"
      }
    ],
    "logRequirements": {
      "minLogLines": 10,
      "structuredLogging": true,
      "timestampsRequired": true
    }
  },
  "metaValidation": {
    "description": "Validates that the test properly tested all requirements",
    "requirements": [
      {
        "id": "req-1",
        "description": "Test ran compiled distribution, not dev code",
        "validationPattern": "Using distribution.*opencode.*dist"
      },
      {
        "id": "req-2",
        "description": "Test used CLI/API only, no direct code execution",
        "validationPattern": "Command executed:.*opencode"
      },
      {
        "id": "req-3",
        "description": "Logs captured for all scenarios",
        "validationPattern": "Log file created.*scenario-[abc]"
      },
      {
        "id": "req-4",
        "description": "Activity search tested",
        "validationPattern": "Scenario.*scenario-a-search.*PASS"
      },
      {
        "id": "req-5",
        "description": "Activity execution tested",
        "validationPattern": "Scenario.*scenario-b-execute.*PASS"
      },
      {
        "id": "req-6",
        "description": "Activity creation tested",
        "validationPattern": "Scenario.*scenario-c-create.*PASS"
      },
      {
        "id": "req-7",
        "description": "No direct tool calls validated",
        "validationPattern": "Forbidden patterns.*0 found"
      }
    ]
  }
}
