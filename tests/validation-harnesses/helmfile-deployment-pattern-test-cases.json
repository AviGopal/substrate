{
  "specificationName": "helmfile-deployment-pattern-with-versioned-builds",
  "version": "1.0",
  "testCases": [
    {
      "id": "validation-helmfile-deployment-pattern-case-1",
      "name": "No Configuration Drift",
      "description": "Helmfile diff should show no changes when cluster state matches git",
      "input": {
        "command": "helmfile -e local diff",
        "environment": "local",
        "namespace": "metabob"
      },
      "expectedOutput": {
        "exitCode": 0,
        "contains": [],
        "notContains": ["has changed", "will be created", "will be deleted"],
        "validation": "No drift between helmfile and cluster state"
      }
    },
    {
      "id": "validation-helmfile-deployment-pattern-case-2",
      "name": "No :latest Tags in Production",
      "description": "Production pods must use explicit version tags, not :latest",
      "input": {
        "command": "kubectl get pods -n metabob -o jsonpath='{.items[*].spec.containers[*].image}'",
        "environment": "production",
        "namespace": "metabob"
      },
      "expectedOutput": {
        "notContains": [":latest", ":<empty>"],
        "pattern": ".*:(main-[a-f0-9]{7}|[0-9]+\\.[0-9]+\\.[0-9]+).*",
        "validation": "All images have explicit version tags"
      }
    },
    {
      "id": "validation-helmfile-deployment-pattern-case-3",
      "name": "All Resources Managed by Helm",
      "description": "No kubectl bypass - all resources must have Helm management label",
      "input": {
        "command": "kubectl get all -n metabob -o json",
        "namespace": "metabob"
      },
      "expectedOutput": {
        "allItemsHaveLabel": "app.kubernetes.io/managed-by=Helm",
        "validation": "All resources tracked by Helm"
      }
    },
    {
      "id": "validation-helmfile-deployment-pattern-case-4",
      "name": "No Hardcoded Credentials",
      "description": "Helm values must not contain plaintext passwords or API keys",
      "input": {
        "files": [
          "helm/charts/*/values.yaml",
          "helm/environments/*.values.yaml"
        ],
        "patterns": [
          "password:.*\"root\"",
          "password:.*'root'",
          "apiKey:.*\"[A-Za-z0-9]{20,}\""
        ]
      },
      "expectedOutput": {
        "matchCount": 0,
        "validation": "No hardcoded credentials in values files"
      }
    },
    {
      "id": "validation-helmfile-deployment-pattern-case-5",
      "name": "Istio Configuration Present (Production)",
      "description": "Production environment must include Istio settings",
      "input": {
        "file": "helm/environments/production.values.yaml",
        "requiredKeys": ["istio", "istio.enabled", "istio.mtls"]
      },
      "expectedOutput": {
        "contains": ["istio:", "enabled:", "mtls:"],
        "validation": "Istio configuration present in production values"
      }
    },
    {
      "id": "validation-helmfile-deployment-pattern-case-6",
      "name": "Stable Istio Subset Names",
      "description": "DestinationRule must use stable subset names (not version-based)",
      "input": {
        "file": "helm/charts/devbob/templates/destinationrule.yaml",
        "antipattern": "name:.*{{.*image.tag.*replace"
      },
      "expectedOutput": {
        "matchCount": 0,
        "contains": ["name: stable", "name: canary"],
        "validation": "Stable subset names used (no version-based naming)"
      }
    },
    {
      "id": "validation-helmfile-deployment-pattern-case-7",
      "name": "CI/CD GitOps Automation",
      "description": "GitHub Actions must auto-update Helm values after image push",
      "input": {
        "file": ".github/workflows/build-devbob.yml",
        "requiredSteps": ["update-helm-values", "yq", "git commit"]
      },
      "expectedOutput": {
        "contains": ["update-helm-values:", "yq eval", "git commit"],
        "validation": "CI/CD pipeline includes Helm values auto-update"
      }
    },
    {
      "id": "validation-helmfile-deployment-pattern-case-8",
      "name": "CI Validation Workflow",
      "description": "PR validation workflow must block GitOps violations",
      "input": {
        "file": ".github/workflows/validate-helmfile-gitops.yml",
        "requiredChecks": ["kubectl apply", "hardcoded credentials", "Istio subset"]
      },
      "expectedOutput": {
        "contains": ["kubectl apply", "hardcoded", "subset"],
        "validation": "CI validation workflow blocks antipatterns"
      }
    },
    {
      "id": "validation-helmfile-deployment-pattern-case-9",
      "name": "Kubernetes Secrets Usage",
      "description": "Deployments must reference secrets via secretKeyRef, not plaintext",
      "input": {
        "command": "kubectl get deployment -n metabob -o yaml",
        "namespace": "metabob"
      },
      "expectedOutput": {
        "contains": ["valueFrom:", "secretKeyRef:", "name: devbob-secrets"],
        "notContains": ["value: root", "value: password"],
        "validation": "Deployment uses Kubernetes Secrets correctly"
      }
    },
    {
      "id": "validation-helmfile-deployment-pattern-case-10",
      "name": "Reproducible Deployment",
      "description": "Running helmfile sync twice should be idempotent (no changes)",
      "input": {
        "commands": [
          "helmfile -e local sync",
          "sleep 5",
          "helmfile -e local diff"
        ],
        "environment": "local"
      },
      "expectedOutput": {
        "exitCode": 0,
        "notContains": ["has changed", "will be updated"],
        "validation": "Deployment is idempotent and reproducible"
      }
    }
  ],
  "metadata": {
    "createdAt": "2026-02-27",
    "specification": "helmfile-deployment-pattern-with-versioned-builds",
    "harnessFile": "tests/validation-harnesses/helmfile-deployment-pattern-harness.sh",
    "totalTestCases": 10,
    "environments": ["local", "production"],
    "requiredTools": ["kubectl", "helm", "helmfile", "jq"]
  }
}
