{
  "impulseId": "validation-thompson-sampling-in-rpc-api-only-case-1",
  "testCase": "No Thompson Sampling keywords in metabob-opencode",
  "input": {
    "testType": "grep-ml-keywords",
    "config": {
      "repo": "repos/metabob-opencode",
      "patterns": ["thompson", "beta", "betavariate", "sample_beta", "sampleBeta", "Math.random.*alpha.*beta"],
      "excludePatterns": [
        "thompsonSampling:",
        "// Thompson Sampling",
        "Thompson Sampling delegated",
        "selection_method.*thompson",
        "thompson_sample:",
        "thompson_alpha:",
        "thompson_beta:",
        "::sample_beta",
        "anthropic-beta"
      ],
      "searchPath": "packages/opencode/src",
      "filePattern": "*.ts"
    }
  },
  "expectedOutput": {
    "matchCount": 0,
    "pass": true,
    "reason": "OpenCode must delegate Thompson Sampling to RPC API, not implement locally"
  }
}
