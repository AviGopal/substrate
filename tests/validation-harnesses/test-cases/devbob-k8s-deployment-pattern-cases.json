{
  "specification": "devbob-k8s-deployment-pattern",
  "testCases": [
    {
      "id": "validation-devbob-k8s-deployment-pattern-case-1",
      "name": "Pod Ready State",
      "input": {
        "namespace": "metabob",
        "timeout": 60,
        "selector": "app.kubernetes.io/name=devbob"
      },
      "expectedOutput": {
        "podReady": true,
        "readyWithin": "60s",
        "readyStatus": "True",
        "restartCount": 0
      },
      "description": "Verifies that DevBob pod starts successfully and reaches Ready state within 60 seconds without restarts"
    },
    {
      "id": "validation-devbob-k8s-deployment-pattern-case-2",
      "name": "ACP Server Listening",
      "input": {
        "namespace": "metabob",
        "port": 8080,
        "logPattern": "listening.*8080|ACP.*8080|server.*listening.*8080"
      },
      "expectedOutput": {
        "acpServerListening": true,
        "port": 8080,
        "logMessage": "ACP server listening on http://0.0.0.0:8080"
      },
      "description": "Verifies that ACP server successfully starts and logs listening message on port 8080"
    },
    {
      "id": "validation-devbob-k8s-deployment-pattern-case-3",
      "name": "Health Endpoint",
      "input": {
        "namespace": "metabob",
        "endpoint": "http://localhost:8080/health",
        "method": "GET"
      },
      "expectedOutput": {
        "httpCode": 200,
        "healthy": true,
        "responseTime": "<3000ms"
      },
      "description": "Verifies that /health endpoint returns HTTP 200 indicating server is healthy"
    },
    {
      "id": "validation-devbob-k8s-deployment-pattern-case-4",
      "name": "Secrets Injection",
      "input": {
        "namespace": "metabob",
        "requiredSecrets": [
          "ANTHROPIC_API_KEY",
          "GITHUB_TOKEN",
          "GIT_USER_NAME",
          "GIT_USER_EMAIL"
        ]
      },
      "expectedOutput": {
        "ANTHROPIC_API_KEY": "set and non-empty",
        "GITHUB_TOKEN": "set",
        "GIT_USER_NAME": "set",
        "GIT_USER_EMAIL": "set",
        "allSecretsInjected": true
      },
      "description": "Verifies that all required secrets are properly injected via Kubernetes secretKeyRef"
    },
    {
      "id": "validation-devbob-k8s-deployment-pattern-case-5",
      "name": "Backend Services Connectivity",
      "input": {
        "namespace": "metabob",
        "services": [
          {
            "name": "redis",
            "host": "redis-master.metabob.svc.cluster.local",
            "port": 6379
          },
          {
            "name": "surrealdb",
            "host": "surrealdb.metabob.svc.cluster.local",
            "port": 8000
          },
          {
            "name": "metabob-rpc-api",
            "host": "metabob-rpc-api.metabob.svc.cluster.local",
            "port": 80
          }
        ]
      },
      "expectedOutput": {
        "allServicesAccessible": true,
        "redis": {
          "dnsResolved": true,
          "portOpen": true
        },
        "surrealdb": {
          "dnsResolved": true,
          "portOpen": true
        },
        "metabob-rpc-api": {
          "dnsResolved": true,
          "portOpen": true
        }
      },
      "description": "Verifies that all backend services are accessible via Kubernetes DNS resolution"
    },
    {
      "id": "validation-devbob-k8s-deployment-pattern-case-6",
      "name": "Pod Configuration Compliance",
      "input": {
        "namespace": "metabob",
        "expectedConfig": {
          "imageTag": "latest",
          "imagePullPolicy": "Never",
          "port": 8080,
          "hasCommand": true,
          "hasPrintLogsFlag": true,
          "HOME": "/workspace"
        }
      },
      "expectedOutput": {
        "imageTag": "latest",
        "imagePullPolicy": "Never",
        "restartCount": 0,
        "commandPresent": true,
        "printLogsFlagPresent": true,
        "portCorrect": 8080,
        "HOMECorrect": "/workspace"
      },
      "description": "Verifies that pod configuration matches specification requirements (image tag, pull policy, command, args, env vars)"
    },
    {
      "id": "validation-devbob-k8s-deployment-pattern-case-7",
      "name": "Deployment Method (Helm)",
      "input": {
        "namespace": "metabob",
        "releaseName": "devbob",
        "chartPath": "helm/charts/devbob"
      },
      "expectedOutput": {
        "deploymentMethod": "helm",
        "helmReleaseExists": true,
        "deploymentResourceExists": true,
        "statefulSetExists": false,
        "canonical": true
      },
      "description": "Verifies that DevBob is deployed via Helm chart (canonical method) using Deployment resource, not deprecated StatefulSet"
    }
  ]
}
