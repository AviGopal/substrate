{
  "testCase": "normal-session",
  "description": "Test normal session with typical metrics",
  "input": {
    "sessionSetup": {
      "messageCount": 10,
      "totalCost": 0.50,
      "totalTokens": {
        "input": 5000,
        "output": 2000,
        "cache": 1000
      },
      "activityStates": {
        "active": 1,
        "completed": 5,
        "failed": 1
      },
      "impulseData": {
        "impulseCount": 3,
        "totalBudget": 5000,
        "usedTokens": 3000
      }
    }
  },
  "expectedOutput": {
    "cost": 0.50,
    "tokens": {
      "input": 5000,
      "output": 2000,
      "cache": 1000
    },
    "activities": {
      "total": 7,
      "completed": 5,
      "failed": 1,
      "successRate": 0.833
    },
    "contextUtilization": 60.0,
    "consistency": {
      "endpointVsStats": true,
      "endpointVsTui": true,
      "statsVsTui": true,
      "tolerance": 0.01
    }
  }
}
