{
  "testCases": [
    {
      "impulseId": "validation-activity-history-comprehensive-display-case-1",
      "name": "Basic Display Validation",
      "description": "Verify that activity executions are displayed in the table with correct data",
      "input": {
        "minExecutions": 3,
        "checkFields": [
          "template_id",
          "success",
          "timestamp",
          "duration_ms",
          "cost_usd",
          "tokens_total"
        ]
      },
      "expectedOutput": {
        "tableVisible": true,
        "executionsCount": ">= 3",
        "dataAccuracy": "<= 1% variance",
        "loadTime": "< 3000ms"
      }
    },
    {
      "impulseId": "validation-activity-history-comprehensive-display-case-2",
      "name": "Expandable Rows Validation",
      "description": "Verify that expandable rows show task breakdown and impulse details",
      "input": {
        "expandRowIndex": 0,
        "checkTaskDetails": true,
        "checkImpulseDetails": true
      },
      "expectedOutput": {
        "expandWorks": true,
        "tasksDisplayed": true,
        "impulsesDisplayed": true,
        "taskCountMatches": true,
        "impulseCountMatches": true
      }
    },
    {
      "impulseId": "validation-activity-history-comprehensive-display-case-3",
      "name": "Filtering and Sorting Validation",
      "description": "Verify that filters and sorting work correctly",
      "input": {
        "testFilter": "template_id",
        "testSort": ["timestamp", "cost", "duration"]
      },
      "expectedOutput": {
        "filterWorks": true,
        "sortingWorks": true,
        "filteredResultsCorrect": true,
        "sortOrderCorrect": true
      }
    }
  ]
}
