{
  "specification": "ACP Bidirectional Streaming Protocol Handler",
  "testCases": [
    {
      "impulseId": "validation-acp-bidirectional-streaming-protocol-handler-case-1",
      "description": "Basic HTTP connection and protocol handshake via localhost",
      "input": {
        "devbobUrl": "http://localhost:8080/acp/stream",
        "testPrompt": "Echo back exactly: ACP TCP transport is working!",
        "timeout": 15000
      },
      "expectedOutput": {
        "httpStatus": 200,
        "hasServerInfo": true,
        "hasSessionId": true,
        "hasResponse": true,
        "noStreamErrors": true,
        "successMessage": "SUCCESS: ACP TCP transport is working!"
      },
      "validationCriteria": [
        "HTTP 200 response received",
        "Initialize message succeeds with serverInfo",
        "newSession creates session with sessionId",
        "Prompt executes successfully",
        "Agent response text received",
        "No 'ReadableStream is locked' errors",
        "No 'connection closed' errors",
        "Test completes with success message"
      ]
    },
    {
      "impulseId": "validation-acp-bidirectional-streaming-protocol-handler-case-2",
      "description": "Protocol handshake via Kubernetes service DNS",
      "input": {
        "devbobUrl": "http://devbob.metabob.svc.cluster.local:8080/acp/stream",
        "testPrompt": "Simple response test",
        "timeout": 15000
      },
      "expectedOutput": {
        "httpStatus": 200,
        "hasServerInfo": true,
        "hasSessionId": true,
        "hasResponse": true,
        "noStreamErrors": true,
        "successMessage": "SUCCESS: ACP TCP transport is working!"
      },
      "validationCriteria": [
        "HTTP 200 response via K8s service",
        "Initialize succeeds with internal DNS",
        "Session creation works in K8s",
        "Prompt execution via service endpoint",
        "Response received from containerized agent",
        "No stream locking in K8s environment",
        "No connection errors with service DNS",
        "Full end-to-end success"
      ]
    }
  ],
  "impulseMetadata": {
    "type": "memo",
    "budget": 2000,
    "storageLocation": "impulses/validation-test-cases/",
    "reusable": true,
    "historical": true
  },
  "validationStrategy": {
    "approach": "Output-based validation (no LLM needed)",
    "executionMode": "Automated test script execution",
    "logAnalysis": "DevBob pod logs via kubectl",
    "passFailDetermination": "Exact output matching against expected criteria",
    "retryStrategy": "Single attempt per test case",
    "timeoutHandling": "15 second timeout with graceful failure"
  },
  "deployment Requirements": {
    "devbobPod": "Must be running in K8s cluster",
    "kubectlAccess": "Required for log fetching",
    "portForwarding": "localhost:8080 → devbob:8080 (optional)",
    "testScript": "test-acp-tcp-transport.ts must exist"
  }
}
