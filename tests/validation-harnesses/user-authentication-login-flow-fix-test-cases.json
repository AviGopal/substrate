{
  "testCases": [
    {
      "impulseId": "validation-user-authentication-login-flow-fix-case-1",
      "name": "Standard user login flow",
      "input": {
        "email": "demo@metabob.com",
        "password": "demo123",
        "name": "Demo User",
        "orgId": "metabob_org",
        "role": "admin",
        "rpcApiUrl": "http://localhost:8080",
        "dashboardUrl": "http://devbob.metabob.local",
        "namespace": "metabob"
      },
      "expectedOutput": {
        "userCreation": {
          "pass": true,
          "userExists": true,
          "email": "demo@metabob.com"
        },
        "databaseVerification": {
          "pass": true,
          "userFound": true,
          "hasPasswordHash": true,
          "isActive": true
        },
        "loginEndpoint": {
          "pass": true,
          "statusCode": 200,
          "hasToken": true,
          "hasUser": true,
          "hasOrganizations": true
        },
        "jwtValidation": {
          "pass": true,
          "hasRequiredFields": ["user_id", "email", "org_id", "role", "exp"],
          "emailMatches": true,
          "notExpired": true
        },
        "protectedRoute": {
          "pass": true,
          "statusCode": 200,
          "hasActivityData": true
        },
        "playwrightE2E": {
          "pass": true,
          "loginSucceeds": true,
          "redirectsToDashboard": true,
          "activityPageLoads": true,
          "activityTablePresent": true,
          "screenshotCaptured": true
        }
      }
    },
    {
      "impulseId": "validation-user-authentication-login-flow-fix-case-2",
      "name": "Member role user login",
      "input": {
        "email": "member@metabob.com",
        "password": "member123",
        "name": "Member User",
        "orgId": "metabob_org",
        "role": "member",
        "rpcApiUrl": "http://localhost:8080",
        "dashboardUrl": "http://devbob.metabob.local",
        "namespace": "metabob"
      },
      "expectedOutput": {
        "userCreation": {
          "pass": true,
          "role": "member"
        },
        "loginEndpoint": {
          "pass": true,
          "statusCode": 200,
          "userRole": "member"
        },
        "jwtValidation": {
          "pass": true,
          "roleMatches": "member"
        }
      }
    },
    {
      "impulseId": "validation-user-authentication-login-flow-fix-case-3",
      "name": "Invalid password rejection",
      "input": {
        "email": "demo@metabob.com",
        "password": "wrongpassword",
        "name": "Demo User",
        "orgId": "metabob_org",
        "role": "admin",
        "rpcApiUrl": "http://localhost:8080",
        "dashboardUrl": "http://devbob.metabob.local",
        "namespace": "metabob"
      },
      "expectedOutput": {
        "loginEndpoint": {
          "pass": false,
          "statusCode": 401,
          "errorMessage": "Invalid email or password"
        }
      }
    },
    {
      "impulseId": "validation-user-authentication-login-flow-fix-case-4",
      "name": "Non-existent user rejection",
      "input": {
        "email": "nonexistent@metabob.com",
        "password": "anypassword",
        "name": "Nonexistent User",
        "orgId": "metabob_org",
        "role": "member",
        "rpcApiUrl": "http://localhost:8080",
        "dashboardUrl": "http://devbob.metabob.local",
        "namespace": "metabob"
      },
      "expectedOutput": {
        "databaseVerification": {
          "pass": false,
          "userFound": false
        },
        "loginEndpoint": {
          "pass": false,
          "statusCode": 401,
          "errorMessage": "Invalid email or password"
        }
      }
    }
  ]
}
