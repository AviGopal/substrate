{
  "validation-sidebar-impulse-visibility-case-1": {
    "testName": "Basic Impulse Loading",
    "description": "Verify sidebar shows impulse count incrementing from 0/4 to 2/4 (high priority) to 3/4 (high+medium) as impulses load",
    "input": {
      "impulseCount": 4,
      "impulsePriorities": ["high", "high", "medium", "low"],
      "impulseBudgets": [1000, 1000, 1000, 1000],
      "taskCount": 0
    },
    "expectedOutput": {
      "snapshots": [
        {
          "step": "initial",
          "impulses": {"loaded": 0, "total": 4, "utilization": 0},
          "tokens": {"used": 0, "total": 4000},
          "warnings": {"memoryWarning": false}
        },
        {
          "step": "high-priority-loaded",
          "impulses": {"loaded": 2, "total": 4, "utilization": 50},
          "tokens": {"used": 2000, "total": 4000},
          "warnings": {"memoryWarning": false}
        },
        {
          "step": "medium-priority-loaded",
          "impulses": {"loaded": 3, "total": 4, "utilization": 75},
          "tokens": {"used": 3000, "total": 4000},
          "warnings": {"memoryWarning": false}
        }
      ]
    }
  },
  "validation-sidebar-impulse-visibility-case-2": {
    "testName": "Activity Progress Tracking",
    "description": "Verify sidebar activity section shows Task 0/5 -> 1/5 -> 2/5 -> 3/5 -> 4/5 -> 5/5 with progress bar advancing and status changing",
    "input": {
      "impulseCount": 3,
      "impulsePriorities": ["high", "medium", "low"],
      "impulseBudgets": [1000, 1000, 1000],
      "taskCount": 5
    },
    "expectedOutput": {
      "snapshots": [
        {
          "step": "task-0-complete",
          "activities": [{"status": "executing", "progress": {"current": 1, "total": 5, "percentage": 20}}]
        },
        {
          "step": "task-1-complete",
          "activities": [{"status": "executing", "progress": {"current": 2, "total": 5, "percentage": 40}}]
        },
        {
          "step": "task-2-complete",
          "activities": [{"status": "executing", "progress": {"current": 3, "total": 5, "percentage": 60}}]
        },
        {
          "step": "task-3-complete",
          "activities": [{"status": "completing", "progress": {"current": 4, "total": 5, "percentage": 80}}]
        },
        {
          "step": "task-4-complete",
          "activities": [{"status": "done", "progress": {"current": 5, "total": 5, "percentage": 100}}]
        }
      ]
    }
  },
  "validation-sidebar-impulse-visibility-case-3": {
    "testName": "Warning Thresholds (85%)",
    "description": "Verify sidebar shows warning indicator when token utilization exceeds 85% (9000/10000 = 90%)",
    "input": {
      "impulseCount": 4,
      "impulsePriorities": ["high", "high", "high", "low"],
      "impulseBudgets": [3000, 3000, 3000, 1000],
      "taskCount": 0
    },
    "expectedOutput": {
      "snapshots": [
        {
          "step": "initial",
          "impulses": {"loaded": 0, "total": 4, "utilization": 0},
          "warnings": {"memoryWarning": false}
        },
        {
          "step": "high-priority-loaded",
          "impulses": {"loaded": 3, "total": 4, "utilization": 90},
          "tokens": {"used": 9000, "total": 10000},
          "warnings": {"memoryWarning": true}
        }
      ]
    }
  },
  "validation-sidebar-impulse-visibility-case-4": {
    "testName": "Incremental Loading with Activity Progress",
    "description": "Verify sidebar shows both impulse loading (0->2->3) and activity progress (0%->33%->67%->100%) simultaneously",
    "input": {
      "impulseCount": 5,
      "impulsePriorities": ["high", "high", "medium", "low", "low"],
      "impulseBudgets": [1000, 1000, 1000, 1000, 1000],
      "taskCount": 3
    },
    "expectedOutput": {
      "snapshots": [
        {
          "step": "initial",
          "impulses": {"loaded": 0, "total": 5},
          "activities": []
        },
        {
          "step": "high-loaded-task-1",
          "impulses": {"loaded": 2, "total": 5, "utilization": 40},
          "activities": [{"progress": {"current": 1, "total": 3, "percentage": 33}}]
        },
        {
          "step": "medium-loaded-task-2",
          "impulses": {"loaded": 3, "total": 5, "utilization": 60},
          "activities": [{"progress": {"current": 2, "total": 3, "percentage": 67}}]
        },
        {
          "step": "task-3-complete",
          "impulses": {"loaded": 3, "total": 5, "utilization": 60},
          "activities": [{"status": "done", "progress": {"current": 3, "total": 3, "percentage": 100}}]
        }
      ]
    }
  }
}
