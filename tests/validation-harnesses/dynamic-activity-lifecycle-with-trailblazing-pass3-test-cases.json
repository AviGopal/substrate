{
  "testCases": [
    {
      "id": "validation-dynamic-activity-lifecycle-with-trailblazing-pass3-case-1",
      "name": "Local Code Validation (Skip K8s)",
      "input": {
        "skipK8sValidation": true,
        "activityName": "Test Activity for Local Validation",
        "activityDescription": "Validates code fixes without requiring K8s deployment"
      },
      "expectedOutput": {
        "pass": true,
        "actual": {
          "codeTrace": {
            "isMetaTemplateFixApplied": true,
            "createActivityIncluded": true,
            "timeoutFixApplied": true,
            "timeoutValue": 15000
          },
          "unitTest": {
            "isMetaTemplateReturnsTrue": true
          },
          "backendValidation": {
            "mcpEndpointsAvailable": true,
            "surrealdbSchemaValid": true
          },
          "integrationTest": {
            "executed": false,
            "trailblazingAutoEnabled": false,
            "contextInjected": false,
            "templateRegistered": false
          }
        }
      }
    },
    {
      "id": "validation-dynamic-activity-lifecycle-with-trailblazing-pass3-case-2",
      "name": "Full K8s Integration Test",
      "input": {
        "skipK8sValidation": false,
        "activityName": "Test REST API Activity",
        "activityDescription": "Full end-to-end validation in devbob K8s pod"
      },
      "expectedOutput": {
        "pass": true,
        "actual": {
          "codeTrace": {
            "isMetaTemplateFixApplied": true,
            "createActivityIncluded": true,
            "timeoutFixApplied": true,
            "timeoutValue": 15000
          },
          "unitTest": {
            "isMetaTemplateReturnsTrue": true
          },
          "backendValidation": {
            "mcpEndpointsAvailable": true,
            "surrealdbSchemaValid": true
          },
          "integrationTest": {
            "executed": true,
            "trailblazingAutoEnabled": true,
            "contextInjected": true,
            "templateRegistered": true
          }
        }
      }
    },
    {
      "id": "validation-dynamic-activity-lifecycle-with-trailblazing-pass3-case-3",
      "name": "MCP Registration Timeout Test",
      "input": {
        "skipK8sValidation": false,
        "activityName": "Timeout Test Activity",
        "activityDescription": "Validates that MCP registration completes within 15s timeout"
      },
      "expectedOutput": {
        "pass": true,
        "actual": {
          "codeTrace": {
            "timeoutValue": 15000
          },
          "integrationTest": {
            "templateRegistered": true,
            "registrationTime": "<15000ms"
          }
        }
      }
    }
  ]
}
