{
  "testCases": [
    {
      "id": "validation-safe-config-self-modification-case-1",
      "name": "Modify metabob setting with validation",
      "input": {
        "operation": "modify_key",
        "path": "metabob.max_issues",
        "oldValue": 5,
        "newValue": 10,
        "reason": "Test: increase issue limit"
      },
      "expectedOutput": {
        "sandboxValidationRan": true,
        "validationPassed": true,
        "backupCreated": true,
        "changeApplied": true,
        "changeVerified": true,
        "configReloaded": true,
        "backupDeleted": true,
        "transformationTracked": true,
        "finalValue": 10
      }
    },
    {
      "id": "validation-safe-config-self-modification-case-2",
      "name": "Invalid change triggers rollback",
      "input": {
        "operation": "modify_key",
        "path": "metabob.max_issues",
        "oldValue": 5,
        "newValue": "INVALID_STRING",
        "reason": "Test: validation failure"
      },
      "expectedOutput": {
        "sandboxValidationRan": true,
        "validationPassed": false,
        "backupCreated": false,
        "changeApplied": false,
        "changeVerified": false,
        "configReloaded": false,
        "configUnchanged": true,
        "errorThrown": true,
        "errorMessage": "Validation failed"
      }
    },
    {
      "id": "validation-safe-config-self-modification-case-3",
      "name": "Add secret to config",
      "input": {
        "operation": "add_secret",
        "path": "secrets.test_key",
        "newValue": "test_secret_value",
        "reason": "Test: add secret"
      },
      "expectedOutput": {
        "sandboxValidationRan": true,
        "validationPassed": true,
        "backupCreated": true,
        "changeApplied": true,
        "changeVerified": true,
        "configReloaded": true,
        "backupDeleted": true,
        "transformationTracked": true,
        "finalValue": "test_secret_value"
      }
    },
    {
      "id": "validation-safe-config-self-modification-case-4",
      "name": "Install plugin",
      "input": {
        "operation": "install_plugin",
        "newValue": "test-plugin",
        "reason": "Test: install plugin"
      },
      "expectedOutput": {
        "sandboxValidationRan": true,
        "validationPassed": true,
        "backupCreated": true,
        "changeApplied": true,
        "changeVerified": true,
        "impactAnalysis": {
          "blastRadius": "high"
        },
        "configReloaded": false,
        "reloadDeferred": true,
        "transformationTracked": true
      }
    },
    {
      "id": "validation-safe-config-self-modification-case-5",
      "name": "Impact analysis for MCP config change",
      "input": {
        "operation": "modify_key",
        "path": "mcp.metabob.enabled",
        "oldValue": true,
        "newValue": false,
        "reason": "Test: disable MCP server"
      },
      "expectedOutput": {
        "sandboxValidationRan": true,
        "validationPassed": true,
        "impactAnalysis": {
          "mcpServersAffected": ["metabob"],
          "blastRadius": "high",
          "warningsPresent": true
        },
        "backupCreated": true,
        "changeApplied": true,
        "configReloaded": true,
        "transformationTracked": true
      }
    }
  ]
}
