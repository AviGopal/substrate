{
  "testCases": [
    {
      "id": "validation-minibob-self-configuration-case-1-local",
      "name": "Local Environment",
      "input": {
        "environment": "local",
        "minibobEndpoint": "http://localhost:8080"
      },
      "expectedOutput": {
        "health": {
          "status": "ok",
          "vessel": "minibob"
        },
        "config": {
          "baseCapabilities": ["activities", "impulses", "git", "acp"],
          "hasMetadata": true
        },
        "environment": {
          "environment": "local",
          "clusterMode": false,
          "boredomEnabled": false,
          "acpGossipEnabled": false
        }
      }
    },
    {
      "id": "validation-minibob-self-configuration-case-2-docker",
      "name": "Docker Environment",
      "input": {
        "environment": "docker",
        "minibobEndpoint": "http://minibob:8080"
      },
      "expectedOutput": {
        "health": {
          "status": "ok",
          "vessel": "minibob"
        },
        "config": {
          "baseCapabilities": ["activities", "impulses", "git", "acp"],
          "hasMetadata": true
        },
        "environment": {
          "environment": "docker",
          "clusterMode": false,
          "boredomEnabled": false,
          "acpGossipEnabled": false
        }
      }
    },
    {
      "id": "validation-minibob-self-configuration-case-3-k8s-single",
      "name": "K8s Single Pod",
      "input": {
        "environment": "k8s-single",
        "minibobEndpoint": "http://minibob.testing.svc.cluster.local:8080",
        "namespace": "testing",
        "expectedPeerCount": 1,
        "checkStartupLogs": true
      },
      "expectedOutput": {
        "health": {
          "status": "ok",
          "vessel": "minibob"
        },
        "config": {
          "baseCapabilities": ["activities", "impulses", "git", "acp"],
          "hasMetadata": true
        },
        "environment": {
          "environment": "k8s-single",
          "clusterMode": false,
          "peerCount": 1,
          "boredomEnabled": false,
          "acpGossipEnabled": false
        },
        "dns": {
          "minCount": 1
        },
        "logs": {
          "hasEnvironmentDetection": true,
          "hasClusterModeLog": true,
          "hasBoredomLog": true,
          "detectedEnvironment": "k8s-single",
          "detectedClusterMode": false
        }
      }
    },
    {
      "id": "validation-minibob-self-configuration-case-4-k8s-cluster",
      "name": "K8s Cluster (3+ pods)",
      "input": {
        "environment": "k8s-cluster",
        "minibobEndpoint": "http://minibob-cluster.testing.svc.cluster.local:8080",
        "namespace": "testing",
        "expectedPeerCount": 3,
        "checkStartupLogs": true
      },
      "expectedOutput": {
        "health": {
          "status": "ok",
          "vessel": "minibob"
        },
        "config": {
          "baseCapabilities": ["activities", "impulses", "git", "acp"],
          "conditionalCapabilities": ["boredom"],
          "hasMetadata": true
        },
        "environment": {
          "environment": "k8s-cluster",
          "clusterMode": true,
          "peerCount": 3,
          "boredomEnabled": true,
          "acpGossipEnabled": false
        },
        "dns": {
          "minCount": 3,
          "addresses": ["10.x.x.x", "10.x.x.x", "10.x.x.x"]
        },
        "logs": {
          "hasEnvironmentDetection": true,
          "hasClusterModeLog": true,
          "hasBoredomLog": true,
          "detectedEnvironment": "k8s-cluster",
          "detectedClusterMode": true
        }
      }
    }
  ]
}
