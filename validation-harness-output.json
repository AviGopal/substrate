{
  "specificationName": "Activity Template Flow via MCP Backend",
  "harnessFile": "tests/validation-harnesses/activity-template-flow-via-mcp-backend-harness.ts",
  "harnessImpulseId": "harness-activity-template-flow-via-mcp-backend",
  "testCases": [
    {
      "impulseId": "validation-activity-template-flow-via-mcp-backend-case-1",
      "testName": "MCP Connection Status",
      "input": {
        "check": "test_metabob_mcp tool exists and is defined"
      },
      "expectedOutput": {
        "toolExists": true,
        "toolDefined": true
      }
    },
    {
      "impulseId": "validation-activity-template-flow-via-mcp-backend-case-2",
      "testName": "TemplateLoader Source Verification",
      "input": {
        "file": "repos/metabob-opencode/packages/opencode/src/session/template-loader.ts",
        "check": "TemplateLoader returns source=\"metabob\" for backend templates"
      },
      "expectedOutput": {
        "fileExists": true,
        "sourceMetabob": true,
        "usesTemplateServiceClient": true,
        "hasBootstrapFallback": true
      }
    },
    {
      "impulseId": "validation-activity-template-flow-via-mcp-backend-case-3",
      "testName": "No Direct File Access",
      "input": {
        "searchPath": "repos/metabob-opencode/packages/opencode/src",
        "pattern": ".metabob/activities",
        "check": "No active direct file access to .metabob/activities"
      },
      "expectedOutput": {
        "activeReferences": 0,
        "allReferencesCommented": true
      }
    },
    {
      "impulseId": "validation-activity-template-flow-via-mcp-backend-case-4",
      "testName": "MetabobCLI No Local Writes",
      "input": {
        "file": "repos/metabob-opencode/packages/opencode/src/util/metabob.ts",
        "check": "MetabobCLI has no local template writes (lines 803-813 commented)"
      },
      "expectedOutput": {
        "fileExists": true,
        "noLocalWrites": true,
        "hasArchitecturalConstraintComment": true,
        "callsMCPTools": true
      }
    },
    {
      "impulseId": "validation-activity-template-flow-via-mcp-backend-case-5",
      "testName": "Activity Agent Tool Configuration",
      "input": {
        "file": "repos/metabob-opencode/packages/opencode/src/agent/agent.ts",
        "check": "Activity agent has search_activities, no impulse tools"
      },
      "expectedOutput": {
        "hasSearchActivities": true,
        "hasActivity": true,
        "noImpulseCreate": true,
        "noImpulseLoad": true
      }
    },
    {
      "impulseId": "validation-activity-template-flow-via-mcp-backend-case-6",
      "testName": "Memory Agent Tool Configuration",
      "input": {
        "file": "repos/metabob-opencode/packages/opencode/src/agent/agent.ts",
        "check": "Memory agent has impulse tools and activity tools"
      },
      "expectedOutput": {
        "hasActivity": true,
        "hasSearchActivities": true,
        "hasImpulseCreate": true,
        "hasImpulseLoad": true,
        "hasImpulseUnload": true
      }
    },
    {
      "impulseId": "validation-activity-template-flow-via-mcp-backend-case-7",
      "testName": "TemplateServiceClient Delegation",
      "input": {
        "file": "repos/metabob-opencode/packages/opencode/src/server/template-service-client.ts",
        "check": "TemplateServiceClient delegates to MetabobCLI"
      },
      "expectedOutput": {
        "fileExists": true,
        "callsSearchActivities": true,
        "callsGetActivity": true,
        "callsRegisterActivityTemplate": true
      }
    }
  ],
  "summary": {
    "totalTests": 7,
    "harnessType": "static-analysis",
    "requiresLLM": false,
    "canRunOffline": true,
    "estimatedRuntime": "< 10 seconds",
    "validationStrategy": [
      "Call test_metabob_mcp() and verify status='connected'",
      "Load a non-bootstrap template via TemplateLoader.load() and verify source='metabob'",
      "Search codebase for direct .metabob/activities file reads and ensure they're deprecated/removed",
      "Trace a template registration flow from TemplateServiceClient.registerTemplate() through MCP to RPC API",
      "Verify Activity agent tools use search_activities() not file system access",
      "Check that enforcement comments exist preventing local template storage"
    ]
  }
}
