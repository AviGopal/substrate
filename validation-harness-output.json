{
  "specificationName": "Instance-Invariant Storage for Impulses and Activities",
  "harnessFile": "tests/validation-harnesses/instance-invariant-storage-for-impulses-and-activities-harness.ts",
  "testCases": [
    {
      "impulseId": "validation-Instance-Invariant Storage for Impulses and Activities-case-1",
      "input": {
        "impulseId": "test-impulse",
        "projectId": "test-project",
        "impulseData": {
          "id": "test-impulse",
          "type": "memo"
        }
      },
      "expectedOutput": {
        "noDirectImports": true,
        "usesCliTool": true,
        "callStack": ["opencode", "CLI MCP", "rpc-api"]
      },
      "testName": "Vessel Flow Compliance",
      "category": "architectural-compliance"
    },
    {
      "impulseId": "validation-Instance-Invariant Storage for Impulses and Activities-case-2",
      "input": {
        "instanceA": "create impulse with credentials",
        "instanceB": "retrieve impulse with same credentials"
      },
      "expectedOutput": {
        "storeSuccess": true,
        "retrieveSuccess": true,
        "dataIntegrity": true
      },
      "testName": "Cross-Instance Retrieval",
      "category": "cross-instance-access"
    },
    {
      "impulseId": "validation-Instance-Invariant Storage for Impulses and Activities-case-3",
      "input": {
        "apiKeyA": "tenant_a_key",
        "apiKeyB": "tenant_b_key",
        "projectId": "same_project"
      },
      "expectedOutput": {
        "accessDenied": true
      },
      "testName": "Multi-Tenant Isolation",
      "category": "security"
    },
    {
      "impulseId": "validation-Instance-Invariant Storage for Impulses and Activities-case-4",
      "input": {
        "apiKey": "same_key",
        "projectA": "project_alpha",
        "projectB": "project_beta"
      },
      "expectedOutput": {
        "projectIsolated": true
      },
      "testName": "Project Isolation",
      "category": "security"
    },
    {
      "impulseId": "validation-Instance-Invariant Storage for Impulses and Activities-case-5",
      "input": {
        "totalImpulses": 15,
        "page1Limit": 10,
        "page2Offset": 10
      },
      "expectedOutput": {
        "page1Count": 10,
        "page2Count": 5
      },
      "testName": "Pagination",
      "category": "api-functionality"
    },
    {
      "impulseId": "validation-Instance-Invariant Storage for Impulses and Activities-case-6",
      "input": {
        "sourceFiles": [
          "repos/metabob-opencode/packages/opencode/src/tool/impulse-create.ts",
          "repos/metabob-opencode/packages/opencode/src/session/activity.ts"
        ]
      },
      "expectedOutput": {
        "hasImpulseBackendSync": true,
        "hasActivitySaveBackendSync": true,
        "hasActivityLoadBackendFallback": true,
        "hasDirectHTTP": false,
        "hasRequiredImports": true
      },
      "testName": "Backend Sync Enforcement",
      "category": "code-quality"
    }
  ],
  "harnessImpulseId": "harness-Instance-Invariant Storage for Impulses and Activities"
}
