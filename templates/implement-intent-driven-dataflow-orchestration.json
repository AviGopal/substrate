2. **Agent Scoring Algorithm**
   \`\`\`typescript
   function scoreAgent(
     agent: Agent,
     intentClusters: IntentCluster[],
     dataflowPaths: DataPath[],
     intentGraph: IntentGraph
   ): number {
     let score = 0;
     
     // Factor 1: Specialization (50 points)
     if (cluster.specialist === agent.name) score += 50;
     
     // Factor 2: Component ownership (10 points per component)
     score += agentComponents.length * 10;
     
     // Factor 3: Success rate (30 points max)
     score += avgSuccessRate * 30;
     
     return score;
   }
   \`\`\`

3. **Context Selection**
   \`\`\`typescript
   function selectRelevantContext(
     taskIntent: Intent,
