{
  "name": "Context Test V3",
  "description": "Test contextRequirements after REAL fix",
  "category": "infrastructure",
  "contextRequirements": [
    {
      "key": "testMessage",
      "hint": "Provide a test message to include",
      "impulseTypes": ["memo"],
      "required": true,
      "budgetRange": [100, 500]
    }
  ],
  "tasks": [
    {
      "id": "write-test",
      "subagent": "general",
      "description": "Write test file with context",
      "dependencies": [],
      "prompt": {
        "template": "Write a test message to /tmp/context-test-{{testId}}.txt\n\nInclude the message from context: {{testMessage}}\n\nAnd the name: {{name}}",
        "maxTokens": 2000,
        "compressionStrategy": "filter",
        "variables": [
          {
            "name": "testId",
            "type": "string",
            "required": true,
            "description": "Test identifier"
          },
          {
            "name": "name",
            "type": "string",
            "required": true,
            "description": "Name to include"
          }
        ]
      },
      "validation": {
        "requiredFiles": ["/tmp/context-test-{{testId}}.txt"],
        "requiredPatterns": [],
        "forbiddenPatterns": [],
        "commands": []
      },
      "retry": {
        "maxAttempts": 2,
        "strategy": "simple"
      }
    }
  ]
}
