{
  "name": "@metabob/vessel-discovery-client",
  "version": "1.1.0",
  "description": "Shared TypeScript package for standardized vessel registration and discovery",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "import": "./dist/middleware/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "vessel",
    "discovery",
    "registration",
    "microservices",
    "service-registry"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MetabobProject/metabob-devbob.git",
    "directory": "packages/vessel-discovery-client"
  },
  "bugs": {
    "url": "https://github.com/MetabobProject/metabob-devbob/issues"
  },
  "homepage": "https://github.com/MetabobProject/metabob-devbob/tree/main/packages/vessel-discovery-client#readme",
  "author": "Metabob",
  "license": "MIT",
  "peerDependencies": {
    "hono": "^4.0.0",
    "express": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^4.17.21",
    "hono": "^4.0.0",
    "express": "^4.18.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {}
}
