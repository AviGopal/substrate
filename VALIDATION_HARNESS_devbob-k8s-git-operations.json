  "testCases": [
    {
      "impulseId": "validation-devbob-k8s-git-operations-case-1",
      "name": "git-config-present",
      "input": "kubectl exec -n metabob {POD} -- git config --list",
      "expectedOutput": "user.name= and user.email= present, exit code 0"
    },
    {
      "impulseId": "validation-devbob-k8s-git-operations-case-2",
      "name": "gh-cli-installed",
      "input": "kubectl exec -n metabob {POD} -- which gh",
      "expectedOutput": "/usr/bin/gh, exit code 0"
    },
    {
      "impulseId": "validation-devbob-k8s-git-operations-case-3",
      "name": "git-credentials-present",
      "input": "kubectl exec -n metabob {POD} -- env | grep -E '(GIT_USER|GITHUB_TOKEN)'",
      "expectedOutput": "GIT_USER_NAME=, GIT_USER_EMAIL=, GITHUB_TOKEN= present"
    },
    {
      "impulseId": "validation-devbob-k8s-git-operations-case-4",
      "name": "gh-cli-authenticated",
      "input": "kubectl exec -n metabob {POD} -- gh auth status",
      "expectedOutput": "Logged in to github.com, exit code 0"
    },
    {
      "impulseId": "validation-devbob-k8s-git-operations-case-5",
      "name": "workspace-accessible",
      "input": "kubectl exec -n metabob {POD} -- ls -la /workspace",
      "expectedOutput": "/workspace accessible, exit code 0"
    },
    {
      "impulseId": "validation-devbob-k8s-git-operations-case-6",
      "name": "git-clone-success",
      "input": "kubectl exec -n metabob {POD} -- git clone {REPO} /workspace/test-clone-{POD}",
      "expectedOutput": "Clone succeeds without fatal errors, exit code 0",
      "destructive": true
    },
    {
      "impulseId": "validation-devbob-k8s-git-operations-case-7",
      "name": "git-commit-success",
      "input": "kubectl exec -n metabob {POD} -- git commit -m 'test'",
      "expectedOutput": "Commit succeeds with proper attribution, exit code 0",
      "destructive": true
    },
    {
      "impulseId": "validation-devbob-k8s-git-operations-case-8",
      "name": "git-push-success",
      "input": "kubectl exec -n metabob {POD} -- git push",
      "expectedOutput": "Push succeeds without authentication errors, exit code 0",
      "destructive": true
    },
    {
      "impulseId": "validation-devbob-k8s-git-operations-case-9",
      "name": "gh-pr-create",
      "input": "kubectl exec -n metabob {POD} -- gh pr create --title 'Test' --body 'Test'",
      "expectedOutput": "PR created or already exists, contains https://github.com",
      "destructive": true
    }
  ],
