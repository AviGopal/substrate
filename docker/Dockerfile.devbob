# =============================================================================
# Dockerfile for DevBob - Multi-stage build with named targets
# =============================================================================
# Build targets:
#   - metabob-cli-builder: Build metabob-cli and dependencies
#   - opencode-builder: Build opencode standalone binary
#   - runtime (default): Lightweight production image with both binaries
# =============================================================================

# =============================================================================
# Target: metabob-cli-builder - Build metabob-cli
# =============================================================================
FROM python:3.11-slim AS metabob-cli-builder

RUN apt-get update && apt-get install -y \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build/metabob-cli
COPY repos/metabob-cli/ .

# Build metabob-cli with all dependencies in a venv
RUN python3 -m venv /opt/metabob-cli/.venv && \
    /opt/metabob-cli/.venv/bin/pip install --upgrade pip && \
    /opt/metabob-cli/.venv/bin/pip install \
        anthropic \
        mcp \
        httpx \
        pydantic \
        python-dotenv \
        surrealdb \
        redis \
        tabulate \
        fastapi \
        uvicorn \
        click \
        rich \
        aiofiles \
        watchdog \
        tree-sitter \
        tree-sitter-python \
        tree-sitter-javascript

# =============================================================================
# Target: opencode-binary - Copy pre-built OpenCode standalone binary
# =============================================================================
# NOTE: OpenCode binary must be pre-built before Docker build
# Build it with: cd repos/metabob-opencode && bun install && bun run build --single
# This avoids complex workspace resolution in Docker and significantly reduces build time
FROM debian:12-slim AS opencode-binary

# Create directory for binary
RUN mkdir -p /opt/opencode/bin

# Copy pre-built binary from host
# Binary MUST exist before building this image
# Build it with: cd repos/metabob-opencode && bun install && bun run build --single
COPY repos/metabob-opencode/packages/opencode/dist/opencode-linux-x64/bin/opencode /opt/opencode/bin/opencode

# Verify binary exists and is executable
RUN chmod +x /opt/opencode/bin/opencode && \
    /opt/opencode/bin/opencode --version

# =============================================================================
# Target: runtime (default) - Lightweight production image
# =============================================================================
FROM debian:12-slim AS runtime

# Install only minimal runtime dependencies + Bun for plugin installation
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    git \
    python3 \
    unzip \
    && rm -rf /var/lib/apt/lists/* && \
    # Install Bun for pre-installing OpenCode plugins
    curl -fsSL https://bun.sh/install | bash && \
    ln -s /root/.bun/bin/bun /usr/local/bin/bun

# Create workspace
WORKDIR /workspace

# Copy metabob-cli venv from builder
COPY --from=metabob-cli-builder /opt/metabob-cli/.venv /opt/metabob-cli/.venv

# Copy OpenCode standalone binary from pre-built binary stage
# Templates are embedded in the standalone binary, no separate copy needed
COPY --from=opencode-binary /opt/opencode/bin/opencode /usr/local/bin/opencode

# Binary already verified as executable in opencode-binary stage
# but set permissions again for safety
RUN chmod +x /usr/local/bin/opencode

# Add metabob-cli to PATH
ENV PATH="/opt/metabob-cli/.venv/bin:$PATH"

# =============================================================================
# Pre-install OpenCode plugins and their dependencies
# This fixes the "Cannot find module '@openauthjs/openauth/pkce'" error
# by ensuring all plugin dependencies are available at runtime
# 
# Strategy: Use real Bun to install packages to the cache directory where OpenCode expects them
# =============================================================================
RUN mkdir -p /root/.cache/opencode && \
    cd /root/.cache/opencode && \
    # Create a minimal package.json for dependency installation
    echo '{"name":"opencode-cache","version":"1.0.0","dependencies":{"opencode-anthropic-auth":"0.0.2","opencode-copilot-auth":"0.0.5","@openauthjs/openauth":"^0.4.3"}}' > package.json && \
    # Use Bun to install all packages including peer dependencies
    bun install && \
    # Verify critical dependencies are installed
    find /root/.cache/opencode/node_modules/@openauthjs/openauth -name "pkce.js" | grep -q "pkce.js" || \
    (echo "ERROR: @openauthjs/openauth/pkce not found after installation" && exit 1)

# Copy self-configuration entrypoint script
COPY docker/entrypoint-self-config.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Expose ports
EXPOSE 3000 8080 8082

# Set entrypoint (with self-configuration)
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

# Default command: run ACP server
CMD ["acp", "--port", "3000", "--hostname", "0.0.0.0"]

# =============================================================================
# Build Instructions:
#
# Build production image (default target):
#   docker build -f docker/Dockerfile.devbob -t metabobapp/devbob:v1.0.1 .
#
# Build specific target:
#   docker build -f docker/Dockerfile.devbob --target metabob-cli-builder -t metabob-cli:latest .
#   docker build -f docker/Dockerfile.devbob --target opencode-builder -t opencode-builder:latest .
#
# Test the binary:
#   docker run --rm metabobapp/devbob:v1.0.1 --help
#
# Production image contains:
#   - OpenCode standalone binary (NO bun, NO source code)
#   - Metabob CLI venv (NO pip, only runtime packages)
#   - Minimal Debian base (NO build tools)
# =============================================================================
