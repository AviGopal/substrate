# =============================================================================
# Devbob - OpenCode Agent in Container
# =============================================================================
# 
# Multi-stage build for devbob agent containers.
# Each container runs OpenCode with metabob-cli MCP integration.
#
# Build stages:
#   1. devbob-base: Base image with OpenCode + metabob-cli
#   2. devbob-clean: Clean testing environment (no code)
#   3. devbob-dev: Development environment (code mounted)
#
# Usage:
#   # Build base image
#   docker build -t devbob:latest --target devbob-base -f docker/Dockerfile.devbob .
#
#   # Use in docker-compose with profiles
#   docker-compose --profile devbob up
#
# =============================================================================

# =============================================================================
# Stage 1: Base Image
# =============================================================================

FROM node:20-slim AS devbob-base

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    git \
    python3 \
    python3-pip \
    python3-venv \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Create workspace
WORKDIR /workspace

# Copy and install metabob-cli from local repo
COPY repos/metabob-cli /tmp/metabob-cli
RUN python3 -m venv /opt/metabob-cli/.venv && \
    /opt/metabob-cli/.venv/bin/pip install --upgrade pip && \
    /opt/metabob-cli/.venv/bin/pip install /tmp/metabob-cli && \
    rm -rf /tmp/metabob-cli && \
    echo "metabob-cli installed from local repo"

# Copy and build OpenCode from local repo
COPY repos/metabob-opencode /tmp/metabob-opencode
WORKDIR /tmp/metabob-opencode
RUN npm install && \
    npm run build && \
    npm link && \
    cd /workspace && \
    rm -rf /tmp/metabob-opencode && \
    echo "OpenCode installed from local repo"

# Create entrypoint script
COPY docker/devbob-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Expose ports
EXPOSE 3000 8082

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["opencode", "acp", "--port", "3000"]

# =============================================================================
# Stage 2: Clean Testing Environment
# =============================================================================

FROM devbob-base AS devbob-clean

# No additional setup - workspace is empty
# Activities will be executed in a pristine environment

WORKDIR /workspace

# =============================================================================
# Stage 3: Development Environment
# =============================================================================

FROM devbob-base AS devbob-dev

# Install development tools
RUN apt-get update && apt-get install -y \
    vim \
    less \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Workspace will be mounted from host
# Each container gets its own repo (rpc-api, cli, opencode, dashboard)

WORKDIR /workspace
