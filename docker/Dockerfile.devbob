# =============================================================================
# Devbob Multi-Agent Development Environment Base Image
# =============================================================================
# Multi-stage build that creates a development environment with:
# - metabob-cli (Python CLI for code analysis and MCP server)
# - metabob-opencode (Bun-based agent IDE running in ACP mode)
# - Development tools (git, vim, tmux, jq, etc.)
#
# Usage:
#   docker build -f docker/Dockerfile.devbob -t devbob:latest .
#   docker build -f docker/Dockerfile.devbob --target devbob-base -t devbob-base:latest .
#
# =============================================================================

# =============================================================================
# Stage 1: Build metabob-cli (Python)
# =============================================================================
FROM python:3.12-slim AS cli-builder

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast Python package management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /build/metabob-cli

# Copy metabob-cli source
COPY repos/metabob-cli/pyproject.toml repos/metabob-cli/uv.lock ./
COPY repos/metabob-cli/lib/ ./lib/
COPY repos/metabob-cli/src/ ./src/

# Create placeholder files for optional dependencies
RUN echo "DevBob CLI Package" > ./README.md && \
    touch ./LICENSE ./NOTICE

# Install dependencies and build (use regular install, not editable)
RUN uv sync --frozen --no-dev && \
    uv pip install . --no-deps

# =============================================================================
# Stage 2: Copy pre-built metabob-opencode binaries
# =============================================================================
# Instead of building from source (which requires complex workspace setup),
# we copy pre-built binaries from the local dist folder.
FROM alpine:3.19 AS opencode-builder

WORKDIR /build/opencode

# Copy pre-built binaries for all Linux architectures
COPY repos/metabob-opencode/packages/opencode/dist/ ./dist/

# =============================================================================
# Stage 3: Runtime - Devbob Base Image
# =============================================================================
FROM python:3.12-slim AS devbob-base

# Install runtime dependencies and development tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Core tools
    git \
    curl \
    wget \
    ca-certificates \
    openssh-client \
    # Development tools
    vim \
    tmux \
    jq \
    tree \
    htop \
    # Network tools
    netcat-openbsd \
    iputils-ping \
    dnsutils \
    # Process management
    procps \
    # For Bun runtime
    unzip \
    # For envsubst (template substitution)
    gettext-base \
    && rm -rf /var/lib/apt/lists/*

# Install uv for Python package management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Install Bun runtime (needed for opencode)
RUN curl -fsSL https://bun.sh/install | bash \
    && ln -s /root/.bun/bin/bun /usr/local/bin/bun \
    && ln -s /root/.bun/bin/bunx /usr/local/bin/bunx

# Install nvm and Node.js LTS (for npm scripts that need node)
ENV NVM_DIR=/root/.nvm
ENV NODE_VERSION=20
RUN curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.3/install.sh | bash \
    && . "$NVM_DIR/nvm.sh" \
    && nvm install $NODE_VERSION \
    && nvm alias default $NODE_VERSION \
    && nvm use default \
    && ln -sf "$NVM_DIR/versions/node/$(nvm current)/bin/node" /usr/local/bin/node \
    && ln -sf "$NVM_DIR/versions/node/$(nvm current)/bin/npm" /usr/local/bin/npm \
    && ln -sf "$NVM_DIR/versions/node/$(nvm current)/bin/npx" /usr/local/bin/npx

# Add nvm to bashrc for interactive shells
RUN echo 'export NVM_DIR="/root/.nvm"' >> /root/.bashrc \
    && echo '[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"' >> /root/.bashrc \
    && echo '[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"' >> /root/.bashrc

# Create directory structure
RUN mkdir -p \
    /opt/metabob-cli \
    /opt/opencode \
    /workspace \
    /config \
    /auth \
    /root/.ssh

# -----------------------------------------------------------------------------
# Copy metabob-cli from builder
# -----------------------------------------------------------------------------
COPY --from=cli-builder /build/metabob-cli /opt/metabob-cli

# Fix shebangs in the venv scripts to use the correct runtime path
# The venv was built at /build/metabob-cli but is now at /opt/metabob-cli
RUN find /opt/metabob-cli/.venv/bin -type f -exec sed -i 's|#!/build/metabob-cli/.venv|#!/opt/metabob-cli/.venv|g' {} \; 2>/dev/null || true

# Create wrapper script that runs metabob-cli from /opt to avoid .env file issues
# pydantic_settings tries to parse all .env files in CWD which can cause "Too many open files"
RUN echo '#!/bin/bash' > /usr/local/bin/metabob-cli-wrapper && \
    echo '# Run metabob-cli from /opt to avoid .env file parsing issues' >> /usr/local/bin/metabob-cli-wrapper && \
    echo 'cd /opt && exec /opt/metabob-cli/.venv/bin/python -m metabob_cli "$@"' >> /usr/local/bin/metabob-cli-wrapper && \
    chmod +x /usr/local/bin/metabob-cli-wrapper && \
    # Make the wrapper the default metabob-cli
    rm -f /opt/metabob-cli/.venv/bin/metabob-cli && \
    ln -sf /usr/local/bin/metabob-cli-wrapper /opt/metabob-cli/.venv/bin/metabob-cli

# Make metabob-cli venv available in PATH
ENV PATH="/opt/metabob-cli/.venv/bin:${PATH}"

# -----------------------------------------------------------------------------
# Copy opencode from builder
# -----------------------------------------------------------------------------
COPY --from=opencode-builder /build/opencode/dist /opt/opencode/dist

# Determine architecture and symlink correct binary
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then \
        OPENCODE_BIN="opencode-linux-x64"; \
    elif [ "$ARCH" = "aarch64" ]; then \
        OPENCODE_BIN="opencode-linux-arm64"; \
    else \
        echo "Unsupported architecture: $ARCH" && exit 1; \
    fi && \
    ln -sf /opt/opencode/dist/${OPENCODE_BIN}/bin/opencode /usr/local/bin/opencode && \
    chmod +x /opt/opencode/dist/${OPENCODE_BIN}/bin/opencode

# -----------------------------------------------------------------------------
# Environment Configuration
# -----------------------------------------------------------------------------
ENV OPENCODE_HOME=/workspace/.opencode
ENV METABOB_CONFIG_DIR=/config
ENV PYTHONUNBUFFERED=1

# Default ACP port (overridden per container)
ENV ACP_PORT=3000
ENV ACP_HOSTNAME=0.0.0.0

# Metabob backend configuration (set via docker-compose)
ENV METABOB_API_URL=http://api-server-dev:8080
ENV METABOB_PROJECT_ID=devbob-default
ENV METABOB_SYNC_ACTIVITIES=true

# LLM Provider configuration (set via .env)
ENV ANTHROPIC_API_KEY=""
ENV OPENAI_API_KEY=""

# -----------------------------------------------------------------------------
# Copy entrypoint and configuration
# -----------------------------------------------------------------------------
COPY configs/devbob-entrypoint.sh /usr/local/bin/devbob-entrypoint.sh
COPY configs/zombie-reaper.sh /usr/local/bin/zombie-reaper.sh
COPY configs/devbob-config.json /config/opencode.json.template

RUN chmod +x /usr/local/bin/devbob-entrypoint.sh /usr/local/bin/zombie-reaper.sh

# -----------------------------------------------------------------------------
# SSH configuration for git operations
# -----------------------------------------------------------------------------
# Copy SSH keys from local .ssh directory (if provided)
# These will be overridden by docker-compose volume mount for security
RUN mkdir -p /root/.ssh && \
    chmod 700 /root/.ssh && \
    touch /root/.ssh/known_hosts && \
    chmod 600 /root/.ssh/known_hosts

# Add common git hosts to known_hosts
RUN ssh-keyscan github.com >> /root/.ssh/known_hosts 2>/dev/null || true && \
    ssh-keyscan gitlab.com >> /root/.ssh/known_hosts 2>/dev/null || true && \
    ssh-keyscan bitbucket.org >> /root/.ssh/known_hosts 2>/dev/null || true

# Configure git for SSH
RUN git config --global core.sshCommand "ssh -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/root/.ssh/known_hosts"

# -----------------------------------------------------------------------------
# Health check
# -----------------------------------------------------------------------------
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${ACP_PORT}/health 2>/dev/null || \
        (opencode --version > /dev/null 2>&1 && metabob-cli --version > /dev/null 2>&1)

# Working directory
WORKDIR /workspace

# Expose ACP port
EXPOSE ${ACP_PORT}

# Default command - wrapped with zombie reaper to prevent process accumulation
ENTRYPOINT ["/usr/local/bin/zombie-reaper.sh", "/usr/local/bin/devbob-entrypoint.sh"]
CMD ["acp"]

# =============================================================================
# Stage 4: Development variant with additional tools
# =============================================================================
FROM devbob-base AS devbob-dev

# Install additional development dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Python development
    python3-dev \
    # Node.js for dashboard development
    nodejs \
    npm \
    # Additional tools
    ripgrep \
    fd-find \
    bat \
    && rm -rf /var/lib/apt/lists/*

# Install global npm packages for development
RUN npm install -g typescript ts-node

# Create alias for fd (installed as fdfind on Debian)
RUN ln -sf /usr/bin/fdfind /usr/local/bin/fd 2>/dev/null || true

# Development-specific environment
ENV NODE_ENV=development
ENV DEVBOB_MODE=development

