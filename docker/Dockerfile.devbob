# =============================================================================
# Dockerfile for DevBob - Multi-stage build with named targets
# =============================================================================
# Build targets:
#   - metabob-cli-builder: Build metabob-cli and dependencies
#   - opencode-builder: Build opencode standalone binary
#   - runtime (default): Lightweight production image with both binaries
# =============================================================================

# =============================================================================
# Target: metabob-cli-builder - Build metabob-cli
# =============================================================================
FROM python:3.11-slim AS metabob-cli-builder

RUN apt-get update && apt-get install -y \
    git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build/metabob-cli
COPY repos/metabob-cli .

# Build metabob-cli with all dependencies in a venv
RUN python3 -m venv /opt/metabob-cli/.venv && \
    /opt/metabob-cli/.venv/bin/pip install --upgrade pip && \
    /opt/metabob-cli/.venv/bin/pip install \
        anthropic \
        mcp \
        httpx \
        pydantic \
        python-dotenv \
        surrealdb \
        redis \
        tabulate \
        fastapi \
        uvicorn \
        click \
        rich \
        aiofiles \
        watchdog \
        tree-sitter \
        tree-sitter-python \
        tree-sitter-javascript

# =============================================================================
# Target: opencode-builder - Build OpenCode standalone binary
# =============================================================================
FROM oven/bun:1.1.45-debian AS opencode-builder

RUN apt-get update && apt-get install -y \
    git \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy entire workspace (needed for bun workspace catalog resolution)
COPY repos/metabob-proto ./repos/metabob-proto
COPY repos/metabob-opencode ./repos/metabob-opencode

# Build standalone binary
WORKDIR /build/repos/metabob-opencode

# Copy workspace root package.json with catalog definitions
COPY repos/metabob-opencode/package.json ./package.json
COPY repos/metabob-opencode/bunfig.toml ./bunfig.toml

RUN bun install && \
    cd packages/opencode && \
    bun run build --single && \
    echo "OpenCode binary built:" && \
    ls -lh dist/opencode-linux-x64/bin/opencode

# =============================================================================
# Target: runtime (default) - Lightweight production image
# =============================================================================
FROM debian:12-slim AS runtime

# Install only minimal runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    git \
    python3 \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Create workspace
WORKDIR /workspace

# Copy metabob-cli venv from builder
COPY --from=metabob-cli-builder /opt/metabob-cli/.venv /opt/metabob-cli/.venv

# Copy OpenCode standalone binary from builder
COPY --from=opencode-builder /build/repos/metabob-opencode/packages/opencode/dist/opencode-linux-x64/bin/opencode /usr/local/bin/opencode
COPY --from=opencode-builder /build/repos/metabob-opencode/packages/opencode/dist/opencode-linux-x64/templates /opt/opencode/templates

# Make opencode binary executable
RUN chmod +x /usr/local/bin/opencode

# Add metabob-cli to PATH
ENV PATH="/opt/metabob-cli/.venv/bin:$PATH"

# Create entrypoint script
RUN echo '#!/bin/bash' > /usr/local/bin/entrypoint.sh && \
    echo 'cd /workspace' >> /usr/local/bin/entrypoint.sh && \
    echo 'exec opencode "$@"' >> /usr/local/bin/entrypoint.sh && \
    chmod +x /usr/local/bin/entrypoint.sh

# Expose ports
EXPOSE 3000 8080 8082

# Set entrypoint
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]

# Default command: run server
CMD ["serve", "--hostname", "0.0.0.0", "--port", "8080"]

# =============================================================================
# Build Instructions:
#
# Build production image (default target):
#   docker build -f docker/Dockerfile.devbob -t metabobapp/devbob:v1.0.1 .
#
# Build specific target:
#   docker build -f docker/Dockerfile.devbob --target metabob-cli-builder -t metabob-cli:latest .
#   docker build -f docker/Dockerfile.devbob --target opencode-builder -t opencode-builder:latest .
#
# Test the binary:
#   docker run --rm metabobapp/devbob:v1.0.1 --help
#
# Production image contains:
#   - OpenCode standalone binary (NO bun, NO source code)
#   - Metabob CLI venv (NO pip, only runtime packages)
#   - Minimal Debian base (NO build tools)
# =============================================================================
