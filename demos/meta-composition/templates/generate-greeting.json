{
  "id": "generate-greeting",
  "name": "Generate Greeting",
  "description": "Simple activity that generates a greeting",
  "category": "tool",
  "tasks": [
    {
      "id": "greet",
      "subagent": "general",
      "description": "Generate greeting message",
      "dependencies": [],
      "prompt": {
        "template": "Generate a friendly greeting for {{name}}. Keep it to one sentence.",
        "maxTokens": 256,
        "compressionStrategy": "filter",
        "variables": [
          {
            "name": "name",
            "type": "string",
            "required": true,
            "description": "Name to greet"
          }
        ]
      },
      "validation": {
        "requiredFiles": [],
        "requiredPatterns": [],
        "forbiddenPatterns": [],
        "commands": []
      },
      "retry": {
        "maxAttempts": 2,
        "strategy": "simple"
      }
    }
  ],
  "contextRequirements": [],
  "integration": {
    "requiresCleanGit": false,
    "preChecks": [],
    "postChecks": [],
    "qualityGates": []
  }
}
