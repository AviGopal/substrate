# Self-Contained Vessel Monitor
# Docker container that can be deployed anywhere to monitor vessel network

FROM oven/bun:1.3.11-alpine

WORKDIR /app

# Copy package files
COPY package.json ./
COPY bun.lockb ./

# Install dependencies
RUN bun install --frozen-lockfile

# Copy application files
COPY multi-vessel-dashboard.tsx ./
COPY learning-dashboard.tsx ./
COPY learning-dashboard-live.tsx ./

# Environment variables with defaults
ENV DISCOVERY_VESSEL_ENDPOINT=http://discovery-vessel.activity-system.svc.cluster.local:8080
ENV ACTIVITY_API_URL=https://activity.metabob.com
ENV NODE_ENV=production

# Healthcheck
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD bun --version || exit 1

# Run the multi-vessel dashboard
CMD ["bun", "run", "multi-vessel-dashboard.tsx"]
