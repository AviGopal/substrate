{
  "id": "run-lint",
  "name": "Run ESLint",
  "description": "Purely deterministic linting. No LLM - just runs eslint and validates.",
  "category": "infrastructure",
  "tags": ["deterministic", "linting", "validation"],
  "mode": "deterministic",

  "variables": [
    {
      "name": "paths",
      "type": "string",
      "required": false,
      "default": "src/ tests/",
      "description": "Paths to lint"
    },
    {
      "name": "fix",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Auto-fix lint issues"
    }
  ],

  "tasks": [
    {
      "id": "lint",
      "description": "Run ESLint on source files",
      "type": "command",
      "command": {
        "run": "eslint {{paths}} {{#if fix}}--fix{{/if}}",
        "captureOutput": true,
        "timeout": 60000
      },
      "validation": {
        "exitCode": 0
      },
      "outputCapture": {
        "stdout": "lintOutput",
        "exitCode": "lintExitCode"
      }
    }
  ],

  "outputSchema": {
    "produces": [
      { "shape": "lint_passes", "condition": "exitCode === 0" },
      { "shape": "lint_errors", "condition": "exitCode !== 0" }
    ]
  },

  "tracing": {
    "recordTrace": true,
    "contributeToLearning": true,
    "metadata": {
      "integrationPoint": "ci/lint",
      "deterministic": true
    }
  }
}
