{
  "id": "run-typecheck",
  "name": "Run TypeScript Type Check",
  "description": "Purely deterministic type checking. No LLM - just runs tsc and validates.",
  "category": "infrastructure",
  "tags": ["deterministic", "typescript", "validation"],
  "mode": "deterministic",

  "tasks": [
    {
      "id": "typecheck",
      "description": "Run TypeScript compiler in check mode",
      "type": "command",
      "command": {
        "run": "tsc --noEmit",
        "captureOutput": true,
        "timeout": 120000
      },
      "validation": {
        "exitCode": 0
      },
      "outputCapture": {
        "stderr": "typecheckErrors",
        "exitCode": "typecheckExitCode"
      }
    }
  ],

  "outputSchema": {
    "produces": [
      { "shape": "typescript_compiles", "condition": "exitCode === 0" },
      { "shape": "typescript_errors", "condition": "exitCode !== 0" }
    ]
  },

  "tracing": {
    "recordTrace": true,
    "contributeToLearning": true,
    "metadata": {
      "integrationPoint": "ci/typecheck",
      "deterministic": true
    }
  }
}
