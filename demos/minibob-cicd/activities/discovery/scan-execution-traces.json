{
  "id": "scan-execution-traces",
  "name": "Scan Execution Traces for Similar Past Fixes",
  "description": "Query backend for similar successful executions. Produces execution_trace impulses. Thompson Sampling learns when historical patterns help.",
  "category": "discovery",
  "tags": ["loop-3", "discovery", "backend", "learning"],
  "mode": "deterministic",

  "variables": [
    {
      "name": "goalCategory",
      "type": "string",
      "required": false,
      "description": "Category of goal (bugfix, feature, refactor)",
      "default": "bugfix"
    },
    {
      "name": "goalKeywords",
      "type": "array",
      "required": false,
      "description": "Keywords extracted from goal description",
      "default": ["test", "failure"]
    },
    {
      "name": "limit",
      "type": "number",
      "required": false,
      "description": "Maximum number of traces to retrieve",
      "default": 3
    }
  ],

  "tasks": [
    {
      "id": "query-backend",
      "description": "Query backend for similar successful executions",
      "type": "mcp",
      "mcp": {
        "method": "GET",
        "endpoint": "/v2/activities/execution-traces",
        "params": {
          "category": "{{goalCategory}}",
          "tags": "{{goalKeywords | join}}",
          "outcome": "success",
          "limit": "{{limit}}",
          "sortBy": "relevance_score"
        }
      },
      "outputShapes": ["execution_trace_list"],
      "validation": {
        "statusCode": 200
      }
    },
    {
      "id": "extract-metadata",
      "description": "Extract trace metadata without loading full traces",
      "type": "transform",
      "transform": {
        "input": ["query-backend"],
        "operation": "extractTraceMetadata",
        "config": {
          "includeFields": [
            "execution_id",
            "template_id",
            "duration",
            "success_rate",
            "tools_used",
            "files_modified",
            "error_type_fixed"
          ],
          "excludeFields": ["full_trace", "tool_outputs", "llm_responses"]
        }
      },
      "outputShapes": ["trace_metadata_list"]
    },
    {
      "id": "create-impulses",
      "description": "Convert traces into impulse metadata (NOT loaded)",
      "type": "transform",
      "transform": {
        "input": ["extract-metadata"],
        "operation": "createImpulseMetadata",
        "config": {
          "shapes": {
            "trace": "execution_trace",
            "pattern": "fix_pattern"
          },
          "extractSummary": true,
          "loadContent": false
        }
      },
      "outputShapes": ["impulse_metadata_batch"]
    }
  ],

  "outputSchema": {
    "produces": [
      {
        "shape": "impulse_metadata_batch",
        "description": "Execution trace impulses with metadata",
        "structure": {
          "impulses": [
            {
              "id": "trace-exec-123",
              "pointer": {
                "type": "activityExecutionTrace",
                "executionId": "exec-123",
                "activityId": "fix-test-failure"
              },
              "metadata": {
                "shape": "execution_trace",
                "summary": "Fixed test failure in calculator.add (2 hours ago)",
                "duration": 35000,
                "successRate": 0.85,
                "toolsUsed": ["read", "edit", "bash"],
                "filesModified": ["src/calculator.ts"],
                "errorTypeFixed": "test_assertion_mismatch",
                "discoveredBy": "scan-execution-traces"
              },
              "loaded": false,
              "budget": 2000,
              "priority": "medium"
            }
          ],
          "totalDiscovered": 3,
          "byErrorType": {
            "test_assertion_mismatch": 2,
            "test_missing_mock": 1
          }
        }
      }
    ]
  },

  "tracing": {
    "recordTrace": true,
    "contributeToLearning": true,
    "metadata": {
      "learningCategory": "trace-discovery-effectiveness",
      "loopType": "loop-3-discovery"
    }
  },

  "learning": {
    "onSuccess": {
      "action": "recordMetrics",
      "metrics": {
        "tracesFound": "{{create-impulses.output.totalDiscovered}}",
        "avgSuccessRate": "{{extract-metadata.output | avgField:'success_rate'}}",
        "executionTime": "{{duration}}"
      }
    },
    "thompsonSampling": {
      "track": "per-error-type",
      "condition": "tracesFound > 0",
      "note": "Learn which error types benefit from historical pattern matching"
    }
  },

  "metadata": {
    "demonstratesLoop": 3,
    "learningMechanism": "Thompson Sampling learns that execution traces are VERY useful for repeated error patterns (α high, β low)",
    "costProfile": "low",
    "expectedRelevance": "0.80-0.90 (high, when history exists)",
    "integration": "Requires backend connection to activity.metabob.com"
  }
}
