{
  "id": "scan-git-history",
  "name": "Scan Git History for Recent Changes",
  "description": "Discover recent commits and changed files. Produces commit impulses with metadata. Thompson Sampling learns when git history is relevant.",
  "category": "discovery",
  "tags": ["loop-3", "discovery", "git", "deterministic"],
  "mode": "deterministic",

  "variables": [
    {
      "name": "commitCount",
      "type": "number",
      "required": false,
      "description": "Number of recent commits to examine",
      "default": 5
    },
    {
      "name": "sinceHours",
      "type": "number",
      "required": false,
      "description": "Only show commits from last N hours",
      "default": 24
    }
  ],

  "tasks": [
    {
      "id": "get-recent-commits",
      "description": "Get recent commit metadata",
      "type": "command",
      "command": {
        "run": "git log -n {{commitCount}} --since='{{sinceHours}} hours ago' --pretty=format:'%H|%an|%ar|%s' --name-only",
        "captureOutput": true,
        "timeout": 5000
      },
      "outputShapes": ["commit_history"],
      "validation": {
        "exitCode": 0
      }
    },
    {
      "id": "get-changed-files",
      "description": "Get files changed in recent commits",
      "type": "command",
      "command": {
        "run": "git diff --name-only HEAD~{{commitCount}}..HEAD",
        "captureOutput": true,
        "timeout": 5000
      },
      "outputShapes": ["changed_file_list"]
    },
    {
      "id": "get-diff-stats",
      "description": "Get diff statistics for changed files",
      "type": "command",
      "command": {
        "run": "git diff --stat HEAD~{{commitCount}}..HEAD",
        "captureOutput": true,
        "timeout": 5000
      },
      "outputShapes": ["diff_stats"]
    },
    {
      "id": "create-impulses",
      "description": "Convert git data into impulse metadata",
      "type": "transform",
      "transform": {
        "input": ["get-recent-commits", "get-changed-files", "get-diff-stats"],
        "operation": "createImpulseMetadata",
        "config": {
          "shapes": {
            "commit": "git_commit",
            "changedFile": "source_code",
            "diffStat": "diff_summary"
          },
          "extractSummary": true,
          "loadContent": false
        }
      },
      "outputShapes": ["impulse_metadata_batch"]
    }
  ],

  "outputSchema": {
    "produces": [
      {
        "shape": "impulse_metadata_batch",
        "description": "Git history impulses with metadata",
        "structure": {
          "impulses": [
            {
              "id": "commit-abc123",
              "pointer": { "type": "git", "commit": "abc123", "path": "src/calculator.ts" },
              "metadata": {
                "shape": "git_commit",
                "summary": "fix: calculator add function",
                "author": "developer",
                "timeAgo": "2 hours ago",
                "linesChanged": 15,
                "discoveredBy": "scan-git-history"
              },
              "loaded": false
            }
          ],
          "totalDiscovered": 8,
          "byShape": {
            "git_commit": 3,
            "source_code": 5
          }
        }
      }
    ]
  },

  "tracing": {
    "recordTrace": true,
    "contributeToLearning": true,
    "metadata": {
      "learningCategory": "git-history-relevance",
      "loopType": "loop-3-discovery"
    }
  },

  "learning": {
    "onSuccess": {
      "action": "recordMetrics",
      "metrics": {
        "commitsFound": "{{create-impulses.output.totalDiscovered}}",
        "filesChanged": "{{get-changed-files.output | lineCount}}",
        "executionTime": "{{duration}}"
      }
    },
    "thompsonSampling": {
      "track": "per-goal-category",
      "condition": "commitsFound > 0",
      "note": "Learn when git history is actually useful vs noise"
    }
  },

  "metadata": {
    "demonstratesLoop": 3,
    "learningMechanism": "Thompson Sampling learns that git history is rarely useful for test failures, but very useful for regressions",
    "costProfile": "low",
    "expectedRelevance": "0.2-0.4 (low, often discovered but unused)"
  }
}
