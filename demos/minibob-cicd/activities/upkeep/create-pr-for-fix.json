{
  "id": "create-pr-for-fix",
  "name": "Create PR for Auto-Fix",
  "description": "Create a pull request with auto-remediation changes for human review.",
  "category": "infrastructure",
  "tags": ["upkeep", "pull-request", "github", "llm-assisted"],
  "mode": "upkeep",

  "variables": [
    {
      "name": "fixDescription",
      "type": "string",
      "required": true,
      "description": "Description of what was fixed"
    },
    {
      "name": "failedStep",
      "type": "string",
      "required": true,
      "description": "Which CI step was fixed"
    }
  ],

  "tasks": [
    {
      "id": "check-changes",
      "description": "Verify there are changes to commit",
      "type": "command",
      "command": {
        "run": "git diff --stat",
        "captureOutput": true
      },
      "outputCapture": {
        "stdout": "diffStat"
      },
      "validation": {
        "customCheck": "{{diffStat.length}} > 0"
      }
    },
    {
      "id": "create-branch",
      "description": "Create a fix branch",
      "dependencies": ["check-changes"],
      "type": "command",
      "command": {
        "run": "git checkout -b fix/minibob-auto-$(date +%Y%m%d-%H%M%S)"
      }
    },
    {
      "id": "commit-changes",
      "description": "Commit the fixes",
      "dependencies": ["create-branch"],
      "type": "command",
      "command": {
        "run": "git add -A && git commit -m 'fix({{failedStep}}): minibob auto-remediation\n\n{{fixDescription}}\n\nCo-Authored-By: MiniBob <minibob@metabob.com>'"
      }
    },
    {
      "id": "push-branch",
      "description": "Push the branch",
      "dependencies": ["commit-changes"],
      "type": "command",
      "command": {
        "run": "git push -u origin HEAD"
      }
    },
    {
      "id": "generate-pr-body",
      "description": "Generate PR description",
      "dependencies": ["push-branch"],
      "prompt": {
        "template": "Generate a pull request description for these auto-fixes:\n\n**Fixed Step:** {{failedStep}}\n**Changes:**\n```\n{{diffStat}}\n```\n**Fix Description:** {{fixDescription}}\n\nWrite a PR description that:\n1. Summarizes what was fixed\n2. Lists the changes made\n3. Notes this is auto-generated and should be reviewed\n4. Includes testing instructions",
        "maxTokens": 2000
      },
      "outputCapture": {
        "content": "prBody"
      }
    },
    {
      "id": "create-pr",
      "description": "Create the pull request",
      "dependencies": ["generate-pr-body"],
      "type": "command",
      "command": {
        "run": "gh pr create --title 'fix({{failedStep}}): MiniBob auto-remediation' --body '{{prBody}}' --label 'auto-remediation'"
      }
    }
  ],

  "outputSchema": {
    "produces": [
      { "shape": "pr_created", "description": "Pull request was created" }
    ]
  },

  "tracing": {
    "recordTrace": true,
    "contributeToLearning": true,
    "metadata": {
      "integrationPoint": "github/pull-requests",
      "reviewRequired": true
    }
  }
}
