{
  "id": "create-pr-from-branch",
  "name": "Create Pull Request from Branch",
  "description": "Analyzes commits, generates PR description, creates PR with issue links",
  "category": "github-management",
  "tags": ["github", "pull-requests", "automation"],
  "mode": "learning",

  "variables": [
    {
      "name": "branch",
      "type": "string",
      "required": false,
      "description": "Branch name (defaults to current branch)"
    },
    {
      "name": "baseBranch",
      "type": "string",
      "required": false,
      "description": "Base branch for PR",
      "default": "main"
    }
  ],

  "tasks": [
    {
      "id": "get-current-branch",
      "description": "Get current branch name if not provided",
      "condition": "!branch",
      "type": "command",
      "command": {
        "run": "git branch --show-current",
        "captureOutput": true
      }
    },
    {
      "id": "get-commits",
      "description": "Get commits in this branch",
      "type": "command",
      "command": {
        "run": "git log {{baseBranch}}..HEAD --pretty=format:'%H|%s|%b' --no-merges",
        "captureOutput": true
      },
      "outputShapes": ["commit_list"]
    },
    {
      "id": "get-diff-stats",
      "description": "Get diff statistics",
      "type": "command",
      "command": {
        "run": "git diff {{baseBranch}}...HEAD --stat",
        "captureOutput": true
      },
      "outputShapes": ["diff_stats"]
    },
    {
      "id": "analyze-changes",
      "description": "Analyze commits and changes to generate PR description",
      "dependencies": ["get-commits", "get-diff-stats"],
      "prompt": {
        "template": "Analyze these commits and changes to create a PR description:\n\nCommits:\n```\n{{get-commits.output}}\n```\n\nDiff Stats:\n```\n{{get-diff-stats.output}}\n```\n\nCreate a PR description with:\n1. Summary (1-2 sentences)\n2. Changes (bullet points)\n3. Testing done\n4. Issue references (if any in commit messages)\n5. Screenshots (if UI changes)\n\nFormat as markdown.",
        "maxTokens": 6000
      },
      "outputShapes": ["pr_description"]
    },
    {
      "id": "create-pr",
      "description": "Create PR using gh CLI",
      "dependencies": ["analyze-changes"],
      "type": "command",
      "command": {
        "run": "gh pr create --base {{baseBranch}} --head {{branch}} --title \"$(echo '$TITLE')\" --body \"$(cat <<'EOF'\n$BODY\n\n---\n\n🤖 Generated by MiniBob Activity: create-pr-from-branch\nEOF\n)\"",
        "env": {
          "TITLE": "{{analyze-changes.output | extractField:'title'}}",
          "BODY": "{{analyze-changes.output | extractField:'description'}}"
        },
        "captureOutput": true,
        "timeout": 30000
      },
      "validation": {
        "exitCode": 0,
        "requiredPatterns": ["github.com/.*/pull/\\d+"]
      },
      "outputShapes": ["github_pr"]
    },
    {
      "id": "add-labels",
      "description": "Add relevant labels to PR",
      "dependencies": ["create-pr"],
      "type": "command",
      "command": {
        "run": "PR_NUM=$(echo '{{create-pr.output}}' | grep -oP 'pull/\\K\\d+') && LABELS=$(echo '{{analyze-changes.output}}' | jq -r '.labels // [] | join(\",\")') && [ -n \"$LABELS\" ] && gh pr edit $PR_NUM --add-label \"$LABELS\" || true",
        "captureOutput": true
      }
    }
  ],

  "outputSchema": {
    "produces": [
      {
        "shape": "github_pr",
        "description": "Created PR with URL and number"
      },
      {
        "shape": "pr_description",
        "description": "Generated PR description"
      }
    ]
  },

  "tracing": {
    "recordTrace": true,
    "contributeToLearning": true,
    "metadata": {
      "integrationPoint": "github/pr-management",
      "learningCategory": "pr-description-generation"
    }
  },

  "learning": {
    "onSuccess": {
      "action": "extractPattern",
      "data": {
        "commitCount": "{{get-commits.output | lineCount}}",
        "filesChanged": "{{get-diff-stats.output | extractFileCount}}",
        "descriptionQuality": "measured-by-review-comments"
      }
    }
  },

  "metadata": {
    "demonstratesActivityDriven": true,
    "requiresGitHubCLI": true,
    "requiresGitRepo": true
  }
}
