{
  "name": "Example Feature Template",
  "description": "Example template showing all schema features for adding a new feature with tests and documentation",
  "category": "feature",
  "tasks": [
    {
      "id": "analyze-requirements",
      "subagent": "general",
      "description": "Analyze feature requirements and design approach",
      "dependencies": [],
      "prompt": {
        "template": "Analyze the requirements for {{featureName}}.\n\nFeature Description:\n{{featureDescription}}\n\nProvide:\n1. Technical approach\n2. Files to modify/create\n3. Potential challenges\n4. Implementation steps\n\nOutput as structured markdown.",
        "maxTokens": 8000,
        "compressionStrategy": "filter",
        "variables": [
          {
            "name": "featureName",
            "type": "string",
            "required": true,
            "description": "Name of the feature to implement"
          },
          {
            "name": "featureDescription",
            "type": "string",
            "required": true,
            "description": "Detailed description of what the feature should do"
          }
        ]
      },
      "validation": {
        "requiredFiles": [],
        "requiredPatterns": [
          "## Technical Approach",
          "## Files",
          "## Implementation Steps"
        ],
        "forbiddenPatterns": ["TODO", "TBD"],
        "commands": []
      },
      "retry": {
        "max_attempts": 2,
        "strategy": "simple"
      }
    },
    {
      "id": "implement-feature",
      "subagent": "general",
      "description": "Implement the core feature functionality",
      "dependencies": ["analyze-requirements"],
      "prompt": {
        "template": "Implement {{featureName}} based on the analysis.\n\nImplementation Requirements:\n- Follow existing code patterns\n- Add appropriate error handling\n- Include JSDoc comments\n- Use TypeScript types\n\nCreate or modify files as needed.",
        "maxTokens": 12000,
        "compressionStrategy": "filter",
        "variables": []
      },
      "validation": {
        "requiredFiles": ["*.ts", "*.js"],
        "requiredPatterns": [],
        "forbiddenPatterns": ["console.log", "any"],
        "commands": [
          {
            "name": "typecheck",
            "command": "npm run typecheck",
            "required": true
          }
        ]
      },
      "retry": {
        "max_attempts": 3,
        "strategy": "progressive-context"
      }
    },
    {
      "id": "write-tests",
      "subagent": "test",
      "description": "Write comprehensive tests for the feature",
      "dependencies": ["implement-feature"],
      "prompt": {
        "template": "Write comprehensive tests for {{featureName}}.\n\nTest Coverage Requirements:\n- Happy path scenarios\n- Error cases\n- Edge cases\n- Integration tests if applicable\n\nUse the existing test framework patterns.",
        "maxTokens": 10000,
        "compressionStrategy": "filter",
        "variables": []
      },
      "validation": {
        "requiredFiles": ["*.test.ts", "*.test.js"],
        "requiredPatterns": ["describe(", "it(", "expect("],
        "forbiddenPatterns": ["it.skip", "describe.skip"],
        "commands": [
          {
            "name": "run-tests",
            "command": "npm test",
            "required": true
          }
        ]
      },
      "retry": {
        "max_attempts": 3,
        "strategy": "progressive-context"
      }
    },
    {
      "id": "document-feature",
      "subagent": "docs",
      "description": "Document the feature with usage examples",
      "dependencies": ["implement-feature"],
      "prompt": {
        "template": "Document {{featureName}}.\n\nDocumentation should include:\n- Overview of what the feature does\n- Usage examples\n- API reference\n- Configuration options\n\nUpdate relevant markdown files.",
        "maxTokens": 8000,
        "compressionStrategy": "filter",
        "variables": []
      },
      "validation": {
        "requiredFiles": ["*.md"],
        "requiredPatterns": ["## Usage", "## Examples"],
        "forbiddenPatterns": ["TODO", "[WIP]"],
        "commands": []
      },
      "retry": {
        "max_attempts": 2,
        "strategy": "simple"
      }
    }
  ],
  "integration": {
    "preChecks": [
      "git status"
    ],
    "postChecks": [
      "npm run typecheck",
      "npm test"
    ],
    "qualityGates": [
      {
        "name": "no-compilation-errors",
        "command": "npm run typecheck",
        "required": true
      },
      {
        "name": "tests-pass",
        "command": "npm test",
        "required": true
      }
    ]
  },
  "metabob": {
    "enabled": true,
    "learningMode": true,
    "targetContextTokens": 5000,
    "annotationStrategy": "key-components"
  },
  "composition": {
    "standalone": true,
    "examples": [
      {
        "name": "Add User Authentication Feature",
        "description": "Complete workflow for adding authentication feature with tests and docs",
        "sequence": [
          {
            "template": "example-feature-template",
            "variables": {
              "featureName": "User Authentication",
              "featureDescription": "Add JWT-based authentication with login, logout, and token refresh"
            },
            "reason": "Implement authentication feature with full test coverage"
          }
        ],
        "outcome": "Authentication feature implemented with tests and documentation"
      }
    ]
  },
  "learning": {
    "enabled": true,
    "captureStrategy": "detailed",
    "feedbackPoints": [
      {
        "taskId": "implement-feature",
        "metrics": {
          "files_created": "Number of new files created (number)",
          "files_modified": "Number of existing files modified (number)",
          "lines_added": "Total lines of code added (number)"
        },
        "improvementHints": {
          "code_quality": "Was the implementation clean and maintainable? (string)",
          "pattern_adherence": "Did it follow existing code patterns? (string)"
        }
      },
      {
        "taskId": "write-tests",
        "metrics": {
          "test_count": "Number of test cases written (number)",
          "coverage_estimate": "Estimated test coverage percentage (number)"
        },
        "improvementHints": {
          "edge_cases": "Were edge cases adequately covered? (string)"
        }
      }
    ]
  },
  "hooks": {
    "preActivity": {
      "environment": {
        "FEATURE_TEMPLATE": "true"
      }
    },
    "postActivity": {
      "cleanup": true,
      "createSummary": true
    },
    "onError": {
      "captureEnvironment": true,
      "captureLogs": {
        "tail": 50
      },
      "createDiagnosticImpulse": true,
      "cleanup": false
    }
  }
}
