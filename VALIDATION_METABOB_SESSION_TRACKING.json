      "status": "pending"
    },
    {
      "criterion": "metabob_record_session_complete called on session close",
      "testCase": "case-2",
      "status": "pending"
    },
    {
      "criterion": "Complete payload includes sessionId, timestamp, summary, outcome",
      "testCase": "case-2",
      "status": "pending"
    },
    {
      "criterion": "Agent type defaults to 'general' without activityId",
      "testCase": "case-3",
      "status": "pending"
    },
    {
      "criterion": "Agent type uses activityId when provided",
      "testCase": "case-4",
      "status": "pending"
    },
    {
      "criterion": "Session creation succeeds despite tracking failure",
      "testCase": "case-5",
