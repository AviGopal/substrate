      "testName": "Templates Endpoint",
      "input": {
        "endpoint": "/v2/activities/templates?limit=5",
        "method": "GET",
        "backend": "http://metabob-rpc-api.metabob.svc.cluster.local:8080"
      },
      "expectedOutput": {
        "templateCount": "3-10",
        "responseFormat": "JSON with templates array",
        "cacheFallback": "working"
      },
      "actualOutput": {
        "templateCount": 5,
        "status": "PASS"
      }
    },
    {
      "impulseId": "validation-mcp-activity-flow-existing-validation-case-2",
      "testName": "Recommend Endpoint - Count",
      "input": {
        "endpoint": "/v2/activities/recommend",
        "method": "POST",
        "params": {
          "task_description": "Add REST endpoint",
          "limit": 3
        }
      },
      "expectedOutput": {
        "recommendationCount": 3,
        "responseFormat": "JSON with recommendations array"
      },
      "actualOutput": {
        "recommendationCount": 3,
        "status": "PASS"
      }
    },
    {
      "impulseId": "validation-mcp-activity-flow-existing-validation-case-3",
      "testName": "Recommend Endpoint - Thompson Sampling Metadata",
      "input": {
        "endpoint": "/v2/activities/recommend",
        "method": "POST",
        "params": {
          "task_description": "Add REST endpoint",
          "limit": 3
        },
        "focus": "selection_metadata of first recommendation"
      },
      "expectedOutput": {
        "alpha": "numeric value present",
        "beta": "numeric value present",
        "sample": "numeric value present",
        "method": "thompson_sampling"
      },
      "actualOutput": {
        "alpha": "yes",
        "beta": "yes",
        "sample": "yes",
        "status": "PASS"
      }
    },
    {
      "impulseId": "validation-mcp-activity-flow-existing-validation-case-4",
      "testName": "Backend Activity Logs",
      "input": {
        "command": "kubectl logs",
        "namespace": "metabob",
        "podSelector": "app=metabob-rpc-api",
        "tail": 50,
        "filter": "POST.*activities"
      },
      "expectedOutput": {
        "logCount": ">0",
        "pattern": "POST requests to /activities endpoints"
      },
      "actualOutput": {
        "logCount": 2,
        "status": "PASS"
      }
    }
