#=============================================================================
# Main
#=============================================================================

main() {
    if [ $# -eq 0 ]; then
        cmd_help
        exit 0
    fi
    
    local command="$1"
    shift
    
    case "$command" in
        start)
            cmd_start "$@"
            ;;
        stop)
            cmd_stop "$@"
            ;;
        status|ps)
            cmd_status "$@"
            ;;
        backend)
            cmd_backend "$@"
            ;;
        agent)
            cmd_agent "$@"
            ;;
        debug)
            cmd_debug "$@"
            ;;
        help|--help|-h)
            cmd_help
            ;;
        *)
            log_error "Unknown command: $command"
            echo ""
            cmd_help
            exit 1
            ;;
    esac
}

main "$@"
