#!/bin/bash
# =============================================================================
# DevBob CLI - Simplified wrapper for debuggable distributed development
# =============================================================================
# Architecture: Shared backend + on-demand agent containers
# All services use host networking for maximum debuggability
# =============================================================================

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_FILE="$SCRIPT_DIR/docker-compose.yaml"
ENV_FILE="$SCRIPT_DIR/configs/.env.devbob"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

log_info() { echo -e "${BLUE}[INFO]${NC} $1"; }
log_success() { echo -e "${GREEN}[✓]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[!]${NC} $1"; }
log_error() { echo -e "${RED}[✗]${NC} $1"; }
log_header() { echo -e "${CYAN}$1${NC}"; }

# Check if env file exists
check_env() {
    if [ ! -f "$ENV_FILE" ]; then
        log_error "Configuration not found: $ENV_FILE"
        echo ""
        echo "Copy the example file and configure:"
        echo "  cp configs/.env.devbob.example configs/.env.devbob"
        echo "  \${EDITOR:-nano} configs/.env.devbob"
        exit 1
    fi
}

#=============================================================================
# Backend Management
#=============================================================================

cmd_backend() {
    local action="${1:-start}"
    check_env
    
    case "$action" in
        start|up)
            log_header "╔═══════════════════════════════════════════════════════════╗"
            log_header "║          Starting Shared Backend Services                 ║"
            log_header "╚═══════════════════════════════════════════════════════════╝"
            echo ""
            
            log_info "Starting: redis, surreal, metabob-rpc-api"
            docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" --profile backend up -d
            
            echo ""
            log_info "Waiting for services to become healthy..."
            sleep 5
            
            # Test backend health
            if curl -sf http://localhost:8080/health >/dev/null 2>&1; then
                log_success "Backend is healthy!"
            else
                log_warn "Backend may still be starting up..."
            fi
            
            echo ""
            log_header "Backend Endpoints:"
            echo "  • Metabob API:  http://localhost:8080"
            echo "  • API Docs:     http://localhost:8080/docs"
            echo "  • SurrealDB:    http://localhost:8000"
            echo "  • Redis:        redis://localhost:6379"
            echo ""
            echo "All agents and host connect to: http://localhost:8080"
            ;;
        
        stop|down)
            log_info "Stopping backend services..."
            docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" --profile backend down
            log_success "Backend stopped"
            ;;
        
        restart)
            cmd_backend stop
            sleep 2
            cmd_backend start
            ;;
        
        status|ps)
            docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" --profile backend ps
            ;;
        
        logs)
            docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" --profile backend logs -f
            ;;
        
        *)
            log_error "Unknown action: $action"
            echo "Usage: ./devbob backend [start|stop|restart|status|logs]"
            exit 1
            ;;
    esac
}

#=============================================================================
# Agent Management (Individual Containers)
#=============================================================================

cmd_agent() {
    local action="${1:-help}"
    shift || true
    
    case "$action" in
        start)
            local agent="${1:-help}"
            if [ "$agent" = "help" ] || [ -z "$agent" ]; then
                echo "Usage: ./devbob agent start <agent-name>"
                echo ""
                echo "Available agents:"
                echo "  devbob-opencode    - OpenCode development (repos/metabob-opencode)"
                echo "  devbob-rpc-api     - RPC API development (repos/metabob-rpc-api)"
                echo "  devbob-cli         - CLI development (repos/metabob-cli)"
                echo "  devbob-dashboard   - Dashboard development (repos/metabob-dashboard)"
                echo "  devbob-orchestrator - Project orchestration (metabob-devbob)"
                echo "  all                - All agents"
                exit 0
            fi
            
            check_env
            
            if [ "$agent" = "all" ]; then
                log_info "Starting all agents..."
                docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" --profile all-agents up -d
            else
                log_info "Starting $agent..."
                docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" --profile "$agent" up -d
            fi
            
            echo ""
            log_success "Agent started: $agent"
            echo ""
            
            # Show agent-specific info
            case "$agent" in
                devbob-opencode)
                    echo "  ACP:  http://localhost:3004"
                    echo "  Logs: docker logs -f devbob-opencode"
                    echo "  Shell: docker exec -it devbob-opencode bash"
                    ;;
                devbob-rpc-api)
                    echo "  ACP:  http://localhost:3001"
                    echo "  Logs: docker logs -f devbob-rpc-api"
                    ;;
                devbob-cli)
                    echo "  ACP:  http://localhost:3003"
                    echo "  Logs: docker logs -f devbob-cli"
                    ;;
                devbob-dashboard)
                    echo "  ACP:  http://localhost:3002"
                    echo "  Logs: docker logs -f devbob-dashboard"
                    ;;
                devbob-orchestrator)
                    echo "  ACP:  http://localhost:3005"
                    echo "  Logs: docker logs -f devbob-orchestrator"
                    ;;
            esac
            ;;
        
        stop)
            local agent="${1:-all}"
            check_env
            
            if [ "$agent" = "all" ]; then
                log_info "Stopping all agents..."
                docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" --profile all-agents down
            else
                log_info "Stopping $agent..."
                docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" stop "$agent"
            fi
            
            log_success "Agent stopped: $agent"
            ;;
        
        restart)
            local agent="${1:-help}"
            cmd_agent stop "$agent"
            sleep 2
            cmd_agent start "$agent"
            ;;
        
        status|ps)
            docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" ps
            ;;
        
        logs)
            local agent="${1:-}"
            if [ -z "$agent" ]; then
                docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" logs -f
            else
                docker logs -f "$agent"
            fi
            ;;
        
        shell)
            local agent="${1:-devbob-opencode}"
            log_info "Opening shell in $agent..."
            docker exec -it "$agent" /bin/bash
            ;;
        
        list)
            echo ""
            log_header "Available Agents:"
            echo ""
            echo "  devbob-opencode     → repos/metabob-opencode  (ACP: 3004)"
            echo "  devbob-rpc-api      → repos/metabob-rpc-api   (ACP: 3001)"
            echo "  devbob-cli          → repos/metabob-cli       (ACP: 3003)"
            echo "  devbob-dashboard    → repos/metabob-dashboard (ACP: 3002)"
            echo "  devbob-orchestrator → metabob-devbob          (ACP: 3005)"
            echo ""
            ;;
        
        help|*)
            cat << 'AGENT_HELP'
Agent Management:

  ./devbob agent start <name>   - Start specific agent container
  ./devbob agent stop <name>    - Stop specific agent container
  ./devbob agent restart <name> - Restart specific agent
  ./devbob agent status         - Show all agent status
  ./devbob agent logs [name]    - Follow agent logs (all or specific)
  ./devbob agent shell <name>   - Open shell in agent container
  ./devbob agent list           - List available agents

Available Agents:
  devbob-opencode               - OpenCode development agent
  devbob-rpc-api                - RPC API development agent
  devbob-cli                    - CLI development agent
  devbob-dashboard              - Dashboard development agent
  devbob-orchestrator           - Project orchestration agent
  all                           - All agents

Examples:
  ./devbob agent start devbob-opencode
  ./devbob agent logs devbob-opencode
  ./devbob agent shell devbob-opencode
  ./devbob agent start all

AGENT_HELP
            ;;
    esac
}

#=============================================================================
# Debugging Commands
#=============================================================================

cmd_debug() {
    local action="${1:-help}"
    shift || true
    
    case "$action" in
        logs)
            local container="${1:-}"
            if [ -z "$container" ]; then
                echo "Usage: ./devbob debug logs <container>"
                echo ""
                echo "Examples:"
                echo "  ./devbob debug logs devbob-opencode"
                echo "  ./devbob debug logs metabob-rpc-api"
                exit 0
            fi
            
            log_info "Streaming logs from $container..."
            docker logs -f --timestamps "$container"
            ;;
        
        session)
            local agent="${1:-devbob-opencode}"
            log_info "Querying sessions for $agent..."
            curl -s "http://localhost:8080/sessions?agent=$agent" | jq '.' || {
                log_error "Failed to query sessions (backend may not be running)"
                exit 1
            }
            ;;
        
        components)
            log_info "Querying component tracking data..."
            curl -s "http://localhost:8080/components?project=devbob-distributed" | jq '.' || {
                log_error "Failed to query components (backend may not be running)"
                exit 1
            }
            ;;
        
        impulses)
            local agent="${1:-devbob-opencode}"
            log_info "Inspecting impulses for $agent..."
            docker exec "$agent" cat /workspace/repos/metabob-opencode/.opencode/impulses.json 2>/dev/null | jq '.' || {
                log_error "Failed to read impulses (agent may not be running)"
                exit 1
            }
            ;;
        
        shell)
            local container="${1:-devbob-opencode}"
            log_info "Opening debug shell in $container..."
            docker exec -it "$container" /bin/bash
            ;;
        
        inspect)
            local container="${1:-}"
            if [ -z "$container" ]; then
                echo "Usage: ./devbob debug inspect <container>"
                exit 0
            fi
            
            log_info "Inspecting $container..."
            docker inspect "$container" | jq '.[0] | {
                State: .State,
                NetworkSettings: .NetworkSettings,
                Mounts: .Mounts | map({Source, Destination, Mode})
            }'
            ;;
        
        health)
            echo ""
            log_header "System Health Check"
            echo ""
            
            # Backend
            echo "Backend Services:"
            if curl -sf http://localhost:8080/health >/dev/null 2>&1; then
                log_success "Metabob API: http://localhost:8080 ✓"
            else
                log_error "Metabob API: http://localhost:8080 ✗"
            fi
            
            if curl -sf http://localhost:8000/health >/dev/null 2>&1; then
                log_success "SurrealDB: http://localhost:8000 ✓"
            else
                log_error "SurrealDB: http://localhost:8000 ✗"
            fi
            
            if redis-cli ping >/dev/null 2>&1; then
                log_success "Redis: localhost:6379 ✓"
            else
                log_error "Redis: localhost:6379 ✗"
            fi
            
            echo ""
            echo "Agent Containers:"
            for agent in devbob-opencode devbob-rpc-api devbob-cli devbob-dashboard devbob-orchestrator; do
                if docker ps --format '{{.Names}}' | grep -q "^${agent}$"; then
                    log_success "$agent: Running ✓"
                else
                    log_info "$agent: Not running"
                fi
            done
            
            echo ""
            ;;
        
        help|*)
            cat << 'DEBUG_HELP'
Debugging Tools:

  ./devbob debug logs <container>     - Stream container logs with timestamps
  ./devbob debug session [agent]      - Query agent sessions from backend
  ./devbob debug components           - Query component tracking data
  ./devbob debug impulses [agent]     - Inspect impulse system state
  ./devbob debug shell <container>    - Open interactive shell
  ./devbob debug inspect <container>  - Inspect container configuration
  ./devbob debug health               - Check system health

Examples:
  # Watch agent logs in real-time
  ./devbob debug logs devbob-opencode

  # Check what sessions exist
  ./devbob debug session devbob-opencode

  # Inspect Metabob component tracking
  ./devbob debug components

  # See what impulses were created
  ./devbob debug impulses devbob-opencode

  # Check overall system health
  ./devbob debug health

DEBUG_HELP
            ;;
    esac
}

#=============================================================================
# Quick Start Commands
#=============================================================================

cmd_start() {
    check_env
    
    log_header "╔═══════════════════════════════════════════════════════════╗"
    log_header "║      Starting Distributed Development Environment         ║"
    log_header "╚═══════════════════════════════════════════════════════════╝"
    echo ""
    
    # Start backend first
    log_info "Step 1/2: Starting shared backend..."
    docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" --profile backend up -d
    
    echo ""
    log_info "Waiting for backend to become healthy..."
    sleep 5
    
    if ! curl -sf http://localhost:8080/health >/dev/null 2>&1; then
        log_warn "Backend may still be initializing..."
    fi
    
    # Start default agent (devbob-opencode)
    echo ""
    log_info "Step 2/2: Starting devbob-opencode agent..."
    docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" --profile devbob-opencode up -d
    
    sleep 2
    
    echo ""
    log_success "Environment started!"
    echo ""
    cmd_status
    
    echo ""
    log_header "Quick Commands:"
    echo "  Logs:  ./devbob debug logs devbob-opencode"
    echo "  Shell: ./devbob agent shell devbob-opencode"
    echo "  More:  ./devbob agent start <agent-name>"
}

cmd_stop() {
    log_info "Stopping all services..."
    docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" down
    log_success "All services stopped"
}

cmd_status() {
    check_env
    
    echo ""
    log_header "Service Status:"
    echo ""
    docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" ps
}

