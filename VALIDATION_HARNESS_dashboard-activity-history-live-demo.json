{
  "specificationName": "Dashboard Activity History Live Demo",
  "harnessFile": "tests/validation-harnesses/dashboard-activity-history-live-demo-harness.ts",
  "description": "End-to-end validation of Dashboard Activity History data flow: OpenCode CLI → SurrealDB → RPC API (Redis cache) → Dashboard UI",
  "testCases": [
    {
      "impulseId": "validation-dashboard-activity-history-live-demo-case-1",
      "name": "Infrastructure Readiness",
      "description": "Validates k8s cluster, pods, services, and devbob configuration",
      "input": {
        "kubectlContext": "docker-desktop",
        "namespace": "metabob",
        "requiredPods": ["surrealdb", "redis", "metabob-rpc-api", "metabob-dashboard", "devbob"],
        "requiredServices": ["surrealdb", "redis", "metabob-rpc-api", "metabob-dashboard", "devbob"]
      },
      "expectedOutput": {
        "kubectlContext": "docker-desktop",
        "namespace": "namespace/metabob",
        "allPodsRunning": true,
        "allServicesExist": true,
        "devbobRpcUrl": "METABOB_RPC_API_URL=http://metabob-rpc-api:8080"
      }
    },
    {
      "impulseId": "validation-dashboard-activity-history-live-demo-case-2",
      "name": "Dashboard Accessibility",
      "description": "Validates DNS, ingress, and HTTP connectivity to dashboard",
      "input": {
        "ingressHost": "app.metabob.local",
        "hostsFile": "/etc/hosts",
        "url": "http://app.metabob.local"
      },
      "expectedOutput": {
        "ingressHost": "app.metabob.local",
        "hostsFileEntry": true,
        "httpStatusCode": [200, 302]
      }
    },
    {
      "impulseId": "validation-dashboard-activity-history-live-demo-case-3",
      "name": "Activity Execution",
      "description": "Executes test activity in devbob and verifies completion + dashboard sync",
      "input": {
        "command": "kubectl exec deployment/devbob -n metabob -- opencode activity --template test-activity",
        "timeout": 120000
      },
      "expectedOutput": {
        "activityCompleted": true,
        "activityIdGenerated": true,
        "dashboardSyncSuccessful": true,
        "logIndicators": ["completed", "act_", "activity execution recorded to dashboard"]
      }
    },
    {
      "impulseId": "validation-dashboard-activity-history-live-demo-case-4",
      "name": "SurrealDB Record Persistence",
      "description": "Queries SurrealDB to verify activity execution record with correct schema",
      "input": {
        "query": "SELECT * FROM activity_executions ORDER BY started_at DESC LIMIT 1;",
        "namespace": "metabob",
        "database": "devbob"
      },
      "expectedOutput": {
        "recordExists": true,
        "requiredFields": [
          "activity_id",
          "template_id",
          "success",
          "cost_usd",
          "duration_ms",
          "tokens_input",
          "tokens_output",
          "tokens_cache"
        ]
      }
    },
    {
      "impulseId": "validation-dashboard-activity-history-live-demo-case-5",
      "name": "Cache-Aside Pattern Validation",
      "description": "Makes two API requests and verifies Redis cache-aside pattern (miss → hit)",
      "input": {
        "firstRequestUrl": "http://app.metabob.local/auth/orgs/test-org/activity?limit=10",
        "secondRequestUrl": "http://app.metabob.local/auth/orgs/test-org/activity?limit=10",
        "logCheckDelay": 2000
      },
      "expectedOutput": {
        "firstRequestCacheMiss": true,
        "secondRequestCacheHit": true,
        "responseValid": true,
        "activitiesReturned": true,
        "logPatterns": ["Cache MISS", "Cache HIT"]
      }
    }
  ],
  "harnessImpulseId": "harness-dashboard-activity-history-live-demo",
  "executionCommand": "npx tsx tests/validation-harnesses/dashboard-activity-history-live-demo-harness.ts",
  "prerequisites": [
    "kubectl configured with docker-desktop context",
    "Kubernetes cluster running with metabob namespace",
    "All services deployed (surrealdb, redis, rpc-api, dashboard, devbob)",
    "/etc/hosts configured with app.metabob.local entry",
    "SurrealDB schema migration applied",
    "OpenCode CLI with dashboard sync code deployed to devbob"
  ],
  "validationStrategy": {
    "approach": "Infrastructure + Backend Validation",
    "tools": ["kubectl", "curl", "surreal sql"],
    "focus": [
      "Kubernetes infrastructure validation",
      "Activity execution and logging",
      "Database persistence verification",
      "API caching behavior validation"
    ],
    "futureEnhancements": [
      "Add Playwright browser automation for UI validation",
      "Screenshot capture at each step",
      "Visual regression testing",
      "Performance metrics collection"
    ]
  },
  "successCriteria": {
    "allTestsPassing": true,
    "infrastructureReady": true,
    "activityExecutedSuccessfully": true,
    "surrealdbRecordCreated": true,
    "cacheAsidePatternVerified": true
  }
}
