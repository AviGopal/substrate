{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "model": "anthropic/claude-sonnet-4-5",
  "__comment": "Host machine OpenCode configuration - generated by ./devbob config init",
  
  "metabob": {
    "enabled": true,
    "cli_path": "metabob-cli",
    "base_url": "METABOB_API_URL_PLACEHOLDER",
    "api_key": "METABOB_API_KEY_PLACEHOLDER",
    "project_id": "exp-repo-dev",
    "auto_inject": true,
    "headless": true,
    "max_issues": 5,
    "min_severity": "MEDIUM",
    "use_impulse_system": true
  },
  
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "ANTHROPIC_API_KEY_PLACEHOLDER"
      }
    },
    "openai": {
      "options": {
        "apiKey": "OPENAI_API_KEY_PLACEHOLDER"
      }
    }
  },
  
  "sessionMemory": {
    "enabled": true,
    "budgets": {
      "perImpulse": 2000,
      "total": 10000
    },
    "maxImpulsesPerTurn": 5,
    "memoryManagement": {
      "maxCacheTokens": 10000,
      "maxHistoryMessages": 100,
      "autoCompact": true,
      "compactThreshold": 2048,
      "activityStateCleanup": true
    }
  },
  
  "mcp": {
    "metabob": {
      "type": "local",
      "command": [
        "metabob-cli",
        "mcp",
        "--transport",
        "stdio"
      ],
      "environment": {
        "METABOB_API_URL": "${METABOB_API_URL:-http://localhost:8080}",
        "METABOB_API_KEY": "${METABOB_API_KEY:-}"
      },
      "enabled": true
    },
    "playwright": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ]
    }
  }
}
