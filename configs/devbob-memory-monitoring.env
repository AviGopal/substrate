# DevBob Memory Monitoring Configuration
# Enable memory monitoring for early leak detection

# Enable memory monitoring
MEMORY_MONITOR_ENABLED=true

# Memory thresholds (percentage growth from baseline)
MEMORY_WARNING_THRESHOLD=50      # Trigger warning at 50% growth
MEMORY_CRITICAL_THRESHOLD=100    # Trigger critical alert at 100% growth  
MEMORY_FORCE_GC_THRESHOLD=75     # Force garbage collection at 75% growth

# Monitoring intervals
MEMORY_CHECK_INTERVAL=60000      # Check every 60 seconds (60000ms)
MEMORY_ALERT_COOLDOWN=300000     # 5 minutes between alerts (300000ms)

# History and analysis
MEMORY_HISTORY_SIZE=100          # Keep 100 data points for trend analysis

# Node.js memory configuration
NODE_OPTIONS="--expose-gc --max-old-space-size=4096"  # 4GB heap limit with GC access

# Logging configuration
LOG_LEVEL=info                   # Include memory monitor logs

# Additional DevBob configuration for memory monitoring
DEVBOB_MEMORY_MONITORING=true
DEVBOB_MEMORY_ALERTS=true
DEVBOB_PERFORMANCE_MONITORING=true