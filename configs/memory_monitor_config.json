{
    "host_memory_threshold": 0.85,
    "container_memory_threshold": 0.90,
    "check_interval": 60,
    "notification_emails": [],
    "slack_webhook_url": null,
    "mitigation_actions": {
        "high_memory": [
            "stop_lowest_priority_containers"
        ],
        "critical_memory": [
            "stop_all_non_essential_containers"
        ]
    },
    "container_priority": {
        "high": ["devbob-rpc-api", "devbob-cli"],
        "medium": ["devbob-opencode"],
        "low": ["devbob-dashboard"]
    }
}