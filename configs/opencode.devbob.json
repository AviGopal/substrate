{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "model": "anthropic/claude-sonnet-4-5",
  
  "metabob": {
    "base_url": "http://api-server-dev:8080",
    "api_key": "",
    "cli_path": "metabob-cli",
    "enable_cli_mcp": true,
    "max_issues": 5,
    "min_severity": "MEDIUM",
    "template_auto_registration": {
      "behavior": "best-effort",
      "strategy": "on-create"
    },
    "activity_learning": {
      "recommendation_threshold": 0.7,
      "min_executions_for_learning": 1
    }
  },
  
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "${ANTHROPIC_API_KEY}"
      }
    },
    "openai": {
      "options": {
        "apiKey": "${OPENAI_API_KEY:-}"
      }
    }
  },
  
  "sessionMemory": {
    "enabled": true,
    "budgets": {
      "perImpulse": 2000,
      "total": 10000
    },
    "maxImpulsesPerTurn": 5,
    "memoryManagement": {
      "maxCacheTokens": 10000,
      "maxHistoryMessages": 100,
      "autoCompact": true,
      "compactThreshold": 2048,
      "activityStateCleanup": true
    }
  },
  
  "mcp": {
    "playwright": {
      "enabled": false,
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ]
    }
  }
}
