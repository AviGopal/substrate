{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "metabob": {
    "enabled": "${METABOB_ENABLED:-true}",
    "cli_path": "metabob-cli",
    "base_url": "${METABOB_API_URL:-}",
    "api_key": "${METABOB_API_KEY:-}",
    "auto_inject": "${METABOB_AUTO_INJECT:-true}",
    "headless": true,
    "max_issues": 10,
    "min_severity": "LOW",
    "inject_annotations": true,
    "auto_impact_analysis": true,
    "template_auto_registration": {
      "enabled": true,
      "behavior": "best-effort",
      "strategy": "auto"
    },
    "activity_learning": {
      "enabled": true,
      "record_outcomes": true,
      "track_decisions": true,
      "track_impulses": true,
      "auto_recommend": true
    },
    "impulse_mapping": {
      "enabled": true,
      "auto_track": true,
      "track_usage": true,
      "suggest_reuse": true
    },
    "development_metrics": {
      "enabled": true,
      "track_performance": true,
      "record_patterns": true,
      "measure_quality": true,
      "cross_repo_learning": true,
      "execution_tracing": true
    }
  },
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "${ANTHROPIC_API_KEY}"
      }
    },
    "openai": {
      "options": {
        "apiKey": "${OPENAI_API_KEY}"
      }
    }
  },
  "sessionMemory": {
    "enabled": true,
    "budgets": {
      "perImpulse": 2000,
      "total": 10000
    },
    "maxImpulsesPerTurn": 5,
    "memoryManagement": {
      "maxCacheTokens": 10000,
      "maxHistoryMessages": 100,
      "autoCompact": true,
      "compactThreshold": 2048,
      "activityStateCleanup": true
    }
  }
}
