{
  "name": "Test Agent Compliance Enforcement",
  "description": "Phase 5 end-to-end test: Intentionally violates compliance rules to verify automatic corrections work",
  "category": "testing",
  "contextRequirements": [],
  "tasks": [
    {
      "id": "violate-annotation-requirement",
      "subagent": "general",
      "description": "Change files without calling annotation tool (tests Phase 1 & 4)",
      "dependencies": [],
      "prompt": {
        "template": "Create a simple test file at /tmp/test-compliance-file.txt with some content. DO NOT call metabob_annotate_component. Just create the file and stop.",
        "maxTokens": 4000,
        "compressionStrategy": "none",
        "variables": []
      },
      "validation": {
        "requiredFiles": ["/tmp/test-compliance-file.txt"],
        "requiredPatterns": [],
        "forbiddenPatterns": [],
        "requiredToolCalls": [],
        "commands": []
      },
      "retry": {
        "maxAttempts": 1,
        "strategy": "simple"
      },
      "metrics": {
        "successRate": 0,
        "avgTokens": 0,
        "avgDuration": 0,
        "commonFailures": []
      }
    },
    {
      "id": "violate-markdown-requirement",
      "subagent": "general",
      "description": "Create non-allowed markdown file (tests Phase 2 & 4)",
      "dependencies": ["violate-annotation-requirement"],
      "prompt": {
        "template": "Create a markdown file at /tmp/test-docs.md with some documentation content. This is intentionally violating compliance rules.",
        "maxTokens": 4000,
        "compressionStrategy": "none",
        "variables": []
      },
      "validation": {
        "requiredFiles": ["/tmp/test-docs.md"],
        "requiredPatterns": [],
        "forbiddenPatterns": [],
        "requiredToolCalls": [],
        "commands": []
      },
      "retry": {
        "maxAttempts": 1,
        "strategy": "simple"
      },
      "metrics": {
        "successRate": 0,
        "avgTokens": 0,
        "avgDuration": 0,
        "commonFailures": []
      }
    },
    {
      "id": "verify-compliance-enforcement",
      "subagent": "general",
      "description": "Verify that compliance violations were detected",
      "dependencies": ["violate-markdown-requirement"],
      "prompt": {
        "template": "Read the activity logs and verify that:\n1. Annotation warnings were issued\n2. Markdown file warnings were issued\n3. Correctness verdict reflects low compliance\n\nOutput a JSON summary of findings.",
        "maxTokens": 4000,
        "compressionStrategy": "none",
        "variables": []
      },
      "validation": {
        "requiredPatterns": ["\"phase1\"", "\"phase2\"", "\"phase4\""],
        "forbiddenPatterns": [],
        "requiredToolCalls": [],
        "commands": []
      },
      "retry": {
        "maxAttempts": 1,
        "strategy": "simple"
      },
      "metrics": {
        "successRate": 0,
        "avgTokens": 0,
        "avgDuration": 0,
        "commonFailures": []
      }
    }
  ],
  "integration": {
    "preChecks": [],
    "postChecks": [],
    "qualityGates": []
  },
  "metabob": {
    "enabled": false,
    "learningMode": false,
    "targetContextTokens": 0,
    "annotationStrategy": "all"
  }
}
