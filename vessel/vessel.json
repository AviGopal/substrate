{
  "name": "vessel-example",
  "version": "0.1.0",
  "description": "Minimal vessel implementation following minibob pattern",
  "vessel": {
    "type": "autonomous_agent",
    "capabilities": [
      "activity_execution",
      "acp_communication", 
      "impulse_memory",
      "code_modification"
    ],
    "runtime": {
      "entry_point": "src/main.py",
      "python_version": "3.8+",
      "dependencies": [
        "asyncio",
        "json",
        "websockets",
        "aiofiles"
      ]
    }
  },
  "config": {
    "activity_system": {
      "template_dir": "data/activities",
      "execution_timeout": 300,
      "max_concurrent": 5
    },
    "acp_gossip": {
      "port": 8080,
      "discovery_interval": 30,
      "heartbeat_interval": 10
    },
    "impulse_memory": {
      "storage_dir": "data/impulses",
      "max_budget": 10000,
      "cleanup_threshold": 0.8
    },
    "code_modification": {
      "allowed_dirs": ["src", "config"],
      "backup_enabled": true,
      "safety_checks": true
    }
  },
  "logging": {
    "level": "INFO",
    "file": "logs/vessel.log",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  }
}