# Temp files from activity session
COMMIT_MESSAGE_*.txt

# Substrate-narrator observation logs (operator-side tooling).
# These can grow large and carry no commit-history value. To commit a
# specific observation as evidence for a gap record, move it to
# validation/gaps/evidence/ first. See validation/observations/README.md.
/validation/observations/**
!/validation/observations/README.md
scripts/substrate/workspace/.substrate-secrets
# Host-sync intent + results streams — runtime workspace state, written by
# the substrate cutover resolver and the host-side poller respectively.
scripts/substrate/workspace/mitosis-applied-host-sync.jsonl
scripts/substrate/workspace/mitosis-applied-host-sync-results.jsonl
# Writable vessel-repo clones for substrate-managed publication (see
# `make -C scripts/substrate clone-vessel-repos`). Operator-local artifacts;
# the super-repo records only the Makefile target, not the clones themselves.
scripts/substrate/workspace/git/

# Operator-side Obsidian vault for browsing concept-db (see vault/README.md).
# Auto-mirrored concept notes and runtime workspace files do not belong in git.
# Plugin install + settings ARE committed so the vault is reproducible.
/vault/concept-db/**
/vault/.obsidian/workspace*
/vault/.obsidian/cache
/vault/.obsidian/graph.json
/vault/.obsidian/plugins/metabob-vessel/data.json.local
scripts/substrate/surreal-data/

# Runtime /workspace volume (bind-mounted into substrate-live at /workspace).
# Everything the substrate writes at runtime lands here — dispatch payloads,
# enacted scenarios, proposals, snapshots, caches. NOT needed to build the
# system; ignore wholesale. Already-tracked seed fixtures (e.g. the fm-51
# scenario) stay tracked — .gitignore does not untrack them.
scripts/substrate/workspace/

# ── Untracked heavy nested-git checkouts (kept on disk, out of git) ──
# Multi-GB sibling repos that live under repos/ but are not super-repo
# submodules. Committing them as plain files would bloat history irreversibly.
/repos/activity-dashboard/
/repos/metabob-analysis-api/
/repos/metabob-dashboard/
/repos/metabob-opencode/
/repos/k8s-activity-executor/
/repos/vessels/
/validation/polyglot-benchmark/
/validation/repos/

# ── Ephemeral substrate runtime + benchmark outputs ──
/workspace/
/validation/results/*.json
/validation/activity-reuse-benchmark-*.json
# stray root scratch file
/disrupt-application.md
/repos/metabob-internal-dashboard/

# ── Dropped from the substrate submodule set ──
# Product / UI / deploy repos not needed to build or run the substrate
# container. Out of the super-repo; fresh clones do not include them.
/repos/deployment/
/repos/conversation-vessel/
/repos/user-vessel/
/repos/workbench/
/repos/metabob-cloud-dashboard/
/repos/terminal/
/repos/react-renderer/

# Mitosis staging clones — runtime scratch, never tracked
/repos/*-mitosis-*/

# machine-local MCP config (gitignored)
.mcp.json
**/.metabob/config.json
**/.bootstrap_token

# stray runtime artifacts (regenerated by seed/deploy runs)
/concept-ids.json
/repos/relevance-sink-vessel/bun.lock

# ── Runtime state written under WORKSPACE_ROOT ──
# The substrate writes its pool, gap store, memory, policies and heartbeat at
# runtime. These were committed by an unscoped `git add -A` and then re-committed
# on every change; the tracked copies had already diverged from the live files.
# Learning state belongs in the container volume, not in the tree.
/pool/
/gaps/
/memory/
/memory_notes/
/policies/
/data/
/notes/
/activities/
/resolvers/
/authoring-inflight/
/substrate-heartbeat.json
/mitosis-applied.jsonl
/metabob-mcp-doctor-*.json

# Answer dumps from goal walks that side-effected the filesystem instead of
# emitting a shaped impulse, plus a phantom vessel tree written to a path
# missing its repos/ prefix.
/gap-trace.json
/gap-trace.txt
/gap-activityvariant-write.json
/gap-activityvariant-write.txt
/goal-walk.json
/memory_note.txt
/parity_h1len.txt
/shape_producer.txt
/word_count_note
/test-resolver.js
/src/
/development-vessel/

# host-pull-sync regression detector baseline (runtime state, rewritten each run)
.pullsync-testbaseline
