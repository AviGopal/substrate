# Substrate compose env — copy to .env and fill in. The .env file is gitignored.
#
# REQUIRED
ANTHROPIC_API_KEY=sk-ant-...

# OPTIONAL — autonomous git push to AviGopal remotes (parent change Phase 1).
# Fine-grained PAT, Contents:R/W on the vessel repos + substrate-state. Leave
# unset to run without self-push.
SUBSTRATE_GIT_PAT=
GITHUB_TOKEN=

# SELF-DEV target — the fork the substrate self-updates from and pushes to.
# SUBSTRATE_REPO_OWNER=AviGopal
# SUBSTRATE_GIT_PAT scope: Contents:Read = self-update (pull); Contents:Read+Write
# = self-push (land commits on the fork).

# JOIN AN EXISTING IDENTITY/DISCOVERY GROUP (spoke) — uncomment to attach this
# container to an existing hub's identity + discovery group. All consumed by
# gen-env.sh / make run-live.
# METABOB_API_KEY=          # hub-issued credential — THIS is what joins the group
# ENABLED_ROLES=spoke        # run as a spoke, not a standalone hub
# HUB_DISCOVERY_URL=http://<hub>:18100      # the discovery group to join
# DISCOVERY_ENDPOINT=http://<hub>:18100     # point discovery at the hub
# ACTIVITY_API_ENDPOINT=http://<hub>:18080  # shared trace store
# IDENTITY_VESSEL_URL=http://<hub>:18101    # identity validator = the identity group
# FED_SUBSTRATE_ID=          # optional: stable federation id for this spoke
# RELAY_MULTIADDR=           # optional: libp2p relay multiaddr for p2p transport

# EXTRA LLM PROVIDERS (optional) — on a VM these usually live in the host
# /etc/environment and are threaded in by the deploy scripts; set here for a
# plain `docker compose up`. gen-env advertises a resolver arm per key present.
# OPENAI_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# GOOGLE_API_KEY=

# IMAGE — defaults to the canonical GHCR tag ghcr.io/avigopal/substrate:dev,
# published by build-substrate-image.yml on every push to dev. The package is
# PRIVATE (it bakes vessel source), so pull it after `docker login ghcr.io`
# with a PAT that has read:packages. Override the tag with SUBSTRATE_IMAGE.
# SUBSTRATE_IMAGE=ghcr.io/avigopal/substrate:dev
# SUBSTRATE_CONTAINER=substrate-live

# HOST PORTS (defaults match the legacy `make run-live` mapping)
# ACTIVITY_API_PORT=18080
# DEV_VESSEL_PORT=18090
# DISCOVERY_PORT=18100
# IDENTITY_PORT=18101
# GOAL_HOST_PORT=18210
# ANALYSIS_PORT=18250
# CONCEPT_DB_PORT=18260
# STATEFUL_UI_PORT=18270

# EXISTING deployment on the legacy default signing secret? Set this to boot
# (gen-env fails closed otherwise). Prefer rotating to a strong API_KEY_SECRET.
# ALLOW_INSECURE_API_KEY_SECRET=1

# STATE — both named volumes (substrate-workspace + substrate-surreal) persist
# state across restarts. The operator API key is read post-launch with:
#   docker exec substrate-live substrate-key show
