# Substrate compose env — copy to .env and fill in. The .env file is gitignored.
#
# REQUIRED
ANTHROPIC_API_KEY=sk-ant-...

# OPTIONAL — autonomous git push to AviGopal remotes (parent change Phase 1).
# Fine-grained PAT, Contents:R/W on the vessel repos + substrate-state. Leave
# unset to run without self-push.
SUBSTRATE_GIT_PAT=
GITHUB_TOKEN=

# IMAGE — defaults to the (future) private registry tag. For a locally-built
# image, set e.g. SUBSTRATE_IMAGE=metabob/substrate:dev
# SUBSTRATE_IMAGE=ghcr.io/avigopal/substrate:dev
# SUBSTRATE_CONTAINER=substrate

# HOST PORTS (defaults match the legacy `make run-live` mapping)
# ACTIVITY_API_PORT=18080
# DEV_VESSEL_PORT=18090
# DISCOVERY_PORT=18100
# GOAL_HOST_PORT=18210
# ANALYSIS_PORT=18250
# CONCEPT_DB_PORT=18260
# STATEFUL_UI_PORT=18270
