{
  "_comment": "Declarative vessel inventory for the substrate image. apply-inventory.sh reads this at boot (before systemd) to select which units run, so one image runs any SUBSET: a full local substrate, a minimal hub (store+control+api+transport), or a compute-only spoke. DEFAULT (no ENABLED_ROLES/ENABLED_VESSELS env) = every unit enabled, identical to today. Selection env: ENABLED_ROLES=comma,roles | ENABLED_VESSELS=comma,units (explicit, overrides roles) | DISABLED_VESSELS=comma,units (always off). Per-vessel fork remotes: repo_owner_default (or per-vessel repo_owner) + the `repo` field feed setup-git-push.sh / clone-vessel-repos so a fork can point vessels at its own GitHub org.",
  "repo_owner_default": "AviGopal",
  "branch_default": "dev",
  "roles": {
    "hub": ["store", "control", "api", "transport", "seed", "infra"],
    "spoke": ["compute", "ui", "seed", "infra"],
    "full": ["store", "control", "api", "compute", "ui", "transport", "seed", "infra", "autonomy"]
  },
  "vessels": [
    { "unit": "surrealdb.service", "role": "store" },
    { "unit": "valkey.service", "role": "store" },
    { "unit": "discovery-vessel.service", "role": "control", "repo": "discovery-vessel" },
    { "unit": "identity-vessel.service", "role": "control", "repo": "identity-vessel" },
    { "unit": "activity-api.service", "role": "api", "repo": "activity-api" },
    { "unit": "development-vessel.service", "role": "compute", "repo": "development-vessel" },
    { "unit": "local-tools-vessel.service", "role": "compute", "repo": "local-tools-vessel" },
    { "unit": "llm-resolver-vessel.service", "role": "compute", "repo": "llm-resolver-vessel" },
    { "unit": "goal-host-vessel.service", "role": "compute", "repo": "goal-host-vessel" },
    { "unit": "ribosome-vessel.service", "role": "compute", "repo": "ribosome-vessel" },
    { "unit": "concept-db.service", "role": "compute", "repo": "concept-db" },
    { "unit": "analysis-vessel.service", "role": "compute", "repo": "analysis-vessel" },
    { "unit": "light-dispatch-vessel.service", "role": "compute", "repo": "light-dispatch-vessel" },
    { "unit": "relevance-sink-vessel.service", "role": "compute", "repo": "relevance-sink-vessel" },
    { "unit": "boredom-vessel.timer", "role": "compute", "repo": "boredom-vessel" },
    { "unit": "stateful-ui-vessel.service", "role": "ui", "repo": "stateful-ui-vessel" },
    { "unit": "obsidian-intake.timer", "role": "ui", "repo": "obsidian-vessel" },
    { "unit": "obsidian-learn.timer", "role": "ui", "repo": "obsidian-vessel" },
    { "unit": "obsidian-collaborate.timer", "role": "ui", "repo": "obsidian-vessel" },
    { "unit": "federation-relay.service", "role": "transport", "manifest": true },
    { "unit": "federation-transport-vessel.service", "role": "transport", "manifest": true },
    { "unit": "bootstrap-seeder.service", "role": "seed" },
    { "unit": "concept-db-seeder.service", "role": "seed" },
    { "unit": "substrate-active-scripts-seed.service", "role": "seed" },
    { "unit": "git-push-setup.service", "role": "seed" },
    { "unit": "journald-stdout-forwarder.service", "role": "infra" },
    { "unit": "light-dispatch-healthcheck.timer", "role": "infra" },
    { "unit": "m1-trainer.timer", "role": "autonomy" },
    { "unit": "funnel-drain.timer", "role": "autonomy" },
    { "unit": "composition-edge-reconcile.timer", "role": "autonomy" },
    { "unit": "model-reality-audit.timer", "role": "autonomy" },
    { "unit": "observe-orthogonal-refresh.timer", "role": "autonomy" },
    { "unit": "spectral-gap.timer", "role": "autonomy" },
    { "unit": "autonomy-metrics.timer", "role": "autonomy" },
    { "unit": "self-operational-health.timer", "role": "autonomy" },
    { "unit": "self-repair-operational.timer", "role": "autonomy" },
    { "unit": "operator-goal-generator.timer", "role": "autonomy" },
    { "unit": "auto-describe-resolvers.timer", "role": "autonomy" },
    { "unit": "surgical-gap-scan.timer", "role": "autonomy" }
  ]
}
