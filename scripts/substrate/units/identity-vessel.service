[Unit]
Description=identity-vessel
After=surrealdb.service valkey.service discovery-vessel.service
Wants=surrealdb.service

[Service]
Type=simple
EnvironmentFile=/etc/substrate/env
# Scoped trust-root secrets (secrets-manifest.json; rendered by render-secret-scope.sh).
# After the shared file, and WITHOUT '-': a missing file must fail this unit, not
# start it without the secret it exists to hold.
EnvironmentFile=/etc/substrate/private/env.d/identity-vessel.env
Environment=PORT=8101
Environment=HOST=127.0.0.1
WorkingDirectory=/vessels/identity-vessel
ExecStart=/root/.bun/bin/bun /vessels/identity-vessel/src/index.ts
Restart=on-failure
RestartSec=5
# Back off a crash loop instead of restarting every 5 s: identity exits non-zero when
# its migrations cannot apply or its datastore does not answer, and a fixed 5 s retry
# hammers a store that is already struggling. The fleet's systemd (252) has no
# RestartSteps=/RestartMaxDelaySec= (254+; it ignores them as unknown keys), so the
# extra wait is taken here from NRestarts, which counts consecutive automatic restarts
# and is reset by a manual start or restart (a deploy's restart is never delayed):
# none on a first start, then 5, 10, 20, 40 s, capped at 55 s. '-': a fault in this
# line must never stop the validator from starting.
ExecStartPre=-/bin/sh -c 'n=$(systemctl show -p NRestarts --value identity-vessel.service); [ "$n" -gt 0 ] 2>/dev/null || exit 0; d=$((5 << (n < 5 ? n - 1 : 4))); [ "$d" -gt 55 ] && d=55; sleep "$d"'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
