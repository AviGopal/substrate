[Unit]
Description=minibob boredom — enqueue topology-discovery templateId tasks
After=activity-api.service
Requires=activity-api.service
# One-shot per timer fire. Enqueues templateId tasks to the Redis boredom queue
# via activity-api POST /v2/activities/boredom/enqueue.
# Does NOT post goal-format requests (F-024 fix: goal-format caused infinite failing loops).
# Pile-up guard: skips enqueueing if the medium-priority queue already has
# >= 4 pending items (the number of topology templates we enqueue), so a
# slow or stalled minibob cannot accumulate unbounded work.

[Service]
Type=oneshot
EnvironmentFile=/etc/substrate/env
ExecStart=/usr/bin/bash -c '\
  API_KEY="${METABOB_API_KEY}" ; \
  BASE="http://127.0.0.1:8080" ; \
  STATS=$(curl -sf "$BASE/v2/activities/boredom/queue" \
    -H "Authorization: ApiKey $API_KEY" 2>/dev/null) ; \
  if [ $? -ne 0 ]; then \
    echo "Queue stats unavailable — skipping boredom enqueue"; \
    exit 0; \
  fi ; \
  MEDIUM=$(echo "$STATS" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get(\"byPriority\",{}).get(\"medium\",0))" 2>/dev/null || echo "0") ; \
  if [ "${MEDIUM:-0}" -ge 4 ] 2>/dev/null; then \
    echo "Medium queue already has $MEDIUM items — skipping boredom enqueue to avoid pile-up"; \
    exit 0; \
  fi ; \
  for TMPL in \
    "development-vessel:coverage-tick" \
    "development-vessel:substrate-health-tick" \
    "development-vessel:probe-reachable-unlearned" \
    "development-vessel:learned-topology-snapshot" ; \
  do \
    curl -sf -X POST "$BASE/v2/activities/boredom/enqueue" \
      -H "Content-Type: application/json" \
      -H "Authorization: ApiKey $API_KEY" \
      -d "{\"templateId\":\"$TMPL\",\"priority\":\"medium\"}" \
      && echo "Enqueued $TMPL" \
      || echo "Failed to enqueue $TMPL (non-fatal)"; \
  done'
StandardOutput=journal
StandardError=journal
