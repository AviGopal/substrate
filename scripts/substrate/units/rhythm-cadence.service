[Unit]
Description=Rhythm cadence — restore the registry if empty, then run the conductor
# Two steps, in order, both idempotent:
#   1. rhythm-seed-tick   — no-op unless the rhythm registry is EMPTY, in which case it
#                           restores the committed rhythm set. A pool seeded by hand
#                           with no retained script comes back empty after an outage
#                           that recreates the pool, and nothing notices.
#   2. rhythm-conduct-tick — runs rhythm_conductor_tick and journals
#                           considered/enqueued/skipped/bucket_load.
#
# Runs from a timer rather than from the pool ON PURPOSE. rhythm_conductor_tick was
# registered only as satisfier:rhythm_conductor_tick, a Thompson-selected activity, and
# rarely ran. A scheduler cannot be scheduled by the thing it schedules; per
# CLAUDE.md, a check cannot be scheduled by the mechanism it exists to recover. This is
# that stated bootstrap-tier exception.
After=activity-api.service surrealdb.service development-vessel.service

# Runs the gate-ACCEPTED copy: ${SUBSTRATE_RUN_DIR} is filled from the accepted gate (pull-sync, and
# substrate-active-scripts-seed at boot), never from the super-repo clone, whose HEAD is an unjudged candidate.
Wants=substrate-active-scripts-seed.service
After=substrate-active-scripts-seed.service

[Service]
Type=oneshot
EnvironmentFile=/etc/substrate/env
ExecStart=/root/.bun/bin/bun ${SUBSTRATE_RUN_DIR}/rhythm-seed-tick.ts
ExecStart=/root/.bun/bin/bun ${SUBSTRATE_RUN_DIR}/rhythm-conduct-tick.ts
StandardOutput=journal
StandardError=journal
