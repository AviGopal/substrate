[Unit]
Description=minibob (autonomous daemon)
After=activity-api.service
Requires=activity-api.service

[Service]
Type=simple
EnvironmentFile=/etc/substrate/env
Environment=MINIBOB_PORT=8200
Environment=HOST=127.0.0.1
Environment=MINIBOB_PROVIDER=anthropic
Environment=GOAL_RUNTIME=ias-executor
Environment=GOAL_HOST_VESSEL_ENDPOINT=http://127.0.0.1:8210
Environment=MINIBOB_BOREDOM_ENABLED=true
Environment=DISCOVERY_ENABLED=true
Environment=MINIBOB_DISCOVERY_ENABLED=true
Environment=DISCOVERY_VESSEL_ENDPOINT=http://127.0.0.1:8100
WorkingDirectory=/vessels/minibob
ExecStart=/root/.bun/bin/bun /vessels/minibob/index.ts --daemon
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
