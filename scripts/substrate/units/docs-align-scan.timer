[Unit]
Description=docs-align-scan timer — detect documentation drift from landed code
[Timer]
# LOW cadence — the reach-judge costs an LLM call per candidate, docs drift slowly, and the
# supply must stay bounded. First run 20 min after activation (after ingest-docs has seeded
# the expectation surface at 8 min), then every 6 h.
OnActiveSec=20min
OnUnitActiveSec=6h
Persistent=true
AccuracySec=2min
Unit=docs-align-scan.service
[Install]
WantedBy=timers.target
