[Unit]
Description=Forward all vessel logs to container stdout
After=systemd-journald.service
Wants=systemd-journald.service

[Service]
ExecStart=/bin/bash -c 'exec journalctl -f -o short-iso --no-hostname 2>/dev/null > /proc/1/fd/1'
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
