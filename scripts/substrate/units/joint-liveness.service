[Unit]
Description=Joint-liveness detector — flags write->read-severed joints (the frozen-table class)
# For each (table, time column, max lag) binding that should co-advance with live
# `execution`, asserts the table's newest write is within max-lag of the newest
# execution row. A bound reader-table frozen while the fleet is active is the
# frozen-table signature; each severed joint emits a substrateGap. Meta-guarded:
# gaps on itself if it checks nothing. Read-only except gap emission.
After=activity-api.service surrealdb.service development-vessel.service

# Runs the gate-ACCEPTED copy: ${SUBSTRATE_RUN_DIR} is filled from the accepted gate (pull-sync, and
# substrate-active-scripts-seed at boot), never from the super-repo clone, whose HEAD is an unjudged candidate.
Requires=substrate-active-scripts-seed.service
After=substrate-active-scripts-seed.service

[Service]
Type=oneshot
EnvironmentFile=/etc/substrate/env
ExecStart=/root/.bun/bin/bun ${SUBSTRATE_RUN_DIR}/joint-liveness-tick.ts
StandardOutput=journal
StandardError=journal
