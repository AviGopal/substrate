[Unit]
Description=substrate pull-sync — converge live vessels and the super-repo glue layer to origin/dev from in-container clones
# Boot run doubles as source-convergence: a stale image's /vessels runtime is
# brought to the clones' origin/dev HEAD right after git-push-setup refreshes
# them. Periodic runs (substrate-pull-sync.timer) pick up changes landed on
# origin since — the git remote is the ONLY code channel; no host docker-cp
# path is load-bearing.
After=git-push-setup.service
Wants=git-push-setup.service

[Service]
Type=oneshot
EnvironmentFile=/etc/substrate/env
# PINNED JUDGE: the tick runs gate-runner, which executes only the ACCEPTED pull-sync
# staged under /workspace/.gate/accepted (scripts/substrate/gate/gate-runner.sh). A node
# whose runner has not arrived yet and that was never bootstrapped runs the pre-gate
# pull-sync once more (that tick installs the runner); a BOOTSTRAPPED node whose runner
# is missing refuses (exit 3) rather than fall back to the self-judging path.
# $$ escapes systemd's own variable expansion.
ExecStart=/bin/sh -c 'r=/usr/local/libexec/substrate/gate-runner; if [ -x "$$r" ]; then exec "$$r" tick; elif [ ! -e /workspace/.gate/accepted.sha ]; then echo "gate-runner absent, gate never bootstrapped: running the pre-gate pull-sync"; exec /usr/local/bin/substrate-pull-sync; else echo "GAP gate-runner-missing: /workspace/.gate is bootstrapped but $$r is absent; refusing the ungated path. Break-glass: reinstall the runner from the image"; exit 3; fi'
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
