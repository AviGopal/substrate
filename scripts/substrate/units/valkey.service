[Unit]
Description=Valkey (Redis-compatible cache)
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/valkey-server \
    --bind 127.0.0.1 \
    --port 6379 \
    --save ""
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
