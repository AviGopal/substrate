[Unit]
Description=libp2p reachability + cross-substrate resolve-over-http + /health sensing surface.
After=network.target discovery-vessel.service federation-relay.service

[Service]
Type=simple
# ORDER IS LOAD-BEARING: systemd lets a LATER EnvironmentFile override an
# earlier one, so /etc/substrate/env is listed LAST and is authoritative.
# This unit is the reason the rule is written down: /workspace/.substrate-secrets
# had carried a stale HUB_DISCOVERY_URL (a decommissioned droplet) since an older
# revision of gen-env, and because it loaded last it beat the empty/derived value
# in /etc/substrate/env — no relay anchor resolved and the transport hard-exited
# every 5s, parked in `activating`, never `failed`.
# The persisted store (/workspace/.substrate-secrets) is NOT loaded: it holds every
# trust-root secret (secrets-manifest.json), and gen-env re-emits each non-scoped name
# it carries into /etc/substrate/env, which is authoritative anyway.
EnvironmentFile=/etc/substrate/env
# Scoped trust-root secrets (secrets-manifest.json; rendered by render-secret-scope.sh).
# After the shared file, and WITHOUT '-': a missing file must fail this unit, not
# start it without the secret it exists to hold.
EnvironmentFile=/etc/substrate/env.d/federation-transport-vessel.env
Environment=FED_HEALTH_PORT=8401
Environment=DISCOVERY_URL=http://127.0.0.1:8100
WorkingDirectory=/usr/local/share/substrate/super-repo/scripts/substrate/federation-relay
ExecStart=/root/.bun/bin/bun /usr/local/share/substrate/super-repo/scripts/substrate/federation-relay/federation-transport-server.ts
# Graceful detach: any clean stop deregisters from discovery immediately
# (best-effort; TTL expiry remains the crash backstop).
ExecStopPost=-/usr/local/bin/discovery-deregister federation-transport-vessel
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
