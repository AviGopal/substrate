[Unit]
Description=obsidian-learn — autonomous Obsidian command-effect learning (side loop, 2026-06-15)
After=development-vessel.service concept-db.service
# Deliberately a SIDE loop, NOT a core boredom goal: Obsidian is a disconnectable
# external app; its availability must not perturb the substrate's self-optimizing
# core rotation. See memory feedback_external_apps_outside_core_loop.

[Service]
Type=oneshot
EnvironmentFile=/etc/substrate/env
# CATALOG mode (default): non-intrusive surface learning — reads
# obsidian:command_catalog and persists each command's permission/reversibility
# classification, NO execution, so it is safe on the LIVE vault the operator is
# using (27183). Idempotent (only new commands persisted). Set
# OBSIDIAN_LEARN_MODE=probe + a probe-instance endpoint for execution-based
# effect learning. Unreachable instance → {unreachable:true}, a graceful idle.
Environment=OBSIDIAN_LEARN_MODE=catalog
# The obsidian-vessel plugin runs IN this container (obsidian-desktop.service) on
# 127.0.0.1:27182. The old host.docker.internal:27183 was a leftover from when
# Obsidian ran on the operator's HOST — it is DOWN here, which silently idled the
# intake (request-scan)/behavior-scan passes against a dead endpoint. Point at the
# live in-container plugin so the human↔substrate async loop actually runs.
Environment=OBSIDIAN_LEARN_ENDPOINT=http://127.0.0.1:27182
Environment=OBSIDIAN_LEARN_GRANT=navigate
Environment=OBSIDIAN_LEARN_MAX=10
ExecStart=/usr/bin/bash /usr/local/bin/obsidian-learn-tick.sh

[Install]
WantedBy=multi-user.target
