[Unit]
Description=obsidian-learn — autonomous Obsidian command-effect learning (side loop, 2026-06-15)
After=development-vessel.service concept-db.service
# Deliberately a SIDE loop, NOT a core boredom goal: Obsidian is a disconnectable
# external app; its availability must not perturb the substrate's self-optimizing
# core rotation. See memory feedback_external_apps_outside_core_loop.

[Service]
Type=oneshot
EnvironmentFile=/etc/substrate/env
# Default target is the PROBE instance (27184) so autonomous probing never churns
# the operator's working vault. Override OBSIDIAN_LEARN_ENDPOINT (e.g. ...:27183)
# to learn against another instance. An unreachable instance makes the resolver
# return {unreachable:true} — treated as an idle no-op, never a hard failure.
Environment=OBSIDIAN_LEARN_ENDPOINT=http://host.docker.internal:27184
Environment=OBSIDIAN_LEARN_GRANT=navigate
Environment=OBSIDIAN_LEARN_MAX=10
ExecStart=/usr/bin/bash /usr/local/bin/obsidian-learn-tick.sh

[Install]
WantedBy=multi-user.target
