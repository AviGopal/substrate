[Unit]
Description=Seed the writable run-dir for substrate timer scripts (self-activation)
# SELF-ACTIVATION (2026-06-26). Substrate timer scripts historically ran directly
# from the READ-ONLY host bind path (scripts/substrate/<name>.ts). The Docker-
# Desktop bind is stale-after-mount: a substrate-AUTHORED new version of a timer
# script can't take effect until a full container restart remounts the bind.
#
# Fix: a writable run-dir on the substrate-workspace VOLUME
# (/workspace/active-scripts), seeded FRESH from the bind at every boot by THIS
# oneshot, then mutated between boots by the `activate_substrate_script`
# development-vessel resolver. Units repointed to run from the run-dir pick up the
# new content on their next firing — no restart. The bind is fresh at boot (the
# remount just happened), so each boot starts from the committed host source, and
# substrate-authored deltas accumulate on the volume until the next boot reseeds.
#
# Ordered Before the script timers (After= on them references this) so the run-dir
# exists before any repointed unit fires.
DefaultDependencies=no
After=local-fs.target
Before=compose-teacher.service compose-teacher.timer

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/substrate/env
# Seed from the super-repo CLONE when present (last-known origin/dev state),
# else the IMAGE-baked copy — never a host bind path (a baked host path made
# this unit fail on any machine but the original operator's, 2026-07-02).
# Substrate-authored deltas still accumulate on the volume between boots via
# activate_substrate_script; each boot re-seeds from committed source.
# A node with gate state seeds from the ACCEPTED gate, never the clone: the clone's HEAD is an unjudged
# candidate, and a boot must not make it live (gap every-path-that-changes-running-code-must-pass-the-accepted-gate-first).
# Gate state is the predicate substrate-pull-sync.service uses (any of accepted.sha, accepted, history,
# ledger.jsonl, bootstrapped; the .gate dir itself is pre-created by entrypoint.sh, so it is no signal). With gate
# state but no usable accepted copy it seeds the image's copy, never the clone: losing one file must not re-open
# the ungated path. Only a node with no gate state at all seeds from the clone as before. Besides the .ts scripts, the run dir carries the one shell script a unit runs
# from it and what that script reads beside itself: the inventory and units/ (else it counts every system unit).
ExecStart=/bin/sh -c 'R=/workspace/active-scripts; G=/workspace/.gate; mkdir -p $$R; I=/usr/local/share/substrate/active-scripts; GATED=0; for f in accepted.sha accepted history ledger.jsonl bootstrapped; do if [ -e $$G/$$f ]; then GATED=1; fi; done; if [ $$GATED = 1 ]; then SRC=$$I; if [ -e $$G/accepted.sha ] && ls $$G/accepted/scripts/substrate/*.ts >/dev/null 2>&1; then SRC=$$G/accepted/scripts/substrate; fi; else SRC=/workspace/git/super-repo/scripts/substrate; ls $$SRC/*.ts >/dev/null 2>&1 || SRC=$$I; fi; cp -f $$SRC/*.ts $$R/ || exit 1; for x in memory-budget-check.sh vessels.inventory.json; do if [ -f $$SRC/$$x ]; then cp -f $$SRC/$$x $$R/; fi; done; if [ -d $$SRC/units ]; then rm -rf $$R/units.new && cp -r $$SRC/units $$R/units.new && rm -rf $$R/units && mv $$R/units.new $$R/units; fi; echo "seeded $$(ls $$R/*.ts | wc -l) scripts from $$SRC"'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
