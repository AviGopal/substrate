[Unit]
Description=Seed the writable run-dir for substrate timer scripts (self-activation)
# SELF-ACTIVATION (2026-06-26). Substrate timer scripts historically ran directly
# from the READ-ONLY host bind path (scripts/substrate/<name>.ts). The Docker-
# Desktop bind is stale-after-mount: a substrate-AUTHORED new version of a timer
# script can't take effect until a full container restart remounts the bind.
#
# Fix: a writable run-dir on the substrate-workspace VOLUME
# (/workspace/active-scripts), seeded FRESH from the bind at every boot by THIS
# oneshot, then mutated between boots by the `activate_substrate_script`
# development-vessel resolver. Units repointed to run from the run-dir pick up the
# new content on their next firing — no restart. The bind is fresh at boot (the
# remount just happened), so each boot starts from the committed host source, and
# substrate-authored deltas accumulate on the volume until the next boot reseeds.
#
# Ordered Before the script timers (After= on them references this) so the run-dir
# exists before any repointed unit fires.
DefaultDependencies=no
After=local-fs.target
Before=compose-teacher.service compose-teacher.timer

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/substrate/env
# Seed from the super-repo CLONE when present (last-known origin/dev state),
# else the IMAGE-baked copy — never a host bind path (a baked host path made
# this unit fail on any machine but the original operator's, 2026-07-02).
# Substrate-authored deltas still accumulate on the volume between boots via
# activate_substrate_script; each boot re-seeds from committed source.
ExecStart=/bin/sh -c 'mkdir -p /workspace/active-scripts; SRC=/workspace/git/super-repo/scripts/substrate; ls "$SRC"/*.ts >/dev/null 2>&1 || SRC=/usr/local/share/substrate/active-scripts; cp -f "$SRC"/*.ts /workspace/active-scripts/ && echo "seeded $(ls /workspace/active-scripts/*.ts | wc -l) scripts from $SRC"'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
