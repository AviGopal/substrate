[Unit]
Description=SurrealDB
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/substrate/env
# Cap RocksDB block cache explicitly. SurrealDB auto-sizes it to ~42% of the
# memory limit by default (~11G against MemoryMax=26G), and RocksDB compaction
# peaks 2-3x on top of that — which blows past the cgroup cap and triggers the
# ~hourly OOM-restart loop. Setting SURREAL_ROCKSDB_BLOCK_CACHE_SIZE explicitly
# keeps the cache bounded.
# 4Gi cache + write buffers + runtime + compaction peak stays well under 26G.
Environment=SURREAL_ROCKSDB_BLOCK_CACHE_SIZE=4294967296
# cgroup memory cap: bound the RocksDB working set so an OOM kills ONLY surreal
# (which self-restarts) instead of cascading the host. MemoryHigh throttles
# reclaim before the hard MemoryMax OOM.
#
# ★ A CAP IS A PROPERTY OF THE HOST, AND THIS FILE IS SHARED BY HOSTS THAT DIFFER. Any
#   single number here is wrong somewhere. 22G/26G is the value the hub runs on without
#   memcg OOMs; size a host's cap from that host's MemTotal and its other tenants, never
#   from another machine's.
#
# ★ LOWERING A LIVE CAP IS NOT A SAFE EDIT. systemd applies it immediately on daemon-
#   reload; a process already above the new ceiling is killed at once, mid-write. A cap may
#   only be lowered when the process is known to be below it, or on a restart.
#
# Memory caps are containment, not a fix for CPU load: a dashboard polling an unbounded
# trace query makes SurrealDB sort every matching row before LIMIT applies, and the durable
# fix for that is a narrow projection on the query.
#
# scripts/substrate/memory-budget-check.sh checks this arithmetic on any host.
MemoryAccounting=yes
MemoryHigh=22G
MemoryMax=26G
# ROOT CREDENTIALS COME FROM THE ENVIRONMENT, NEVER FROM ARGV.
# `--pass ${SURREAL_PASS}` put the live root password into /proc/<pid>/cmdline, which
# every process in the container (and `ps` on the host) can read. `surreal start` reads
# the same two settings from SURREAL_USER / SURREAL_PASS (`surreal start --help`,
# 2.3.3: "[env: SURREAL_PASS=]"), and /proc/<pid>/environ is readable only by the
# process owner. SURREAL_PASS arrives through EnvironmentFile= above; SURREAL_USER is
# set here because /etc/substrate/env does not carry it (if it ever does, the
# EnvironmentFile value wins, which is fine as long as it is still root).
# Both apply ONLY when the datastore has no root user yet: on a warm data.db the stored
# root user governs auth, so this change cannot alter who can log in.
# Post-deploy must-fail check (prints a count only): `grep -c -- --pass
# /proc/$(systemctl show -p MainPID --value surrealdb)/cmdline` must print 0.
Environment=SURREAL_USER=root
ExecStart=/usr/local/bin/surreal start \
    --bind 127.0.0.1:8000 \
    --log info \
    file:/var/lib/surrealdb/data.db
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
