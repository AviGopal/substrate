[Unit]
Description=goal-host-vessel
After=activity-api.service discovery-vessel.service identity-vessel.service llm-resolver-vessel.service
Wants=activity-api.service

[Service]
Type=simple
EnvironmentFile=/etc/substrate/env
# Scoped secret (secrets-manifest.json; rendered by render-secret-scope.sh): GOAL_HOST_CORPUS_RUNNER_API_KEY, the
# corpus runner's verdict-corpus:write key. Loaded only here, after the shared env, never written to the shared env.
# pull-sync renders the scoped files before it installs a unit, so this file exists when the unit lands.
EnvironmentFile=/etc/substrate/private/env.d/goal-host-vessel.env
Environment=PORT=8210
Environment=HOST=127.0.0.1
Environment=GOAL_HOST_VESSEL_ID=goal-host-vessel
Environment=LLM_VESSEL_ENDPOINT=http://127.0.0.1:8220
# iter-8 ablation: disable WS subscriber to prevent idle RSS accumulation.
# Polling fallback (60s) handles dev-vessel re-registration.
Environment=GOAL_HOST_WS_SUBSCRIBER=off
WorkingDirectory=/vessels/goal-host-vessel
ExecStart=/root/.bun/bin/bun /vessels/goal-host-vessel/src/index.ts
Restart=on-failure
RestartSec=5

# Memory isolation: cap goal-host's cgroup so its OOM-cascade
# (recurring during LLM-heavy dispatch chains: scaffold-mitosis-track,
# enact-orthogonal-decisions, draft-gap-closing-activity) is contained to
# goal-host itself rather than triggering container-wide pressure that
# takes down sibling vessels. Observed cgroup peak: 22GB before this cap.
# MemoryHigh applies pressure (encourages reclaim); MemoryMax is the
# kernel-OOM threshold. After this cap, goal-host failures are scoped:
# systemd restarts it cleanly, sibling vessels keep running, the substrate's
# autonomous detection (service_oom_cascade_scan) gets observable signal.
# Bun's cold footprint exceeds 2G at startup, so the cap sits above it.
MemoryHigh=4G
MemoryMax=6G
# Also slow restart so we don't thrash through OOM/restart loops at speed. The fleet's
# systemd (252) has no RestartSteps=/RestartMaxDelaySec= (254+; it ignores them as
# unknown keys, so the escalation they named never happened), so the extra wait is taken
# here from NRestarts, which counts consecutive automatic restarts and is reset by a
# manual start or restart (a deploy's restart is never delayed): none on a first start,
# then 5, 10, 20, 40 s, capped at 55 s, on top of RestartSec. '-': a fault in this line
# must never stop goal-host from starting.
ExecStartPre=-/bin/sh -c 'n=$(systemctl show -p NRestarts --value goal-host-vessel.service); [ "$n" -gt 0 ] 2>/dev/null || exit 0; d=$((5 << (n < 5 ? n - 1 : 4))); [ "$d" -gt 55 ] && d=55; sleep "$d"'

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
