[Unit]
Description=llm-resolver-google
After=activity-api.service discovery-vessel.service identity-vessel.service
Wants=activity-api.service

[Service]
Type=simple
# Location independence (law 11): this Gemini-backed sibling materializes ONLY
# where a Google credential lives. ExecCondition (not ExecStartPre) makes an
# absent key a clean SKIP, not a failure — so the same image runs everywhere and
# the arm appears wherever GOOGLE_API_KEY is present, with no per-role config.
# Without this, a keyless host would start a resolver pinned to gemini-2.5-flash
# it cannot serve, polluting the router's arm pool with a dead arm.
ExecCondition=/bin/sh -c 'grep -Eq "^GOOGLE_API_KEY=.+" /etc/substrate/env'
EnvironmentFile=/etc/substrate/env
# Sibling llm-resolver instance pinned to a distinct model. Runs the SAME
# in-image source as llm-resolver-vessel. NOTE: LLM_DEFAULT_MODEL is NOT set via
# Environment= here — /etc/substrate/env (which sets a shared LLM_DEFAULT_MODEL)
# is applied AFTER Environment= and would override it. The model pin comes from a
# LATER EnvironmentFile via the drop-in llm-resolver-google.service.d/model.conf.
# vessel_id == model is the learnable arm the goal-host LLM router selects over.
Environment=PORT=8225
Environment=HOST=127.0.0.1
Environment=LLM_RESOLVER_VESSEL_ID=llm-resolver-google
WorkingDirectory=/vessels/llm-resolver-vessel
ExecStart=/root/.bun/bin/bun /vessels/llm-resolver-vessel/src/index.ts
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
