[Unit]
Description=llm-resolver-google
After=activity-api.service discovery-vessel.service identity-vessel.service
Wants=activity-api.service

[Service]
Type=simple
# Location independence (law 11): this Gemini-backed sibling materializes ONLY
# where a Google credential lives. ExecCondition (not ExecStartPre) makes an
# absent key a clean SKIP, not a failure — so the same image runs everywhere and
# the arm appears wherever GOOGLE_API_KEY is present, with no per-role config.
# Without this, a keyless host would start a resolver pinned to gemini-2.5-flash
# it cannot serve, polluting the router's arm pool with a dead arm.
#
# ★ The predicate must reject a QUOTED-EMPTY value, and must survive SYSTEMD's
# parser. Two bugs live on this one line.
#
# (1) gen-env writes an unset key as GOOGLE_API_KEY="", and the original pattern
#     `=.+` matched the two QUOTE CHARACTERS — so the guard passed on every
#     host and did exactly what the paragraph above says it prevents: measured
#     on two keyless UI spokes, three arms were active and answering /health
#     with no credential anywhere.
#
# (2) The first repair used a shell-style `'"'"'` escape to match a quote. That
#     idiom is a BASH concatenation trick; systemd is not a shell and does not
#     honour it, so it handed /bin/sh a string with an unterminated quote —
#     `unexpected EOF while looking for matching "` — and EVERY arm skipped,
#     including ones with real keys. It tested fine in bash, which re-processes
#     the quoting, and failed under real systemd.
#
# Hence: no double quotes inside the sh -c argument at all. `[^=]*[A-Za-z0-9]`
# requires at least one alphanumeric after the `=`, which quotes and whitespace
# are not.
#
# TEST ANY CHANGE THROUGH SYSTEMD, NOT BASH, against all five shapes:
#   ="" / ="real" / = / =real / ="   "   (the last must SKIP)
ExecCondition=/bin/sh -c 'grep -Eq "^GOOGLE_API_KEY=[^=]*[A-Za-z0-9]" /etc/substrate/env'
EnvironmentFile=/etc/substrate/env
# Sibling llm-resolver instance pinned to a distinct model. Runs the SAME
# in-image source as llm-resolver-vessel. NOTE: LLM_DEFAULT_MODEL is NOT set via
# Environment= here — /etc/substrate/env (which sets a shared LLM_DEFAULT_MODEL)
# is applied AFTER Environment= and would override it. The model pin comes from a
# LATER EnvironmentFile via the drop-in llm-resolver-google.service.d/model.conf.
# vessel_id == model is the learnable arm the goal-host LLM router selects over.
Environment=PORT=8225
Environment=HOST=127.0.0.1
Environment=LLM_RESOLVER_VESSEL_ID=llm-resolver-google
WorkingDirectory=/vessels/llm-resolver-vessel
ExecStart=/root/.bun/bin/bun /vessels/llm-resolver-vessel/src/index.ts
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
