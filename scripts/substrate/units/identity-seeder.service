[Unit]
Description=identity seeder — mint org+keys on first boot, reseed env, restart key consumers
# Self-bootstrap: replaces the operator-run `make seed-live` + manual vessel
# restarts. Idempotent: seed-identity.ts 409-skips when the substrate org
# exists, and reseed-restart.sh only restarts vessels when the key actually
# changed (never on a warm boot).
After=identity-vessel.service activity-api.service
Wants=identity-vessel.service

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/substrate/env
# A spoke federates identity to its hub and masks the local identity-vessel, so
# there is nothing here to seed. Skip (ExecCondition -> unit goes inactive, not
# failed) rather than waiting on a unit that by design never starts; the old
# unbounded wait below left this unit `failed` on every spoke.
ExecCondition=/bin/sh -c '[ "$(systemctl is-enabled identity-vessel.service 2>/dev/null)" != "masked" ]'
ExecStartPre=/bin/sh -c 'i=0; until curl -sf http://127.0.0.1:8101/health > /dev/null; do i=$((i+1)); [ "$i" -ge 60 ] && { echo "identity-vessel not healthy after 120s — aborting seed"; exit 1; }; sleep 2; done'
ExecStart=/usr/local/bin/reseed-restart
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
