[Unit]
Description=discovery-vessel
After=network.target

[Service]
Type=simple
EnvironmentFile=/etc/substrate/env
# Scoped trust-root secrets (secrets-manifest.json; rendered by render-secret-scope.sh).
# After the shared file, and WITHOUT '-': a missing file must fail this unit, not
# start it without the secret it exists to hold.
EnvironmentFile=/etc/substrate/env.d/discovery-vessel.env
Environment=PORT=8100
Environment=HOST=127.0.0.1
WorkingDirectory=/vessels/discovery-vessel
ExecStart=/root/.bun/bin/bun /vessels/discovery-vessel/index.ts
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
