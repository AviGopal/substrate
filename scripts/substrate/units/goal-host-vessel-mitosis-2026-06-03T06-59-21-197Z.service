[Unit]
Description=goal-host-vessel (mitosis 2026-06-03T06-59-21-197Z) — streaming refactor of LLM-reuse path: replace /templates?limit=200 (~508KB body) with ?q=gap-closing&limit=10 (~33KB, 15x smaller) to reduce per-dispatch kernel-buffer accumulation that drives goal-ho
After=activity-api.service
Requires=activity-api.service

[Service]
Type=simple
EnvironmentFile=/etc/substrate/env
Environment=PORT=8211
Environment=HOST=0.0.0.0
Environment=WORKSPACE_ROOT=/workspace
Environment=VESSEL_ID=goal-host-vessel-mitosis-2026-06-03T06-59-21-197Z
Environment=VESSEL_ENDPOINT=http://127.0.0.1:8211
Environment=MITOSIS_VERSION_ID=mitosis-2026-06-03T06-59-21-197Z
Environment=MITOSIS_BASE_VESSEL=goal-host-vessel
WorkingDirectory=/vessels/goal-host-vessel-mitosis-2026-06-03T06-59-21-197Z
ExecStart=/root/.bun/bin/bun /vessels/goal-host-vessel-mitosis-2026-06-03T06-59-21-197Z/src/index.ts
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
