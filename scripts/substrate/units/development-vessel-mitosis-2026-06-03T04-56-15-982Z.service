[Unit]
Description=development-vessel (mitosis 2026-06-03T04-56-15-982Z) — fix #140: replace {{report_path}} + {{scenarios_dir}}/{{scenario_id}}.json with hardcoded fallback to /workspace/scenarios/fm-17-... so chain starts even without dispatch-time variables
After=activity-api.service
Requires=activity-api.service

[Service]
Type=simple
EnvironmentFile=/etc/substrate/env
Environment=PORT=8091
Environment=HOST=0.0.0.0
Environment=WORKSPACE_ROOT=/workspace
Environment=VESSEL_ID=development-vessel-mitosis-2026-06-03T04-56-15-982Z
Environment=VESSEL_ENDPOINT=http://127.0.0.1:8091
Environment=MITOSIS_VERSION_ID=mitosis-2026-06-03T04-56-15-982Z
Environment=MITOSIS_BASE_VESSEL=development-vessel
WorkingDirectory=/vessels/development-vessel-mitosis-2026-06-03T04-56-15-982Z
ExecStart=/root/.bun/bin/bun /vessels/development-vessel-mitosis-2026-06-03T04-56-15-982Z/src/index.ts
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
