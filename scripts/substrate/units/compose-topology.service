[Unit]
Description=Compose-topology drain — fire compose_topology_tick (the organic edge-former), decoupled from the boredom selector
# compose_topology_tick authors a composite over an uncomposed non-hub
# chainable pair -> forms a genuine cross-link composition edge (raises lambda2,
# breaks the star topology). It ranks last (goal[49]) in the boredom
# goal-dispatch rotation, which is dormant; the active pool/shape loop only runs
# observer/audit ticks, so the edge-former never fires and distinct/genuine
# edges sit flat. This oneshot guarantees one composite per tick. Self-limiting:
# the resolver caps total composites (max_composites, default 300) and returns
# reinforced_existing at the cap, so it adds edges only while headroom exists.
After=development-vessel.service activity-api.service
Requires=development-vessel.service

# Smoke test:
#   docker exec substrate-live systemctl start compose-topology.service
#   docker exec substrate-live journalctl -u compose-topology.service --no-pager -n 3
#   # last line is JSON: {composer_action, composite, existing_composites, under_cap, ...}

[Service]
Type=oneshot
EnvironmentFile=-/etc/substrate/env
ExecStart=/root/.bun/bin/bun /home/avi/documents/work/exp-repo/metabob-devbob/scripts/substrate/compose-topology-drain.ts
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
