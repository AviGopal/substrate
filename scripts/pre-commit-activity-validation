#!/bin/bash

# Pre-commit Hook for Activity Validation
# Prevents commits that don't meet activity quality gates

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Configuration
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
VALIDATION_SCRIPT="$SCRIPT_DIR/validate-activity.ts"
CONFIG_FILE="$PROJECT_ROOT/.activity-failure-conditions.json"

echo -e "${BLUE}🔍 Running activity validation pre-commit hook...${NC}"

# Check if validation script exists
if [ ! -f "$VALIDATION_SCRIPT" ]; then
    echo -e "${RED}❌ Activity validation script not found: $VALIDATION_SCRIPT${NC}"
    echo -e "${YELLOW}⚠️  Skipping validation (development setup may be incomplete)${NC}"
    exit 0
fi

# Check if config file exists
if [ ! -f "$CONFIG_FILE" ]; then
    echo -e "${RED}❌ Activity failure conditions config not found: $CONFIG_FILE${NC}"
    echo -e "${YELLOW}⚠️  Skipping validation (configuration missing)${NC}"
    exit 0
fi

# Check if Node.js and npm are available
if ! command -v node &> /dev/null; then
    echo -e "${YELLOW}⚠️  Node.js not found. Skipping activity validation.${NC}"
    exit 0
fi

if ! command -v npm &> /dev/null; then
    echo -e "${YELLOW}⚠️  npm not found. Skipping activity validation.${NC}"
    exit 0
fi

# Detect activity type from commit message
COMMIT_MSG_FILE="$PROJECT_ROOT/.git/COMMIT_EDITMSG"
ACTIVITY_TYPE=""

if [ -f "$COMMIT_MSG_FILE" ]; then
    COMMIT_MSG=$(head -1 "$COMMIT_MSG_FILE")
    
    if [[ "$COMMIT_MSG" =~ ^fix: ]] || [[ "$COMMIT_MSG" =~ "bug fix" ]]; then
        ACTIVITY_TYPE="fix"
    elif [[ "$COMMIT_MSG" =~ ^feat: ]] || [[ "$COMMIT_MSG" =~ "feature" ]]; then
        ACTIVITY_TYPE="feature"
    elif [[ "$COMMIT_MSG" =~ ^refactor: ]]; then
        ACTIVITY_TYPE="refactor"
    elif [[ "$COMMIT_MSG" =~ "security" ]]; then
        ACTIVITY_TYPE="security"
    elif [[ "$COMMIT_MSG" =~ "fix" ]] || [[ "$COMMIT_MSG" =~ "bug" ]]; then
        ACTIVITY_TYPE="bugfix"
    else
        ACTIVITY_TYPE="fix" # Default
    fi
else
    # Fallback: try to detect from git log
    LAST_COMMIT=$(git log -1 --pretty=%B 2>/dev/null || echo "")
    
    if [[ "$LAST_COMMIT" =~ ^fix: ]] || [[ "$LAST_COMMIT" =~ "bug fix" ]]; then
        ACTIVITY_TYPE="fix"
    elif [[ "$LAST_COMMIT" =~ ^feat: ]] || [[ "$LAST_COMMIT" =~ "feature" ]]; then
        ACTIVITY_TYPE="feature"
    elif [[ "$LAST_COMMIT" =~ ^refactor: ]]; then
        ACTIVITY_TYPE="refactor"
    elif [[ "$LAST_COMMIT" =~ "security" ]]; then
        ACTIVITY_TYPE="security"
    elif [[ "$LAST_COMMIT" =~ "fix" ]] || [[ "$LAST_COMMIT" =~ "bug" ]]; then
        ACTIVITY_TYPE="bugfix"
    else
        ACTIVITY_TYPE="fix" # Default
    fi
fi

echo -e "${BLUE}📋 Detected activity type: ${ACTIVITY_TYPE}${NC}"

# Generate activity ID
ACTIVITY_ID="precommit_$(date +%s)"

# Set environment variables for validation
export ACTIVITY_ID="$ACTIVITY_ID"
export ACTIVITY_TYPE="$ACTIVITY_TYPE"
export CONFIG_PATH="$CONFIG_FILE"

echo -e "${BLUE}🏃 Running validation for activity: ${ACTIVITY_ID}${NC}"

# Run validation with timeout
VALIDATION_TIMEOUT=300 # 5 minutes

if timeout $VALIDATION_TIMEOUT node "$VALIDATION_SCRIPT" \
    --activity-id "$ACTIVITY_ID" \
    --activity-type "$ACTIVITY_TYPE" \
    --config "$CONFIG_FILE" \
    --project-root "$PROJECT_ROOT" \
    --format text; then
    
    echo -e "${GREEN}✅ Activity validation passed! Commit allowed.${NC}"
    exit 0
else
    VALIDATION_EXIT_CODE=$?
    
    echo -e "${RED}❌ Activity validation failed!${NC}"
    echo -e "${RED}Exit code: $VALIDATION_EXIT_CODE${NC}"
    
    case $VALIDATION_EXIT_CODE in
        1)
            echo -e "${RED}🚨 CRITICAL failures detected. Commit blocked.${NC}"
            echo -e "${YELLOW}Fix all critical issues before committing.${NC}"
            ;;
        2)
            echo -e "${YELLOW}⚠️  HIGH severity failures detected.${NC}"
            echo -e "${YELLOW}Manual review required before committing.${NC}"
            ;;
        3)
            echo -e "${BLUE}ℹ️  Warnings detected but commit allowed.${NC}"
            echo -e "${YELLOW}Consider addressing warnings for better code quality.${NC}"
            exit 0
            ;;
        124)
            echo -e "${RED}⏰ Validation timed out after ${VALIDATION_TIMEOUT} seconds.${NC}"
            echo -e "${YELLOW}Check for hanging processes or increase timeout.${NC}"
            ;;
        *)
            echo -e "${RED}💥 Validation failed with unexpected error.${NC}"
            ;;
    esac
    
    echo ""
    echo -e "${BLUE}🔧 To fix validation issues:${NC}"
    echo -e "  1. Review the validation output above"
    echo -e "  2. Fix the identified issues"
    echo -e "  3. Run tests: ${YELLOW}npm test${NC}"
    echo -e "  4. Check code quality: ${YELLOW}npm run lint${NC}"
    echo -e "  5. Try committing again"
    echo ""
    echo -e "${BLUE}🚨 To bypass validation (NOT recommended):${NC}"
    echo -e "  ${YELLOW}git commit --no-verify${NC}"
    echo ""
    
    exit $VALIDATION_EXIT_CODE
fi