{
  "specificationName": "devbob-activity-execution-validation",
  "harnessFile": "tests/validation-harnesses/devbob-activity-execution-validation-harness.ts",
  "testCases": [
    {
      "impulseId": "validation-devbob-activity-execution-validation-case-1",
      "name": "DevBob MCP Configuration",
      "input": {
        "configPath": "/workspace/.opencode/opencode.json",
        "fallbackPath": "/root/.opencode/opencode.json"
      },
      "expectedOutput": {
        "mcp.metabob.url": "http://metabob-rpc-api.metabob.svc.cluster.local:8080",
        "mcp.metabob.enabled": true
      }
    },
    {
      "impulseId": "validation-devbob-activity-execution-validation-case-2",
      "name": "MCP Tool: metabob_recommend_activities",
      "input": {
        "command": "opencode activity search 'Add REST endpoint' --category feature --limit 3",
        "task": "Add REST endpoint"
      },
      "expectedOutput": {
        "status": "success",
        "recommendationCount": "1-5",
        "hasThompsonSampling": true,
        "structure": {
          "template_id": "string",
          "selection_metadata": {
            "method": "thompson_sampling",
            "alpha": "number > 0",
            "beta": "number > 0",
            "sample": "number (0-1)"
          }
        }
      }
    },
    {
      "impulseId": "validation-devbob-activity-execution-validation-case-3",
      "name": "Activity Execution",
      "input": {
        "command": "opencode activity run <template-id> --variables '{}' --reason 'Validation test'",
        "templateId": "from_step_2_recommendation"
      },
      "expectedOutput": {
        "hasOutput": true,
        "hasSessionId": true,
        "exitCode": 0,
        "sessionIdPattern": "/act_[a-z0-9_-]+/i"
      }
    },
    {
      "impulseId": "validation-devbob-activity-execution-validation-case-4",
      "name": "Backend Log Monitoring",
      "input": {
        "command": "kubectl logs <rpc-api-pod> -n metabob --tail=100 --since=10s",
        "searchPatterns": [
          "POST.*executions",
          "update_metrics",
          "alpha",
          "beta"
        ]
      },
      "expectedOutput": {
        "hasExecutionPost": true,
        "hasMetricsUpdate": true,
        "hasActivityLog": true
      }
    },
    {
      "impulseId": "validation-devbob-activity-execution-validation-case-5",
      "name": "Template Metrics Update",
      "input": {
        "command": "curl http://metabob-rpc-api.metabob.svc.cluster.local:8080/api/v1/learning-loop/metrics/<template-id>",
        "templateId": "from_step_2_recommendation"
      },
      "expectedOutput": {
        "thompson_alpha": "number > 0",
        "thompson_beta": "number > 0",
        "total_executions": "number > 0",
        "success_rate": "number (0-1)"
      }
    },
    {
      "impulseId": "validation-devbob-activity-execution-validation-case-6",
      "name": "Learning Loop Closure",
      "input": {
        "command": "opencode activity search 'Add REST endpoint' --category feature --limit 3",
        "previousRanking": "from_step_2"
      },
      "expectedOutput": {
        "hasValidMetrics": true,
        "rankingMayChange": true,
        "metricsUpdated": "alpha or beta incremented"
      }
    },
    {
      "impulseId": "validation-devbob-activity-execution-validation-case-7",
      "name": "All MCP Tools Available",
      "input": {
        "command": "opencode mcp list",
        "requiredTools": [
          "metabob_recommend_activities",
          "metabob_post_activity_result",
          "metabob_create_activity_variant",
          "metabob_recommend_impulses",
          "metabob_fetch_boredom_activities"
        ]
      },
      "expectedOutput": {
        "availableTools": 5,
        "allToolsAvailable": true
      }
    }
  ],
  "executionInstructions": {
    "prerequisites": [
      "DevBob pod running in k8s namespace 'metabob'",
      "metabob-rpc-api pod running in k8s namespace 'metabob'",
      "kubectl access to cluster",
      "Backend at http://metabob-rpc-api.metabob.svc.cluster.local:8080"
    ],
    "runCommand": "bun run tests/validation-harnesses/devbob-activity-execution-validation-harness.ts",
    "alternateCommand": "npx tsx tests/validation-harnesses/devbob-activity-execution-validation-harness.ts",
    "expectedDuration": "30-60 seconds",
    "exitCodes": {
      "0": "All tests passed",
      "1": "One or more tests failed"
    }
  },
  "validationSteps": [
    {
      "step": 1,
      "name": "Verify DevBob MCP Configuration",
      "description": "Checks that opencode.json in DevBob points to k8s service DNS",
      "critical": true
    },
    {
      "step": 2,
      "name": "Test metabob_recommend_activities",
      "description": "Calls MCP tool from DevBob and validates Thompson Sampling response",
      "critical": true
    },
    {
      "step": 3,
      "name": "Execute Activity",
      "description": "Runs recommended activity from DevBob and captures session_id",
      "critical": false
    },
    {
      "step": 4,
      "name": "Monitor Backend Logs",
      "description": "Tails RPC API logs for execution recording evidence",
      "critical": false
    },
    {
      "step": 5,
      "name": "Verify Metrics Update",
      "description": "Queries backend for template_metrics with updated alpha/beta",
      "critical": true
    },
    {
      "step": 6,
      "name": "Verify Learning Loop Closure",
      "description": "Re-runs recommendation and checks for Thompson Sampling data",
      "critical": true
    },
    {
      "step": 7,
      "name": "Test All MCP Tools",
      "description": "Verifies all 5 critical MCP tools are accessible from DevBob",
      "critical": true
    }
  ],
  "harnessImpulseId": "harness-devbob-activity-execution-validation",
  "harnessMetadata": {
    "language": "TypeScript",
    "framework": "Node.js with kubectl",
    "assertions": "7 validation steps",
    "llmRequired": false,
    "historical": true
  }
}
