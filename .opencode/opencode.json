{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5-20250929",
  "share": "disabled",
  "mcp": {
    "metabob": {
      "type": "local",
      "command": [
        "metabob-cli",
        "mcp",
        "--transport",
        "stdio"
      ],
      "enabled": true,
      "timeout": 30000,
      "environment": {
        "METABOB_API_URL": "http://localhost",
        "METABOB_PROJECT_ID": "devbob-local",
        "METABOB_API_KEY": "local-dev-key",
        "METABOB_EXCLUDE_PATHS": "**/tests/**,**/perf-repos/**,**/__pycache__/**,**/.git/**,**/node_modules/**,**/venv/**,**/.venv/**,**/dist/**,**/build/**,**/.next/**,**/.metabob/**",
        "METABOB_WATCH_FILES": "false"
      }
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@executeautomation/playwright-mcp-server"
      ],
      "enabled": true,
      "timeout": 60000
    }
  },
  "metabob": {
    "cli_path": "metabob-cli",
    "base_url": "http://localhost",
    "api_key": "local-dev-key",
    "template_registration": {
      "auto_register": true,
      "default_category": "feature"
    },
    "activity_learning": {
      "enabled": true,
      "min_confidence": 0.7
    }
  },
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "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"
      }
    },
    "openai": {}
  },
  "sessionMemory": {
    "enabled": true,
    "analysis": {
      "provider": "anthropic",
      "model": "claude-haiku-4-5",
      "timeout": 30000
    },
    "budgets": {
      "perImpulse": 2000
    },
    "maxImpulsesPerTurn": 5
  }
}
