{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5-20250929",
  "share": "disabled",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@executeautomation/playwright-mcp-server"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "metabob": {
      "type": "local",
      "command": ["metabob-cli", "mcp", "--transport", "stdio"],
      "environment": {
        "METABOB_API_KEY": "local-dev-key",
        "METABOB_API_URL": "http://api.metabob.local"
      },
      "enabled": true
    }
  },
  "metabob": {
    "cli_path": "metabob-cli",
    "base_url": "http://api.metabob.local",
    "api_key": "local-dev-key",
    "auto_inject": true,
    "template_registration": {
      "auto_register": false,
      "default_category": "feature"
    },
    "activity_learning": {
      "enabled": true,
      "min_confidence": 0.7
    }
  },
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "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"
      }
    },
    "openai": {}
  },
  "sessionMemory": {
    "enabled": true,
    "analysis": {
      "provider": "anthropic",
      "model": "claude-haiku-4-5",
      "timeout": 30000
    },
    "budgets": {
      "perImpulse": 2000
    },
    "maxImpulsesPerTurn": 5
  }
}
