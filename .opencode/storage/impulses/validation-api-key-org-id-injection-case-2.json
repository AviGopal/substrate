{
  "id": "validation-api-key-org-id-injection-case-2",
  "type": "memo",
  "pointer": {
    "type": "memo",
    "content": "Test Case 2: RPC Logs org_id Extraction Success\n\nThis test verifies that RPC API logs contain successful org_id extraction messages and no GAP-9 warnings when API key authentication is used.",
    "source": "validation-harness"
  },
  "budget": 800,
  "testCase": {
    "name": "RPC Logs org_id Extraction",
    "input": {
      "logSource": "kubectl logs deployment/metabob-rpc-api --tail=100 --since=1m",
      "searchPatterns": [
        "[GAP-9] Extracted org_id from API key",
        "[GAP-9] Failed to extract org_id from token"
      ]
    },
    "expectedOutput": {
      "hasSuccessfulExtraction": true,
      "hasNoWarnings": true,
      "containsOrgId": true,
      "logSample": "[GAP-9] Extracted org_id from API key: org_id=d98c6120-96a8-41ff-b0fe-835c0cc0d454"
    }
  }
}
