{
  "id": "validation-rpc-api-data-display-endpoints-case-1",
  "type": "memo",
  "pointer": {
    "type": "memo",
    "content": {
      "testCase": "Project Listing Returns Objects",
      "description": "Validate that GET /auth/orgs/{org_id}/projects returns project objects with proper fields, not an array of field name strings",
      "input": {
        "endpoint": "GET /auth/orgs/{org_id}/projects",
        "method": "GET",
        "headers": {
          "Authorization": "Bearer {auth_token}",
          "Content-Type": "application/json"
        },
        "urlParams": {
          "org_id": "test-org-id"
        },
        "queryParams": {
          "limit": 50,
          "offset": 0
        }
      },
      "expectedOutput": {
        "status": 200,
        "bodyStructure": {
          "projects": {
            "type": "array",
            "items": {
              "type": "object",
              "requiredFields": [
                "project_id",
                "name",
                "org_id",
                "branch",
                "created_at",
                "updated_at"
              ]
            }
          },
          "total": {
            "type": "number"
          },
          "hasMore": {
            "type": "boolean"
          }
        },
        "notExpected": {
          "projects": {
            "type": "array of strings (field names)",
            "examples": [
              "['branch', 'created_at', 'updated_at', ...]"
            ]
          }
        }
      },
      "bugBeingTested": "Project listing was returning field names ['branch', 'created_at', ...] instead of actual project objects due to incorrect SurrealDB result parsing"
    },
    "source": "validation-harness-creation"
  },
  "budget": 1000,
  "metadata": {
    "createdAt": "2026-03-12T00:00:00Z",
    "createdBy": "validation-harness-task",
    "purpose": "Historical test case for RPC API Data Display Endpoints specification",
    "relatedSpec": "RPC API Data Display Endpoints"
  }
}
