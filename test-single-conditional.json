{
  "id": "test-single-conditional",
  "name": "Test Single Conditional",
  "description": "Test with ONE simple Handlebars conditional",
  "category": "infrastructure",
  "tasks": [
    {
      "id": "single-conditional-task",
      "subagent": "general",
      "description": "Create file with one conditional",
      "dependencies": [],
      "tools": {
        "required": [],
        "optional": [],
        "disabled": []
      },
      "prompt": {
        "template": "Create {{filename}} with:\n{{title}}\n{{#if notes}}{{notes}}{{/if}}",
        "maxTokens": 2000,
        "compressionStrategy": "none",
        "variables": [
          {
            "name": "filename",
            "type": "string",
            "required": true,
            "description": "Filename"
          },
          {
            "name": "title",
            "type": "string",
            "required": true,
            "description": "Title"
          },
          {
            "name": "notes",
            "type": "string",
            "required": false,
            "description": "Optional notes"
          }
        ]
      },
      "validation": {
        "requiredFiles": [],
        "requiredPatterns": [],
        "forbiddenPatterns": [],
        "commands": []
      },
      "retry": {
        "maxAttempts": 3,
        "strategy": "simple"
      }
    }
  ],
  "contextRequirements": [],
  "integration": {
    "preChecks": [],
    "postChecks": [],
    "qualityGates": []
  },
  "metabob": {
    "enabled": false,
    "learningMode": false,
    "targetContextTokens": 1000,
    "annotationStrategy": "failures-only"
  }
}
