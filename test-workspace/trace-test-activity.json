{
  "variant_id": "trace-test-deterministic",
  "activity_id": "trace-test",
  "variant_name": "v1-deterministic",
  "name": "Live Trace Test Activity",
  "category": "INFRASTRUCTURE",
  "description": "Deterministic activity for tracing data flow through all components (opencode → cli → backend). Uses fixed markers instead of LLM-generated content.",
  "version": 1,
  "task_steps": [
    {
      "id": "step-1-write-marker",
      "description": "Write deterministic marker file",
      "prompt": {
        "template": "Execute this command to create a trace marker:\n\necho '{{trace_id}}' > /tmp/trace-marker-{{trace_id}}.txt\n\nThen verify it was created successfully by reading it back.",
        "variables": ["trace_id"]
      },
      "expected_duration_ms": 5000,
      "validation": {
        "commands": [
          "test -f /tmp/trace-marker-{{trace_id}}.txt"
        ]
      }
    },
    {
      "id": "step-2-append-timestamp",
      "description": "Append timestamp to marker file",
      "prompt": {
        "template": "Append a timestamp to the marker file:\n\ndate +%s >> /tmp/trace-marker-{{trace_id}}.txt\n\nThen verify the file now has 2 lines.",
        "variables": ["trace_id"]
      },
      "expected_duration_ms": 5000,
      "validation": {
        "commands": [
          "test $(wc -l < /tmp/trace-marker-{{trace_id}}.txt) -eq 2"
        ]
      }
    },
    {
      "id": "step-3-verify-complete",
      "description": "Final verification of trace markers",
      "prompt": {
        "template": "Verify the trace is complete:\n\n1. Check that /tmp/trace-marker-{{trace_id}}.txt exists\n2. Verify it contains exactly 2 lines\n3. Verify the first line matches: {{trace_id}}\n\nReport SUCCESS if all checks pass.",
        "variables": ["trace_id"]
      },
      "expected_duration_ms": 5000,
      "validation": {
        "commands": [
          "test -f /tmp/trace-marker-{{trace_id}}.txt",
          "test $(wc -l < /tmp/trace-marker-{{trace_id}}.txt) -eq 2",
          "grep -q '^{{trace_id}}$' /tmp/trace-marker-{{trace_id}}.txt"
        ]
      }
    }
  ],
  "prompt_strategy": "guided",
  "context_budget_tokens": 5000,
  "expected_duration_ms": 30000,
  "expected_cost": 0.01,
  "expected_quality_score": 1.0,
  "status": "active",
  "validation": {
    "type": "command",
    "commands": [
      "test -f /tmp/trace-marker-{{trace_id}}.txt",
      "test $(wc -l < /tmp/trace-marker-{{trace_id}}.txt) -eq 2",
      "grep -q '^{{trace_id}}$' /tmp/trace-marker-{{trace_id}}.txt"
    ],
    "expected_exit_code": 0
  },
  "metadata": {
    "tags": ["test", "trace", "deterministic", "infrastructure"],
    "author": "metabob-devbob",
    "created": "2026-02-14",
    "purpose": "Validate activity execution data flow with deterministic test data"
  }
}
