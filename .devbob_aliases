# DevBob Deployment Aliases

# Standard devbob deployment (kubectx local)
alias deploy-devbob='opencode activity execute deploy-devbob-to-local-kubernetes'

# Quick kubectl shortcuts for metabob namespace
alias k='kubectl'
alias kgp='kubectl get pods -n metabob'
alias kgs='kubectl get svc -n metabob'
alias kl='kubectl logs -n metabob'
alias kd='kubectl describe -n metabob'

# Context verification
alias verify-context='kubectl config current-context'
alias use-local='kubectl config use-context docker-desktop'

# Quick access
alias devbob-shell='kubectl exec -it -n metabob deploy/devbob -- /bin/bash'
alias devbob-logs='kubectl logs -n metabob -l app.kubernetes.io/name=devbob --tail=100 -f'
alias devbob-restart='kubectl rollout restart -n metabob deploy/devbob'

