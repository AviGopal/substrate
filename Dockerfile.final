FROM metabobapp/metabob-rpc-api:0.30.2-gap9-complete-hotfix

# Add comprehensive JSON serialization helper
RUN python3 << 'PYTHON'
# Add a utility function at the top of cloud_auth.py to handle JSON serialization
with open("/src/app/server/routes/cloud_auth.py", "r") as f:
    content = f.read()

# Find the imports section and add our helper after json import
import_section = "import json"
helper_code = '''import json
from datetime import datetime
from surrealdb import RecordID

def serialize_for_json(obj):
    """Convert datetime and RecordID objects to JSON-serializable format"""
    if isinstance(obj, datetime):
        return obj.isoformat()
    elif isinstance(obj, RecordID):
        return str(obj)
    elif isinstance(obj, dict):
        return {k: serialize_for_json(v) for k, v in obj.items()}
    elif isinstance(obj, list):
        return [serialize_for_json(item) for item in obj]
    return obj
'''

content = content.replace(import_section, helper_code, 1)

# Now replace the JSONResponse call to use our helper
old_return = "return JSONResponse(status_code=status.HTTP_200_OK, content=result)"
new_return = "return JSONResponse(status_code=status.HTTP_200_OK, content=serialize_for_json(result))"
content = content.replace(old_return, new_return)

with open("/src/app/server/routes/cloud_auth.py", "w") as f:
    f.write(content)
PYTHON
