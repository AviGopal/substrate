{
  "specificationName": "sidebar-impulse-visibility",
  "harnessFile": "tests/validation-harnesses/sidebar-impulse-visibility-harness.ts",
  "testCases": [
    {
      "impulseId": "validation-sidebar-impulse-visibility-case-1",
      "name": "Basic Impulse Loading",
      "description": "Verify sidebar shows impulse count incrementing from 0/4 to 2/4 (high priority) to 3/4 (high+medium) as impulses load",
      "input": {
        "impulseCount": 4,
        "impulsePriorities": ["high", "high", "medium", "low"],
        "impulseBudgets": [1000, 1000, 1000, 1000],
        "taskCount": 0
      },
      "expectedOutput": {
        "snapshots": 3,
        "impulseProgression": ["0/4", "2/4", "3/4"],
        "utilizationProgression": ["0%", "50%", "75%"],
        "warnings": false
      }
    },
    {
      "impulseId": "validation-sidebar-impulse-visibility-case-2",
      "name": "Activity Progress Tracking",
      "description": "Verify sidebar activity section shows Task 0/5 -> 1/5 -> 2/5 -> 3/5 -> 4/5 -> 5/5 with progress bar advancing and status changing",
      "input": {
        "impulseCount": 3,
        "impulsePriorities": ["high", "medium", "low"],
        "impulseBudgets": [1000, 1000, 1000],
        "taskCount": 5
      },
      "expectedOutput": {
        "snapshots": 5,
        "taskProgression": ["1/5", "2/5", "3/5", "4/5", "5/5"],
        "progressPercentages": [20, 40, 60, 80, 100],
        "statusProgression": ["executing", "executing", "executing", "completing", "done"]
      }
    },
    {
      "impulseId": "validation-sidebar-impulse-visibility-case-3",
      "name": "Warning Thresholds (85%)",
      "description": "Verify sidebar shows warning indicator when token utilization exceeds 85% (9000/10000 = 90%)",
      "input": {
        "impulseCount": 4,
        "impulsePriorities": ["high", "high", "high", "low"],
        "impulseBudgets": [3000, 3000, 3000, 1000],
        "taskCount": 0
      },
      "expectedOutput": {
        "snapshots": 2,
        "impulseProgression": ["0/4", "3/4"],
        "utilizationProgression": ["0%", "90%"],
        "warnings": true,
        "warningThreshold": 85
      }
    },
    {
      "impulseId": "validation-sidebar-impulse-visibility-case-4",
      "name": "Incremental Loading with Activity Progress",
      "description": "Verify sidebar shows both impulse loading (0->2->3) and activity progress (0%->33%->67%->100%) simultaneously",
      "input": {
        "impulseCount": 5,
        "impulsePriorities": ["high", "high", "medium", "low", "low"],
        "impulseBudgets": [1000, 1000, 1000, 1000, 1000],
        "taskCount": 3
      },
      "expectedOutput": {
        "snapshots": 4,
        "impulseProgression": ["0/5", "2/5", "3/5", "3/5"],
        "taskProgression": ["0/3", "1/3", "2/3", "3/3"],
        "combinedValidation": true
      }
    }
  ],
  "validationCriteria": {
    "passConditions": [
      "All snapshots match expected values",
      "Impulse counts accurate (loaded/total)",
      "Token usage tracked correctly",
      "Utilization percentage within ±1% tolerance",
      "Activity progress advances correctly",
      "Task counter format is 'Task N/M'",
      "Status transitions match expected sequence",
      "Warnings appear at correct thresholds (85%)"
    ],
    "failConditions": [
      "Any snapshot mismatch",
      "Impulse count incorrect",
      "Token usage incorrect",
      "Utilization off by >1%",
      "Activity progress incorrect",
      "Task counter format wrong",
      "Status transitions incorrect",
      "Warnings missing or incorrect"
    ]
  },
  "architecture": {
    "type": "Deterministic validation harness",
    "llmRequired": false,
