# DevBob Environment Configuration

# ===== Required: LLM Provider API Keys =====
# You must provide at least one of these:
ANTHROPIC_API_KEY=sk-ant-...
# OR
OPENAI_API_KEY=sk-...

# ===== Metabob Backend Configuration =====
# Shared backend URL - CRITICAL for activity execution
# 
# IMPORTANT: Set this value based on where your Metabob backend is running
#
# Option 1: Backend on host machine (most common for development)
#   METABOB_API_URL=http://localhost:8080
#
# Option 2: Backend on remote server
#   METABOB_API_URL=http://your-server-ip:8080
#
# Option 3: Using ngrok or similar tunnel
#   METABOB_API_URL=https://your-ngrok-id.ngrok.io
#
# How configs work:
#   - HOST MACHINE: Uses this value via ./devbob config init
#     Location: ~/.opencode/opencode.json
#     Config: metabob.base_url = <this value>
#
#   - DEVBOB CONTAINERS: Use Docker network service name (auto-configured)
#     Location: configs/opencode.devbob.json (mounted at container startup)
#     Config: metabob.base_url = http://metabob-rpc-api-server:8080
#
# Quick Setup (3 steps):
#   1. Set METABOB_API_URL below (uncomment and set correct URL)
#   2. Run: source .env.devbob  (load into current shell)
#   3. Run: ./devbob config init  (creates host config)
#   4. Run: ./devbob config verify  (test connectivity)
#
METABOB_API_URL=http://localhost:8080

# Metabob API key (if required by your backend)
METABOB_API_KEY=

# Project ID for multi-agent coordination
METABOB_PROJECT_ID=devbob-multi-agent

# ===== DevBob Configuration =====
# Logging level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Boredom interval for template evolution (e.g., 4h, 24h, never)
BOREDOM_INTERVAL=4h

# Wait for backend before starting (true/false)
WAIT_FOR_BACKEND=false

# Autonomous mode (agents self-assign work)
AUTONOMOUS_MODE=false

# Work poll interval in ms (for autonomous mode)
WORK_POLL_INTERVAL=60000

# Max concurrent tasks per agent
MAX_CONCURRENT_TASKS=2

# ===== Network Configuration =====
# These are defined in docker-compose.devbob.yaml
# Uncomment to override:
# ACP_PORT_RPC_API=3001
# ACP_PORT_DASHBOARD=3002
# ACP_PORT_CLI=3003
# ACP_PORT_OPENCODE=3004
