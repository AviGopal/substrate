FROM metabobapp/metabob-rpc-api:0.30.2-gap9-complete

# Apply count query fix
RUN python3 << 'PYTHON'
with open("/src/app/server/db/operations/activity_execution.py", "r") as f:
    content = f.read()

old = """    total = 0
    if count_result and len(count_result) > 0 and len(count_result[0]) > 0:
        total = count_result[0][0].get("count", 0)"""

new = """    total = 0
    if count_result and len(count_result) > 0:
        # Handle direct dict result format (surrealdb-py v1.0+)
        if isinstance(count_result[0], dict):
            total = count_result[0].get("count", 0)
        # Handle nested list format (older versions)
        elif isinstance(count_result[0], list) and len(count_result[0]) > 0:
            total = count_result[0][0].get("count", 0)"""

content = content.replace(old, new)

with open("/src/app/server/db/operations/activity_execution.py", "w") as f:
    f.write(content)
PYTHON
