{
  "specificationName": "helmfile-deployment-pattern-with-versioned-builds",
  "harnessFile": "tests/validation-harnesses/helmfile-deployment-pattern-harness.sh",
  "testCases": [
    {
      "impulseId": "validation-helmfile-deployment-pattern-case-1",
      "name": "No Configuration Drift",
      "input": "helmfile -e local diff",
      "expectedOutput": "Exit code 0, no drift messages"
    },
    {
      "impulseId": "validation-helmfile-deployment-pattern-case-2",
      "name": "No :latest Tags in Production",
      "input": "kubectl get pods -n metabob -o json",
      "expectedOutput": "All images have explicit version tags (main-abc1234, 1.0.64)"
    },
    {
      "impulseId": "validation-helmfile-deployment-pattern-case-3",
      "name": "All Resources Managed by Helm",
      "input": "kubectl get all -n metabob -o json",
      "expectedOutput": "All resources have app.kubernetes.io/managed-by=Helm label"
    },
    {
      "impulseId": "validation-helmfile-deployment-pattern-case-4",
      "name": "No Hardcoded Credentials",
      "input": "grep patterns in helm/charts/*/values.yaml",
      "expectedOutput": "0 matches for plaintext passwords/API keys"
    },
    {
      "impulseId": "validation-helmfile-deployment-pattern-case-5",
      "name": "Istio Configuration Present (Production)",
      "input": "helm/environments/production.values.yaml",
      "expectedOutput": "Contains istio, istio.enabled, istio.mtls keys"
    },
    {
      "impulseId": "validation-helmfile-deployment-pattern-case-6",
      "name": "Stable Istio Subset Names",
      "input": "helm/charts/devbob/templates/destinationrule.yaml",
      "expectedOutput": "Uses stable/canary names, not version-based"
    },
    {
      "impulseId": "validation-helmfile-deployment-pattern-case-7",
      "name": "CI/CD GitOps Automation",
      "input": ".github/workflows/build-devbob.yml",
      "expectedOutput": "Contains update-helm-values job with yq and git commit"
    },
    {
      "impulseId": "validation-helmfile-deployment-pattern-case-8",
      "name": "CI Validation Workflow",
      "input": ".github/workflows/validate-helmfile-gitops.yml",
      "expectedOutput": "Validates kubectl, credentials, Istio antipatterns"
    },
    {
      "impulseId": "validation-helmfile-deployment-pattern-case-9",
      "name": "Kubernetes Secrets Usage",
      "input": "kubectl get deployment -n metabob -o yaml",
      "expectedOutput": "Uses valueFrom.secretKeyRef, no plaintext values"
    },
    {
      "impulseId": "validation-helmfile-deployment-pattern-case-10",
      "name": "Reproducible Deployment",
      "input": "helmfile sync twice, then diff",
      "expectedOutput": "No changes after second sync (idempotent)"
    }
  ],
  "harnessImpulseId": "harness-helmfile-deployment-pattern-with-versioned-builds",
  "validationMetadata": {
    "totalTestCases": 10,
    "environments": ["local", "production"],
    "requiredTools": ["kubectl", "helm", "helmfile", "jq"],
    "defaultEnvironment": "local",
    "defaultNamespace": "metabob",
    "skipDestructive": true,
    "exitCodes": {
      "0": "All tests passed",
      "1": "One or more tests failed",
      "2": "All tests skipped (prerequisites missing)"
    }
