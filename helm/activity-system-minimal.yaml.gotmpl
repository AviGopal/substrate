# =============================================================================
# Activity System - Minimal Deployment
# Single Helmfile for MiniBob boredom activities system
# =============================================================================
#
# Components: Valkey, SurrealDB, Activity API, Analysis API, MCP, Cloud Dashboard, MiniBob, Istio Gateway
#
# Requirements:
#   - Docker images built
#   - /etc/hosts (development):
#       127.0.0.1 app.metabob.local activity.metabob.local api.metabob.local
#       127.0.0.1 surql.metabob.local minibob.metabob.local
#   - Istio installed: istioctl install --set profile=demo -y
#   - Environment: export ANTHROPIC_API_KEY="sk-ant-..."
#
# Service Routing:
#   app.metabob.local      -> Cloud Dashboard (metabob-cloud-dashboard)
#   activity.metabob.local -> Activity API
#   api.metabob.local      -> Analysis API
#   surql.metabob.local    -> SurrealDB (dev only)
#   minibob.metabob.local  -> MiniBob vessel (dev only)
#
# Deploy (idempotent): helmfile -f helm/activity-system-minimal.yaml.gotmpl sync
# Destroy (full cleanup): helmfile -f helm/activity-system-minimal.yaml.gotmpl destroy
#
# NOTE: On destroy, PVCs are auto-cleaned by postuninstall hooks
# =============================================================================

helmDefaults:
  createNamespace: true
  wait: false
  timeout: 600
  atomic: true
  cleanupOnFail: true

repositories:
  - name: valkey
    url: https://valkey.io/valkey-helm/

releases:

  # ===========================================================================
  # VALKEY - Redis-compatible cache (in-memory, no persistence)
  # ===========================================================================
  - name: redis
    chart: valkey/valkey
    version: 0.9.3
    namespace: activity-system
    labels:
      component: infrastructure
      tier: cache
    values:
      - architecture: standalone
        auth:
          enabled: false
        image:
          registry: docker.io
          repository: valkey/valkey
          tag: "9.0.3-alpine"
          pullPolicy: Always  # Always pull latest for local development

        master:
          persistence:
            enabled: false  # In-memory only for local dev
          resources:
            requests:
              cpu: "100m"
              memory: "256Mi"
            limits:
              cpu: "500m"
              memory: "512Mi"

        service:
          type: ClusterIP
          port: 6379

        metrics:
          enabled: false

  # ===========================================================================
  # SURREALDB - Learning database with automated schema migration
  # ===========================================================================
  - name: surrealdb
    chart: ./charts/surrealdb
    namespace: activity-system
    wait: true  # Wait for migration Job to complete before marking ready
    timeout: 900  # 15 minutes for database + migration
    labels:
      component: infrastructure
      tier: database
    hooks:
      # Clean up PVCs on destroy (StatefulSet PVCs are NOT auto-deleted by Helm)
      - events: ["postuninstall"]
        showlogs: true
        command: "kubectl"
        args:
          - "delete"
          - "pvc"
          - "-n"
          - "activity-system"
          - "-l"
          - "app=surrealdb"
          - "--ignore-not-found=true"
      # Clean up any orphaned migration jobs
      - events: ["postuninstall"]
        showlogs: true
        command: "kubectl"
        args:
          - "delete"
          - "jobs"
          - "-n"
          - "activity-system"
          - "-l"
          - "app.kubernetes.io/component=migration"
          - "--ignore-not-found=true"
    values:
      - name: surrealdb
        namespace: activity-system
        image:
          repository: surrealdb/surrealdb
          tag: "v3.0.0"
          pullPolicy: Always  # Always pull latest for local development
        service:
          type: ClusterIP
          port: 8000
        resources:
          requests:
            memory: "512Mi"
            cpu: "250m"
          limits:
            memory: "2Gi"
            cpu: "1000m"
        persistence:
          enabled: true
          storageClass: ""
          size: 10Gi
        database:
          namespace: activity-system
          name: learning_loop
          storage:
            backend: file
            path: /data/surrealdb
        auth:
          username: {{ env "SURREALDB_USERNAME" | default "root" }}
          password: {{ env "SURREALDB_PASSWORD" | default "surrealdb-local-dev-123" }}
        healthCheck:
          enabled: true
          path: /health
          port: 8000
        # Schema migration (runs after SurrealDB is ready)
        migration:
          enabled: true  # Enable automated schema deployment
          image:
            repository: metabobapp/metabob-activity-api
            tag: "latest"
            pullPolicy: IfNotPresent
    needs:
      - activity-system/redis

  # ===========================================================================
  # METABOB ACTIVITY API - Backend for activity management
  # ===========================================================================
  - name: metabob-activity-api
    chart: ./charts/metabob-activity-api
    namespace: activity-system
    labels:
      component: api
      tier: application
    values:
      - replicaCount: 2
        image:
          repository: metabobapp/metabob-activity-api
          pullPolicy: IfNotPresent
          tag: "latest"
        service:
          type: ClusterIP
          port: 8080
          targetPort: 8080
          name: http
        config:
          port: 8080
          host: "0.0.0.0"
          surrealdb:
            url: "http://surrealdb.activity-system.svc.cluster.local:8000"
            namespace: "activity-system"
            database: "learning_loop"
            username: {{ env "SURREALDB_USERNAME" | default "root" }}
            password: {{ env "SURREALDB_PASSWORD" | default "surrealdb-local-dev-123" }}
          redis:
            url: "redis://redis-valkey.activity-system.svc.cluster.local:6379"
            sessionTtl: 86400
            templateTtl: 3600
            metricsTtl: 300
          auth:
            requireAuth: false
          logLevel: "info"
          logFormat: "json"
          corsOrigins: "*"
        resources:
          limits:
            cpu: 1000m
            memory: 1Gi
          requests:
            cpu: 250m
            memory: 512Mi
        livenessProbe:
          httpGet:
            path: /health
            port: http
          initialDelaySeconds: 30
          periodSeconds: 10
          timeoutSeconds: 5
          failureThreshold: 3
        readinessProbe:
          httpGet:
            path: /health
            port: http
          initialDelaySeconds: 10
          periodSeconds: 5
          timeoutSeconds: 3
          failureThreshold: 3
    needs:
      - activity-system/redis
      - activity-system/surrealdb

  # ===========================================================================
  # METABOB ANALYSIS API - Code analysis, auth, projects, problems
  # ===========================================================================
  - name: metabob-analysis-api
    chart: ./charts/metabob-analysis-api
    namespace: activity-system
    labels:
      component: api
      tier: application
    values:
      - replicaCount: 1
        image:
          repository: metabobapp/metabob-analysis-api
          pullPolicy: IfNotPresent
          tag: "latest"
        service:
          type: ClusterIP
          port: 8080
          targetPort: 8080
          name: http
        config:
          port: 8080
          host: "0.0.0.0"
          surrealdb:
            url: "http://surrealdb.activity-system.svc.cluster.local:8000"
            namespace: "activity-system"
            database: "learning_loop"
            username: {{ env "SURREALDB_USERNAME" | default "root" }}
            password: {{ env "SURREALDB_PASSWORD" | default "surrealdb-local-dev-123" }}
          redis:
            url: "redis://redis-valkey.activity-system.svc.cluster.local:6379"
          jwt:
            secret: "metabob-jwt-secret-key-change-in-production"
            expiresIn: "12h"
          logLevel: "info"
          corsOrigins: "*"
        resources:
          limits:
            cpu: 500m
            memory: 512Mi
          requests:
            cpu: 100m
            memory: 256Mi
        livenessProbe:
          httpGet:
            path: /health
            port: http
          initialDelaySeconds: 30
          periodSeconds: 10
          timeoutSeconds: 5
          failureThreshold: 3
        readinessProbe:
          httpGet:
            path: /health
            port: http
          initialDelaySeconds: 10
          periodSeconds: 5
          timeoutSeconds: 3
          failureThreshold: 3
    needs:
      - activity-system/redis
      - activity-system/surrealdb

  # ===========================================================================
  # METABOB MCP - MCP server interface for coding agents
  # ===========================================================================
  - name: metabob-mcp
    chart: ./charts/metabob-mcp
    namespace: activity-system
    labels:
      component: api
      tier: interface
    values:
      - replicaCount: 1
        image:
          repository: metabobapp/metabob-mcp
          pullPolicy: IfNotPresent
          tag: "latest"
        service:
          type: ClusterIP
          port: 8080
          targetPort: 8080
          name: http
        config:
          analysisApiUrl: "http://metabob-analysis-api.activity-system.svc.cluster.local:8080"
          sessionId: "mcp-server-session"
          logLevel: "info"
          healthPort: 8080
          maxRequestsPerMinute: 60
        resources:
          limits:
            cpu: 200m
            memory: 256Mi
          requests:
            cpu: 50m
            memory: 128Mi
        livenessProbe:
          httpGet:
            path: /health
            port: http
          initialDelaySeconds: 30
          periodSeconds: 10
          timeoutSeconds: 5
          failureThreshold: 3
        readinessProbe:
          httpGet:
            path: /health
            port: http
          initialDelaySeconds: 10
          periodSeconds: 5
          timeoutSeconds: 3
          failureThreshold: 3
    needs:
      - activity-system/metabob-analysis-api

  # ===========================================================================
  # MINIBOB - AI agent for boredom activities
  # ===========================================================================
  - name: minibob
    chart: ./charts/devbob
    namespace: activity-system
    labels:
      component: vessel
      tier: agent
    hooks:
      # Clean up workspace PVCs on destroy
      - events: ["postuninstall"]
        showlogs: true
        command: "kubectl"
        args:
          - "delete"
          - "pvc"
          - "-n"
          - "activity-system"
          - "-l"
          - "app.kubernetes.io/name=minibob"
          - "--ignore-not-found=true"
    values:
      - replicaCount: 3  # Need 3+ for cluster mode and boredom polling
        image:
          repository: metabobapp/minibob
          pullPolicy: IfNotPresent
          tag: "latest"

        # MiniBob runs with Bun, not opencode
        command:
          - bun
        args:
          - run
          - index.ts

        service:
          type: ClusterIP
          port: 8080
          targetPort: 8080
        env:
          metabobApiUrl: "http://metabob-activity-api.activity-system.svc.cluster.local:8080"
          minibobMcpEndpoint: "http://metabob-activity-api.activity-system.svc.cluster.local:8080"
          minibobServiceName: "minibob-devbob-cluster.activity-system.svc.cluster.local"
          surrealHost: "surrealdb.activity-system.svc.cluster.local"
          surrealPort: "8000"
          surrealUser: {{ env "SURREALDB_USERNAME" | default "root" | quote }}
          surrealPass: {{ env "SURREALDB_PASSWORD" | default "surrealdb-local-dev-123" | quote }}
          surrealNamespace: "activity-system"
          surrealDatabase: "learning_loop"
          llmProvider: {{ env "LLM_PROVIDER" | default "anthropic" | quote }}
          llmModel: {{ env "LLM_MODEL" | default "claude-sonnet-4-20250514" | quote }}
          waitForBackend: "true"
          skipConfig: "false"
          logLevel: "INFO"
          home: "/workspace"
          gitUserName: "MiniBob Agent"
          gitUserEmail: "minibob@metabob.local"

        # LLM API Key from environment
        secrets:
          existingSecret: minibob-api-keys
          anthropicApiKeyKey: anthropic-api-key
          githubTokenKey: github-token

        resources:
          limits:
            cpu: 1000m
            memory: 1Gi
          requests:
            cpu: 250m
            memory: 512Mi

        persistence:
          enabled: true
          storageClass: ""
          size: 10Gi
          mountPath: /workspace

        # Disable shared repos PVC for local dev (requires ReadWriteMany)
        repositories:
          persistence:
            enabled: false

        livenessProbe:
          enabled: true
          httpGet:
            path: /health
            port: 8080
          initialDelaySeconds: 30
          periodSeconds: 10
          failureThreshold: 3

        readinessProbe:
          enabled: true
          httpGet:
            path: /health
            port: 8080
          initialDelaySeconds: 10
          periodSeconds: 5
          failureThreshold: 3

        podAnnotations:
          minibob.metabob.com/boredom-enabled: "true"
          minibob.metabob.com/boredom-poll-interval: "30000"
          minibob.metabob.com/boredom-idle-threshold: "60000"
          minibob.metabob.com/capabilities: "activities,impulses,git,boredom,learning"
    needs:
      - activity-system/metabob-activity-api

  # ===========================================================================
  # METABOB CLOUD DASHBOARD - User-facing React UI
  # ===========================================================================
  - name: metabob-cloud-dashboard
    chart: ./charts/metabob-cloud-dashboard
    namespace: activity-system
    labels:
      component: ui
      tier: frontend
    values:
      - replicaCount: 1
        image:
          repository: metabobapp/metabob-cloud-dashboard
          pullPolicy: IfNotPresent
          tag: "latest"
        service:
          type: ClusterIP
          port: 3000
          targetPort: 3000
        config:
          analysisApiUrl: "http://metabob-analysis-api.activity-system.svc.cluster.local:8080"
          activityApiUrl: "http://metabob-activity-api.activity-system.svc.cluster.local:8080"
          port: 3000
        resources:
          limits:
            cpu: 500m
            memory: 512Mi
          requests:
            cpu: 100m
            memory: 256Mi
        livenessProbe:
          httpGet:
            path: /health
            port: http
          initialDelaySeconds: 10
          periodSeconds: 10
          failureThreshold: 3
        readinessProbe:
          httpGet:
            path: /health
            port: http
          initialDelaySeconds: 5
          periodSeconds: 5
          failureThreshold: 3
    needs:
      - activity-system/metabob-analysis-api
      - activity-system/metabob-activity-api

  # ===========================================================================
  # METABOB INTERNAL DASHBOARD - Development observability UI
  # ===========================================================================
  - name: metabob-internal-dashboard
    chart: ./charts/metabob-internal-dashboard
    namespace: activity-system
    labels:
      component: ui
      tier: frontend
    values:
      - replicaCount: 1
        image:
          repository: metabobapp/metabob-internal-dashboard
          pullPolicy: IfNotPresent
          # tag is set by pre-commit hook in values.yaml - don't override here
        service:
          type: ClusterIP
          port: 3001
        minibob:
          apiUrl: "http://metabob-activity-api.activity-system.svc.cluster.local:8080"
        resources:
          limits:
            cpu: 500m
            memory: 512Mi
          requests:
            cpu: 100m
            memory: 256Mi
        probes:
          liveness:
            path: /health
            initialDelaySeconds: 10
            periodSeconds: 30
          readiness:
            path: /health
            initialDelaySeconds: 5
            periodSeconds: 10
    needs:
      - activity-system/metabob-activity-api

  # ===========================================================================
  # ISTIO GATEWAY - DRY Networking Configuration
  # ===========================================================================
  # Environment-based routing (domain set by environment variable):
  #   Development: *.metabob.local
  #   Production:  *.metabob.com
  #
  # Service Mapping:
  #   app.{domain}      -> metabob-cloud-dashboard    (dev+prod)
  #   activity.{domain} -> metabob-activity-api      (dev+prod)
  #   api.{domain}      -> metabob-analysis-api      (dev+prod)
  #   internal.{domain} -> internal-dashboard        (dev only)
  #   surql.{domain}    -> surrealdb                 (dev only)
  #
  # Internal only (no external access):
  #   valkey/redis - cluster internal only
  # ===========================================================================
  - name: istio-gateway
    chart: ./charts/istio-gateway
    namespace: activity-system
    labels:
      component: networking
      tier: infrastructure
    values:
      - environment: development  # Switch to "production" for prod deployment

        # Service configuration (inherits defaults from chart values.yaml)
        # Only override what differs from defaults
        services:
          # Cloud Dashboard - user-facing SaaS UI
          dashboard:
            service: metabob-cloud-dashboard
            # enabled: dev=true, prod=true (from defaults)

          # Activity API - learning system backend
          # activity: uses defaults (metabob-activity-api:8080)

          # Analysis API - code analysis backend
          # analysis: uses defaults (metabob-analysis-api:8080)

          # SurrealDB - dev access only
          surrealdb:
            enabled:
              development: true
              production: false

          # Internal Dashboard - dev access only
          internal:
            enabled:
              development: true
              production: false

        metrics:
          enabled: true
          prometheus:
            enabled: true

        istioInjection:
          enabled: true
    needs:
      - activity-system/metabob-cloud-dashboard
      - activity-system/metabob-activity-api
