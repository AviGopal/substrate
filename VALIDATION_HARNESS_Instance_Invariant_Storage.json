{
  "specificationName": "Instance Invariant Storage for Impulses and Activities",
  "harnessFile": "tests/validation-harnesses/instance-invariant-storage-harness-v2.ts",
  "harnessVersion": "2.0",
  "created": "2026-02-28T08:20:00.000Z",
  
  "overview": {
    "purpose": "Validate instance-invariant storage architecture for impulses and activities",
    "validationStrategy": "Execute persistence tests across simulated instances, verify vessel flow compliance, validate multi-tenant isolation",
    "nonLLM": true,
    "automatedPassFail": true
  },
  
  "testCases": [
    {
      "impulseId": "validation-Instance Invariant Storage for Impulses and Activities-case-1",
      "name": "Cross-instance impulse access",
      "description": "Instance A creates impulse, Instance B retrieves it with same credentials",
      "input": {
        "instanceA": { "action": "create", "impulseId": "test-impulse-cross-instance" },
        "instanceB": { "action": "retrieve", "impulseId": "test-impulse-cross-instance" },
        "credentials": { "apiKey": "test_tenant_a_key", "projectId": "project_alpha" }
      },
      "expectedOutput": {
        "impulseCreated": true,
        "impulseRetrieved": true,
        "dataConsistent": true
      },
      "validator": "validateCrossInstanceImpulseAccess",
      "vesselFlow": [
        "opencode → metabob_impulse_store (MCP)",
        "metabob-cli → POST /v2/impulses (REST)",
        "metabob-rpc-api → SurrealDB",
        "Instance B → GET /v2/impulses/{id} (REST)",
        "SurrealDB → metabob-rpc-api → Instance B"
      ]
    },
    {
      "impulseId": "validation-Instance Invariant Storage for Impulses and Activities-case-2",
      "name": "Multi-tenant isolation",
      "description": "Different tenants cannot access each other's data",
      "input": {
        "tenantA": { "apiKey": "test_tenant_a_key", "impulseId": "shared-name" },
        "tenantB": { "apiKey": "test_tenant_b_key", "impulseId": "shared-name" }
      },
      "expectedOutput": {
        "tenantASeesOwnData": true,
        "tenantBSeesOwnData": true,
        "crossTenantAccessBlocked": true
      },
      "validator": "validateMultiTenantIsolation"
    },
    {
      "impulseId": "validation-Instance Invariant Storage for Impulses and Activities-case-3",
      "name": "Vessel boundary enforcement",
      "description": "Opencode doesn't directly import rpc-api modules",
      "input": {
        "checkFor": "direct imports of metabob-rpc-api in opencode"
      },
      "expectedOutput": {
        "directImports": 0,
        "vesselFlowRespected": true
      },
      "validator": "validateVesselBoundaryEnforcement"
    },
    {
      "impulseId": "validation-Instance Invariant Storage for Impulses and Activities-case-4",
      "name": "Backend persistence validation",
      "description": "Data persists in backend and survives cache clear",
      "input": {
        "scenario": "create → clear cache → retrieve"
      },
      "expectedOutput": {
        "persisted": true,
        "retrievable": true,
        "dataIntact": true
      },
      "validator": "validateBackendPersistence"
    },
    {
      "impulseId": "validation-Instance Invariant Storage for Impulses and Activities-case-5",
      "name": "Activity cross-instance load",
      "description": "Activity saved on Instance A is loadable from Instance B",
      "input": {
        "instanceA": { "action": "save", "activityId": "test-activity-cross-instance" },
        "instanceB": { "action": "load", "activityId": "test-activity-cross-instance", "localCacheMiss": true }
      },
      "expectedOutput": {
        "activitySaved": true,
        "activityLoaded": true,
        "dataConsistent": true,
        "backendFallbackWorked": true
      },
      "validator": "validateActivityCrossInstanceLoad"
    }
  ],
  
  "architecture": {
    "vesselLayers": [
      {
        "layer": 1,
        "name": "metabob-opencode",
        "language": "TypeScript",
        "role": "Client - initiates storage requests",
        "components": ["ImpulseCreateTool", "Activity.save", "Activity.load"]
      },
      {
        "layer": 2,
        "name": "metabob-cli",
        "language": "Python",
        "role": "MCP middleware - adds auth, routes to backend",
        "components": ["metabob_impulse_store", "metabob_activity_save", "metabob_activity_load"]
      },
      {
        "layer": 3,
        "name": "metabob-rpc-api",
        "language": "Python",
        "role": "REST API - validates, enforces multi-tenant isolation",
        "components": ["POST /v2/impulses", "GET /v2/impulses/{id}", "POST /v2/activities", "GET /v2/activities/{id}"]
      },
      {
        "layer": 4,
        "name": "SurrealDB",
        "language": "SQL",
        "role": "Persistence - executes queries with composite key isolation",
        "components": ["impulse_data table", "activity_data table"]
      }
    ],
    "cacheStrategy": {
      "pattern": "Write-through cache with backend fallback",
      "localCache": "Storage.ts (opencode) - fast, instance-local",
      "authoritativeSource": "SurrealDB (rpc-api) - source of truth, instance-invariant",
      "fallbackBehavior": "Activity.load tries local first, falls back to backend if missing"
    },
    "multiTenantIsolation": {
      "scopingKeys": ["api_key", "project_id"],
      "enforcementLayers": [
        "Layer 2: MCP tools extract api_key from config",
        "Layer 3: REST endpoints validate X-API-Key header",
        "Layer 4: DB operations include api_key in WHERE clauses"
      ]
    }
  },
  
  "runInstructions": {
    "command": "tsx tests/validation-harnesses/instance-invariant-storage-harness-v2.ts",
    "prerequisites": [
      "metabob-rpc-api running on localhost:8000",
      "metabob-cli installed and configured",
      "SurrealDB running with devbob namespace",
      "Node.js 18+ with tsx"
    ],
    "environment": {
      "METABOB_API_KEY": "your_api_key (default: test_tenant_a_key)",
      "METABOB_RPC_URL": "http://localhost:8000 (backend URL)",
      "CLI_MCP_PORT": "3000 (CLI MCP server port)"
    },
    "expectedExitCode": {
      "success": 0,
      "failure": 1
    }
  },
  
