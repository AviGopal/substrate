# DevBob Kubernetes Deployment Secrets
# Copy this file to .env (which is gitignored) and fill in actual values
# These secrets are used by deploy-devbob-k8s-git.sh to create Kubernetes secrets

# Anthropic API Key (required for Claude LLM)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# GitHub Personal Access Token (required for git operations and PR management)
# Get from: https://github.com/settings/tokens (or `gh auth token`)
# Required scopes: repo, workflow
GITHUB_TOKEN=ghp_your-token-here

# Git user configuration (for commits)
GIT_USER_NAME="Devbob Agent"
GIT_USER_EMAIL="devbob@metabob.local"

# Usage:
#   source .env
#   ./deploy-devbob-k8s-git.sh
