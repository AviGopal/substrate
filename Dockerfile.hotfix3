FROM metabobapp/metabob-rpc-api:0.30.2-gap9-complete-hotfix

# Fix RecordID JSON serialization by using str() conversion
RUN python3 << 'PYTHON'
with open("/src/app/server/db/operations/activity_execution.py", "r") as f:
    lines = f.readlines()

# Find the activity dict construction and wrap the id field with str()
new_lines = []
i = 0
while i < len(lines):
    line = lines[i]
    # Look for the id line in activity dict
    if '"id": execution.get("id", execution.get("activity_id")),' in line:
        # Replace with str() wrapper
        indent = len(line) - len(line.lstrip())
        spaces = ' ' * indent
        new_lines.append(f'{spaces}"id": str(execution.get("id") or execution.get("activity_id")),\n')
    else:
        new_lines.append(line)
    i += 1

with open("/src/app/server/db/operations/activity_execution.py", "w") as f:
    f.writelines(new_lines)
PYTHON
