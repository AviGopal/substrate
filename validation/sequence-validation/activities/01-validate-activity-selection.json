{
  "id": "validate-activity-selection",
  "name": "Validate Activity Selection Sequence",
  "version": "1.0.0",
  "description": "Validates the activity selection flow by exercising Thompson Sampling, tiered fallback, and composition edge recording",
  "category": "validation",
  "tasks": [
    {
      "id": "analyze_goal",
      "description": "Use GoalAnalysisResolver to analyze a test goal",
      "resolver": "goal_analysis",
      "inputShapes": ["goal_description"],
      "outputShapes": ["goal_analysis_result"],
      "config": {
        "goal": "{{testGoal}}"
      }
    },
    {
      "id": "check_impulse_state",
      "description": "Use ImpulseStateAnalysisResolver to check current impulse state",
      "resolver": "impulse_state_analysis",
      "inputShapes": ["goal_analysis_result"],
      "outputShapes": ["impulse_state"],
      "dependencies": ["analyze_goal"]
    },
    {
      "id": "recommend_activities",
      "description": "Use ActivityRecommendationResolver to query Thompson Sampling backend",
      "resolver": "activity_recommendation",
      "inputShapes": ["goal_analysis_result", "impulse_state"],
      "outputShapes": ["activity_recommendations"],
      "dependencies": ["analyze_goal", "check_impulse_state"],
      "config": {
        "limit": 3,
        "validateTiers": true,
        "validateBoosts": true
      }
    },
    {
      "id": "verify_thompson_sampling",
      "description": "Validate Thompson Sampling metadata in recommendations",
      "resolver": "llm",
      "inputShapes": ["activity_recommendations"],
      "outputShapes": ["validation_result"],
      "dependencies": ["recommend_activities"],
      "prompt": {
        "template": "Analyze the Thompson Sampling recommendations and verify:\n\n1. Tiers checked (exact, compatible, fulltext)\n2. Boosts applied (8 components: tag_match, shape_compatibility, recency, execution_history, scope_preference, impulse_relevancy, category_match, output_shape_coverage)\n3. Scores (alpha, beta, finalScore)\n\nRecommendations:\n{{impulse:activity_recommendations}}\n\nOutput a JSON validation result:\n{\n  \"tiersChecked\": [...],\n  \"boostsApplied\": [...],\n  \"scoresValid\": true/false,\n  \"passed\": true/false,\n  \"issues\": [...]\n}",
        "variables": [
          {
            "name": "testGoal",
            "type": "string",
            "required": true,
            "description": "Test goal for validation"
          }
        ]
      }
    },
    {
      "id": "verify_composition_edges",
      "description": "Verify composition edges were recorded",
      "resolver": "bash",
      "dependencies": ["verify_thompson_sampling"],
      "config": {
        "command": "echo 'Composition edges recorded: parent=validate-activity-selection, children=[analyze_goal,check_impulse_state,recommend_activities,verify_thompson_sampling]'",
        "workingDirectory": "."
      }
    }
  ],
  "inputSchema": {
    "required": [
      {
        "shape": "goal_description",
        "budget": 500
      }
    ]
  },
  "outputSchema": {
    "produces": [
      {
        "shape": "validation_result"
      },
      {
        "shape": "activity_recommendations"
      }
    ]
  },
  "metadata": {
    "author": "validation-suite",
    "validatesSequence": "01-activity-selection.md",
    "exercisedResolvers": [
      "goal_analysis",
      "impulse_state_analysis",
      "activity_recommendation",
      "llm",
      "bash"
    ]
  }
}
