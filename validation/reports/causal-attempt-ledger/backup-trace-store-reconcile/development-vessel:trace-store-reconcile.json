  "tasks": [
    {
      "config": {
        "holder": "trace-store-reconcile",
        "op": "acquire",
        "ttl_ms": 900000,
        "type": "maintenanceLease_write"
      },
      "description": "Acquire the maintenance lease for this reconcile run. Refuses (acquired: false) if a different holder already holds an unexpired lease.",
      "id": "acquire_lease",
      "outputShapes": [
        "maintenanceLeaseWriteResult"
      ],
      "resolver": "maintenanceLease_write"
    },
    {
      "config": {
        "json": "{{acquire_lease_text}}",
        "path": "token",
        "type": "json_path_extract"
      },
      "description": "Pull the acquired lease's token out of acquire_lease's JSON output so it can be threaded into the db_admin call and the release call below.",
      "id": "extract_lease_token",
      "outputShapes": [
        "json_extracted_value"
      ],
      "resolver": "json_path_extract"
    },
    {
      "config": {
        "body": "{\"pointer\":{\"type\":\"db_admin\",\"operation\":\"reconcile_trace_store\",\"dry_run\":false,\"lease_token\":\"{{extract_lease_token_text}}\"},\"budget\":1000}",
        "failOnNon2xx": true,
        "headers": {
          "Content-Type": "application/json"
        },
        "method": "POST",
        "type": "http_fetch",
        "url": "http://127.0.0.1:8080/v2/impulses/resolve"
      },
      "description": "Invoke activity-api's db_admin reconcile_trace_store op (live run, not dry_run) with the acquired lease token. activity-api validates the token against the same /workspace/leases/maintenance.json file before executing the copy-forward swap.",
      "id": "reconcile",
      "outputShapes": [
        "httpResponse"
      ],
      "resolver": "http_fetch"
    },
    {
      "config": {
        "dry_run": true,
        "type": "trace_store_health_observer"
      },
      "description": "Re-read the traceStore counters (dry_run so this check itself never re-emits a gap) and assert row_count <= cap post-swap.",
      "id": "verify",
      "outputShapes": [
        "traceStoreHealthReport"
      ],
      "resolver": "trace_store_health_observer",
      "validation": {
        "forbiddenPatterns": [
          "\"over_cap\":true"
        ]
      }
    },
    {
      "config": {
        "op": "release",
        "token": "{{extract_lease_token_text}}",
        "type": "maintenanceLease_write"
      },
      "description": "Release the maintenance lease using the same token acquired above.",
      "id": "release_lease",
      "outputShapes": [
        "maintenanceLeaseWriteResult"
      ],
      "resolver": "maintenanceLease_write"
    }
  ],
