{
  "vessels": [
    {
      "name": "records-vessel",
      "description": "walk-vessel SPEC-V3 records: authenticated append-only rows, episodes, waits, posterior fold.",
      "repo": "records-vessel",
      "workdir": "$RUNTIME",
      "exec": "src/index.ts",
      "restart": "on-failure",
      "health_port": 8510,
      "secrets": [],
      "env": {
        "RECORDS_VESSEL_ID": "records-vessel",
        "RECORDS_PORT": "8510",
        "DISCOVERY_URL": "http://127.0.0.1:8100",
        "RECORDS_ENDPOINT": "http://127.0.0.1:8510",
        "RECORDS_DATA_DIR": "/workspace/substrate/records-vessel"
      }
    },
    {
      "name": "described-shape-vessel",
      "description": "walk-vessel SPEC-V3 described-shape: produces any shape with a shape_schema row through the channel the walk chose.",
      "repo": "described-shape-vessel",
      "workdir": "$RUNTIME",
      "exec": "src/index.ts",
      "restart": "on-failure",
      "health_port": 8520,
      "secrets": [],
      "env": {
        "DESCRIBED_VESSEL_ID": "described-shape-vessel",
        "DESCRIBED_PORT": "8520",
        "DISCOVERY_URL": "http://127.0.0.1:8100",
        "DESCRIBED_ENDPOINT": "http://127.0.0.1:8520"
      }
    },
    {
      "name": "walk-vessel",
      "description": "walk-vessel SPEC-V3 walk (treated arm): one chosen call in flight, Thompson draw, recorded selections.",
      "repo": "walk-vessel",
      "workdir": "$RUNTIME",
      "exec": "src/index.ts",
      "restart": "on-failure",
      "health_port": 8530,
      "secrets": [],
      "env": {
        "WALK_VESSEL_ID": "walk-vessel",
        "WALK_PORT": "8530",
        "DISCOVERY_URL": "http://127.0.0.1:8100",
        "WALK_ENDPOINT": "http://127.0.0.1:8530"
      }
    }
  ]
}
