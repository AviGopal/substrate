# Minimal Claude Code container for the validation harness.
#
# Anthropic publishes a devcontainer Dockerfile at
# https://github.com/anthropics/claude-code/blob/main/.devcontainer/Dockerfile
# but no pre-built public image (as of 2026-04). Their devcontainer is
# dev-machine-shaped (zsh, iptables, NET_ADMIN, GitHub CLI). We want a small
# headless runner — just node + claude + git.
#
# See docs/CLAUDE_CODE_CONTAINER.md for the rationale.

FROM node:20-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates curl jq \
    && rm -rf /var/lib/apt/lists/*

# Pin the Claude Code CLI version via build arg (default: latest).
ARG CLAUDE_CODE_VERSION=latest
RUN npm install -g @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}

# Run as a non-root user — Claude Code refuses
# `--dangerously-skip-permissions` when invoked as root for safety reasons.
# node:20-slim ships with a `node` user (uid 1000); reuse it.
RUN mkdir -p /workspace && chown -R node:node /workspace
USER node
WORKDIR /workspace

# A safe default git identity so `claude` can stage commits without prompting.
RUN git config --global user.email "claude-code@validation.local" \
 && git config --global user.name  "Claude Code (validation harness)"

# The orchestrator overrides CMD with the actual prompt invocation.
# Headless invocation reference: `claude -p "<prompt>" --output-format stream-json`.
CMD ["claude", "--help"]
