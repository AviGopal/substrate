{
  "specificationName": "template-loading-persistence",
  "harnessFile": "tests/validation-harnesses/template-loading-persistence-harness.ts",
  "harnessImpulseId": "harness-template-loading-persistence",
  "validationStrategy": "Clear Redis, query API, verify templates returned",
  "testCases": [
    {
      "impulseId": "validation-template-loading-persistence-case-1",
      "name": "Basic Template Persistence",
      "input": {
        "templateName": "Test Template Persistence",
        "templateCategory": "feature",
        "rpcApiUrl": "http://localhost:8000"
      },
      "expectedOutput": {
        "templateCreated": true,
        "existsInSurrealDB": true,
        "existsInRedisBeforeClear": true,
        "redisCleared": true,
        "loadedAfterClear": true,
        "existsInRedisAfterClear": true,
        "cacheRepopulated": true
      }
    },
    {
      "impulseId": "validation-template-loading-persistence-case-2",
      "name": "TTL Expiration Recovery",
      "input": {
        "templateName": "Test Template TTL Expiration",
        "templateCategory": "bugfix",
        "rpcApiUrl": "http://localhost:8000"
      },
      "expectedOutput": {
        "templateCreated": true,
        "existsInSurrealDB": true,
        "existsInRedisBeforeClear": true,
        "redisCleared": true,
        "loadedAfterClear": true,
        "existsInRedisAfterClear": true,
        "cacheRepopulated": true
      }
    },
    {
      "impulseId": "validation-template-loading-persistence-case-3",
      "name": "Multiple Templates Persistence",
      "input": {
        "templateCount": 5,
        "templateNamePrefix": "Test Template Multi",
        "templateCategory": "refactor",
        "rpcApiUrl": "http://localhost:8000"
      },
      "expectedOutput": {
        "allTemplatesCreated": true,
        "allExistInSurrealDB": true,
        "allExistInRedisBeforeClear": true,
        "redisCleared": true,
        "allLoadedAfterClear": true,
        "allExistInRedisAfterClear": true,
        "allCachesRepopulated": true
      }
    }
  ],
  "usage": {
    "cli": "tsx tests/validation-harnesses/template-loading-persistence-harness.ts",
    "programmatic": "import { runValidation } from './template-loading-persistence-harness'; await runValidation(input);",
    "cicd": "npm run test:validation:template-persistence || exit 1"
  },
  "environmentVariables": {
    "TEMPLATE_NAME": "Name of test template (default: 'Test Template Persistence')",
    "TEMPLATE_CATEGORY": "Template category: feature|bugfix|refactor|tool|infrastructure (default: 'feature')",
    "RPC_API_URL": "RPC API URL (default: 'http://localhost:8000')",
    "KUBECTL_CONTEXT": "Kubectl context for K8s commands (optional)"
  },
  "exitCodes": {
    "0": "PASS - All checks passed",
    "1": "FAIL - One or more checks failed"
  },
  "validationSteps": [
    "Create test template via RPC API POST /v2/activities/templates",
    "Verify template exists in SurrealDB",
    "Verify template cached in Redis",
    "Clear Redis cache (FLUSHDB)",
    "Load template via RPC API GET /v2/activities/templates/{id}",
    "Verify template loaded successfully (HTTP 200)",
    "Verify Redis cache repopulated",
    "Verify logs show cache miss → SurrealDB fallback"
  ],
  "prerequisites": {
    "runtime": ["Node.js v18+", "TypeScript (tsx or ts-node)", "kubectl CLI", "curl"],
    "k8s": ["redis pod (deployment/redis)", "surrealdb pod (deployment/surreal)", "rpc-api pod (running)"],
    "network": ["Access to RPC API (HTTP)", "Access to K8s cluster (kubectl)"]
  },
  "documentation": {
    "readme": "tests/validation-harnesses/README.md",
    "specification": "surrealdb-primary-redis-cache",
    "traceAnalysis": "TRACE_TEMPLATE_LOADING_PERSISTENCE.md",
    "enforcementSummary": "ENFORCEMENT_TEMPLATE_LOADING_PERSISTENCE.md"
  }
}
