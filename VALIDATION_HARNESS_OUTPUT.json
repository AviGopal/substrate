{
  "specificationName": "Database Schema Initialization - Automatic Schema Creation on Fresh Deployment",
  "harnessFile": "tests/validation-harnesses/schema-init-harness.sh",
  "readmeFile": "tests/validation-harnesses/README-schema-init.md",
  "testCases": [
    {
      "impulseId": "validation-schema-init-case-1",
      "name": "Verify initSchema enabled",
      "input": "charts/surrealdb/values/default.surrealdb.values.yaml",
      "expectedOutput": "initSchema.enabled: true"
    },
    {
      "impulseId": "validation-schema-init-case-2",
      "name": "Verify Deployment args",
      "input": "charts/surrealdb/charts/templates/deployment.yaml",
      "expectedOutput": "Args include --ns and --db flags"
    },
    {
      "impulseId": "validation-schema-init-case-3",
      "name": "Verify StatefulSet args",
      "input": "charts/surrealdb/charts/templates/statefulset.yaml",
      "expectedOutput": "Args include --ns and --db flags"
    },
    {
      "impulseId": "validation-schema-init-case-4",
      "name": "Clean deployment succeeds",
      "input": "helmfile destroy && helmfile apply",
      "expectedOutput": "Exit code 0"
    },
    {
      "impulseId": "validation-schema-init-case-5",
      "name": "init-schema Job exists",
      "input": "kubectl get jobs -n metabob",
      "expectedOutput": "Job *init-schema* found"
    },
    {
      "impulseId": "validation-schema-init-case-6",
      "name": "Job completes successfully",
      "input": "kubectl wait --for=condition=complete",
      "expectedOutput": "status.succeeded=1 within 5min"
    },
    {
      "impulseId": "validation-schema-init-case-7",
      "name": "Job logs show success",
      "input": "kubectl logs job/init-schema",
      "expectedOutput": "Schema initialization successful, 13/13 tables"
    },
    {
      "impulseId": "validation-schema-init-case-8",
      "name": "SurrealDB pod running",
      "input": "kubectl get pods -l app=surrealdb",
      "expectedOutput": "Pod ready within 2min"
    },
    {
      "impulseId": "validation-schema-init-case-9",
      "name": "All 13 tables exist",
      "input": "surreal sql 'INFO FOR DB;'",
      "expectedOutput": "activity_template, activity_execution, activity_variants, variant_performance_metrics, vessel_registry, users, sessions, organizations, projects, subscriptions, api_keys, audit_logs, schema_versions"
    },
    {
      "impulseId": "validation-schema-init-case-10",
      "name": "All 8 indexes exist",
      "input": "surreal sql 'INFO FOR DB;'",
      "expectedOutput": "activity_template_id_idx, activity_template_category_idx, activity_template_org_idx, activity_execution_id_idx, activity_execution_template_idx, activity_execution_status_idx, vessel_registry_pod_name_idx, vessel_registry_status_idx"
    }
  ],
  "harnessImpulseId": "harness-Database Schema Initialization - Automatic Schema Creation on Fresh Deployment",
  "commitHash": "7ff2003",
  "usage": {
    "command": "./tests/validation-harnesses/schema-init-harness.sh",
    "interactive": "User confirms before destructive tests",
    "automated": "echo 'yes' | ./tests/validation-harnesses/schema-init-harness.sh",
    "requirements": [
      "kubectl configured",
      "helmfile installed",
      "metabob-apps cloned",
      "cluster access"
    ]
  },
  "validationStrategy": {
    "phase1": {
      "name": "Configuration validation",
      "type": "non-destructive",
      "tests": [1, 2, 3]
    },
    "phase2": {
      "name": "Deployment tests",
      "type": "destructive",
      "requiresConfirmation": true,
      "tests": [4, 5, 6, 7]
    },
    "phase3": {
      "name": "Runtime validation",
      "type": "read-only",
      "tests": [8, 9, 10]
    }
  },
  "exitCodes": {
    "0": "All tests passed - specification is VALID",
    "1": "One or more tests failed - specification is INVALID"
  }
}
