# Dockerfile.substrate — single-container autonomous development substrate
#
# Runs the entire vessel fleet under systemd PID 1.
# All inter-vessel calls are localhost — no trust boundary to cross.
#
# Build:
#   docker build -f Dockerfile.substrate -t metabob/substrate:dev .
#
# Run:
#   docker run --rm -it \
#     -e JWT_SECRET=<secret> \
#     -e SURREAL_PASS=<pass> \
#     -e METABOB_API_KEY=<key> \
#     -e ANTHROPIC_API_KEY=<key> \
#     -v $(pwd)/workspace:/workspace \
#     --tmpfs /run --tmpfs /run/lock \
#     metabob/substrate:dev

FROM debian:bookworm-slim AS base

# systemd requires these
ENV container=docker
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    systemd \
    systemd-sysv \
    dbus \
    curl \
    ca-certificates \
    unzip \
    git \
    jq \
    redis-server \
    && rm -rf /var/lib/apt/lists/* \
    # Remove units that try to mount real hardware or start udev
    && systemctl mask \
        dev-hugepages.mount \
        sys-fs-fuse-connections.mount \
        systemd-remount-fs.service \
        systemd-udev-settle.service \
        systemd-udevd.service \
        getty.target \
        serial-getty@.service \
        console-getty.service \
        systemd-journald-audit.socket

# --- Bun ---
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH=/root/.bun/bin:$PATH

# --- SurrealDB ---
ARG SURREAL_VERSION=2.3.3
RUN curl -sSf https://install.surrealdb.com | sh -s -- --version v${SURREAL_VERSION}

# --- Valkey (provided by redis-server installed above) ---
# redis-server is Redis-compatible; symlink as valkey-server for unit naming consistency
RUN ln -s /usr/bin/redis-server /usr/local/bin/valkey-server

# --- Vessel sources ---
WORKDIR /vessels

# Copy shared packages first (used by multiple vessels)
COPY packages ./packages

# discovery-vessel
COPY repos/discovery-vessel/package.json repos/discovery-vessel/bun.lock* ./discovery-vessel/
RUN cd discovery-vessel && bun install --frozen-lockfile
COPY repos/discovery-vessel/src ./discovery-vessel/src
COPY repos/discovery-vessel/index.ts ./discovery-vessel/
COPY repos/discovery-vessel/tsconfig.json ./discovery-vessel/

# identity-vessel
COPY repos/identity-vessel/package.json repos/identity-vessel/bun.lock* ./identity-vessel/
RUN cd identity-vessel && \
    sed -i 's|file:../../packages/vessel-discovery-client|file:/vessels/packages/vessel-discovery-client|g' package.json && \
    bun install
COPY repos/identity-vessel/src ./identity-vessel/src
COPY repos/identity-vessel/sql ./identity-vessel/sql
COPY repos/identity-vessel/tsconfig.json ./identity-vessel/

# activity-api
COPY repos/activity-api/package.json repos/activity-api/bun.lock* ./activity-api/
RUN cd activity-api && bun install --frozen-lockfile
COPY repos/activity-api/src ./activity-api/src
COPY repos/activity-api/sql ./activity-api/sql
COPY repos/activity-api/scripts ./activity-api/scripts
COPY repos/activity-api/tsconfig.json ./activity-api/

# ias-executor-ts (shared executor library for goal-host, local-tools, llm-resolver vessels)
# `dist/` is built in-container from `src/` — NOT copied from the host. The host
# `dist/` is gitignored, so a fresh clone has none; copying it would make the
# build depend on whatever a prior local build happened to leave behind (or fail
# outright). Building here keeps the image reproducible on any device.
COPY repos/ias-executor-ts/package.json repos/ias-executor-ts/bun.lock* ./ias-executor-ts/
COPY repos/ias-executor-ts/src ./ias-executor-ts/src
COPY repos/ias-executor-ts/tsconfig*.json ./ias-executor-ts/
RUN cd ias-executor-ts && bun install --frozen-lockfile && bun run build

# cpg-inference-ts (shared code analysis library for analysis-vessel)
# tree-sitter runs via web-tree-sitter (WASM) so there is no node-gyp native
# build here — works on arm64 and x86_64 alike. The vendored grammar `.wasm`
# files must be copied in; the parser loads them from `../wasm/` at runtime.
# `dist/` is built in-container (gitignored on the host — see ias-executor-ts).
COPY repos/cpg-inference-ts/package.json repos/cpg-inference-ts/bun.lock* ./cpg-inference-ts/
COPY repos/cpg-inference-ts/src ./cpg-inference-ts/src
COPY repos/cpg-inference-ts/wasm ./cpg-inference-ts/wasm
COPY repos/cpg-inference-ts/tsconfig*.json ./cpg-inference-ts/
RUN cd cpg-inference-ts && bun install --frozen-lockfile && bun run build

# development-vessel
COPY repos/development-vessel/package.json repos/development-vessel/bun.lock* ./development-vessel/
RUN cd development-vessel && bun install --frozen-lockfile
COPY repos/development-vessel/src ./development-vessel/src
COPY repos/development-vessel/tsconfig.json ./development-vessel/

# local-tools-vessel
COPY repos/local-tools-vessel/package.json ./local-tools-vessel/
RUN cd local-tools-vessel && \
    sed -i 's|file:../ias-executor-ts|file:/vessels/ias-executor-ts|g' package.json && \
    bun install
COPY repos/local-tools-vessel/src ./local-tools-vessel/src
COPY repos/local-tools-vessel/tsconfig.json ./local-tools-vessel/

# llm-resolver-vessel
COPY repos/llm-resolver-vessel/package.json repos/llm-resolver-vessel/bun.lock* ./llm-resolver-vessel/
RUN cd llm-resolver-vessel && \
    sed -i 's|file:../ias-executor-ts|file:/vessels/ias-executor-ts|g' package.json && \
    bun install
COPY repos/llm-resolver-vessel/src ./llm-resolver-vessel/src
COPY repos/llm-resolver-vessel/tsconfig.json ./llm-resolver-vessel/

# goal-host-vessel
COPY repos/goal-host-vessel/package.json ./goal-host-vessel/
RUN cd goal-host-vessel && \
    sed -i 's|file:../ias-executor-ts|file:/vessels/ias-executor-ts|g' package.json && \
    bun install
COPY repos/goal-host-vessel/src ./goal-host-vessel/src
COPY repos/goal-host-vessel/tsconfig.json ./goal-host-vessel/

# boredom-vessel
COPY repos/boredom-vessel/package.json repos/boredom-vessel/bun.lock* ./boredom-vessel/
RUN cd boredom-vessel && bun install
COPY repos/boredom-vessel/src ./boredom-vessel/src
COPY repos/boredom-vessel/tsconfig.json ./boredom-vessel/

# ribosome-vessel
COPY repos/ribosome-vessel/package.json repos/ribosome-vessel/bun.lock* ./ribosome-vessel/
RUN cd ribosome-vessel && bun install
COPY repos/ribosome-vessel/src ./ribosome-vessel/src
COPY repos/ribosome-vessel/tsconfig.json ./ribosome-vessel/

# concept-db
COPY repos/concept-db/package.json repos/concept-db/bun.lock* ./concept-db/
RUN cd concept-db && bun install
COPY repos/concept-db/src ./concept-db/src
COPY repos/concept-db/sql ./concept-db/sql
COPY repos/concept-db/scripts ./concept-db/scripts
COPY repos/concept-db/tsconfig.json ./concept-db/

# analysis-vessel (replaces metabob-analysis-api; depends on cpg-inference-ts above)
COPY repos/analysis-vessel/package.json ./analysis-vessel/
RUN cd analysis-vessel && \
    sed -i 's|file:../ias-executor-ts|file:/vessels/ias-executor-ts|g' package.json && \
    sed -i 's|file:../cpg-inference-ts|file:/vessels/cpg-inference-ts|g' package.json && \
    bun install
COPY repos/analysis-vessel/src ./analysis-vessel/src
COPY repos/analysis-vessel/tsconfig.json ./analysis-vessel/

# stateful-ui-vessel (substrate's face — port 8270)
COPY repos/stateful-ui-vessel/package.json ./stateful-ui-vessel/
RUN cd stateful-ui-vessel && bun install
COPY repos/stateful-ui-vessel/src ./stateful-ui-vessel/src
COPY repos/stateful-ui-vessel/tsconfig.json ./stateful-ui-vessel/

# light-dispatch-vessel (stateless dispatcher — :8280). LOAD-BEARING: boredom
# routes EVERY autonomous dispatch through this vessel; if it's absent the whole
# loop livelocks (the unit's own comment warns this).
COPY repos/light-dispatch-vessel/package.json repos/light-dispatch-vessel/bun.lock* ./light-dispatch-vessel/
RUN cd light-dispatch-vessel && bun install
COPY repos/light-dispatch-vessel/src ./light-dispatch-vessel/src
COPY repos/light-dispatch-vessel/tsconfig.json ./light-dispatch-vessel/

# metric-collector-vessel
COPY repos/metric-collector-vessel/package.json repos/metric-collector-vessel/bun.lock* ./metric-collector-vessel/
RUN cd metric-collector-vessel && bun install
COPY repos/metric-collector-vessel/src ./metric-collector-vessel/src
COPY repos/metric-collector-vessel/tsconfig.json ./metric-collector-vessel/

# --- Substrate runtime config ---
RUN mkdir -p /etc/substrate /workspace /var/lib/surrealdb /scripts

COPY scripts/substrate/units/ /etc/systemd/system/
COPY scripts/substrate/entrypoint.sh /usr/local/bin/substrate-entrypoint
COPY scripts/substrate/gen-env.sh /usr/local/bin/gen-env
COPY scripts/substrate/setup-git-push.sh /usr/local/bin/setup-git-push
# Side-loop tick scripts referenced by their .service units' ExecStart. Without
# these baked in, the units exit 127 (command not found) on every fire — which is
# how obsidian-learn + goal-host-behavior (two LEARNING loops) sat silently dead
# after a container recreate. (Now also surfaced by systemd_unit_health_observer.)
COPY scripts/substrate/obsidian-learn-tick.sh /usr/local/bin/obsidian-learn-tick.sh
COPY scripts/substrate/goal-host-behavior-tick.sh /usr/local/bin/goal-host-behavior-tick.sh
COPY scripts/substrate/light-dispatch-healthcheck.sh /usr/local/bin/light-dispatch-healthcheck
RUN chmod +x /usr/local/bin/obsidian-learn-tick.sh /usr/local/bin/goal-host-behavior-tick.sh /usr/local/bin/light-dispatch-healthcheck
COPY scripts/substrate/seed-identity.ts /vessels/seed-identity.ts
COPY scripts/substrate/seed-concepts.ts /vessels/seed-concepts.ts
COPY scripts/bootstrap-seeder.ts /scripts/bootstrap-seeder.ts

RUN chmod +x /usr/local/bin/substrate-entrypoint /usr/local/bin/gen-env /usr/local/bin/setup-git-push && \
    systemctl enable \
        git-push-setup.service \
        surrealdb.service \
        valkey.service \
        discovery-vessel.service \
        identity-vessel.service \
        activity-api.service \
        development-vessel.service \
        local-tools-vessel.service \
        llm-resolver-vessel.service \
        goal-host-vessel.service \
        bootstrap-seeder.service \
        boredom-vessel.timer \
        ribosome-vessel.service \
        concept-db.service \
        concept-db-seeder.service \
        analysis-vessel.service \
        stateful-ui-vessel.service \
        light-dispatch-vessel.service \
        light-dispatch-healthcheck.timer \
        journald-stdout-forwarder.service \
        m1-trainer.timer \
        funnel-drain.timer \
        composition-edge-reconcile.timer \
        model-reality-audit.timer \
        observe-orthogonal-refresh.timer \
        spectral-gap.timer \
        autonomy-metrics.timer \
        self-operational-health.timer \
        self-repair-operational.timer

# SurrealDB writes the learning state (traces, Thompson posteriors, concept
# graph) to file:/var/lib/surrealdb/data.db. Declaring it a volume — like
# /workspace — documents that it must be bind-mounted (see the Makefile run-live
# targets); otherwise the state lands in the ephemeral container layer.
VOLUME ["/workspace", "/var/lib/surrealdb"]

STOPSIGNAL SIGRTMIN+3

ENTRYPOINT ["/usr/local/bin/substrate-entrypoint"]

# ──────────────────────────────────────────────────────────────────────────
# substrate-obsidian — base fleet + an in-container Obsidian desktop as the
# primary interface, reachable from a browser via noVNC.
#
#   docker build -f Dockerfile.substrate --target substrate-obsidian \
#       -t metabob/substrate:obsidian .
#
# In this flavour Obsidian stops being a host peer (host.docker.internal:27183)
# and becomes an in-substrate citizen: the obsidian-vessel plugin talks to
# activity-api / concept-db over plain localhost. Operator opens the GUI at
# http://localhost:16080/vnc.html (host-mapped from the container's :6080).
# ──────────────────────────────────────────────────────────────────────────
FROM base AS substrate-obsidian

# GUI + remote-access stack. The Electron runtime libs (libnss3/gtk/asound/gbm)
# are what an extracted Obsidian AppImage needs to start under Xvfb.
RUN apt-get update && apt-get install -y --no-install-recommends \
        xvfb x11vnc fluxbox novnc websockify \
        libnss3 libgtk-3-0 libasound2 libgbm1 libdrm2 libxshmfence1 \
        libgtk-3-bin xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# Obsidian desktop. AppImage is extracted (no FUSE inside the container).
ARG OBSIDIAN_VERSION=1.6.7
RUN curl -fsSL -o /tmp/obsidian.AppImage \
        "https://github.com/obsidianmd/obsidian-releases/releases/download/v${OBSIDIAN_VERSION}/Obsidian-${OBSIDIAN_VERSION}.AppImage" \
    && cd /opt && chmod +x /tmp/obsidian.AppImage \
    && /tmp/obsidian.AppImage --appimage-extract \
    && mv squashfs-root /opt/obsidian && rm -f /tmp/obsidian.AppImage \
    && ln -sf /opt/obsidian/obsidian.png /opt/obsidian/icon.png 2>/dev/null || true

# obsidian-vessel plugin — built IN the substrate so it is directly editable.
# The source lives at /vessels/obsidian-vessel (like every other vessel); the
# vault's plugin files are symlinks to the build artifacts, so the dev loop is
# edit → rebuild (bun esbuild) → restart-obsidian-vessel. esbuild.config.mjs
# uses esbuild as a library, so it runs under bun (the base image has no node).
COPY repos/obsidian-vessel/package.json repos/obsidian-vessel/bun.lock* ./obsidian-vessel/
RUN cd obsidian-vessel && bun install
COPY repos/obsidian-vessel/src ./obsidian-vessel/src
COPY repos/obsidian-vessel/styles ./obsidian-vessel/styles
COPY repos/obsidian-vessel/esbuild.config.mjs \
     repos/obsidian-vessel/manifest.json \
     repos/obsidian-vessel/tsconfig.json \
     ./obsidian-vessel/
RUN cd obsidian-vessel && bun esbuild.config.mjs production

# Seed vault: the committed vault/ (notes + data.json) with the plugin's three
# loadable files symlinked to the in-container build artifacts. Rebuilding the
# plugin updates main.js in place; restarting obsidian-desktop reloads it.
# data.json stays a real file — re-pointed from host ports (18080/18260) to
# in-container ports at boot by obsidian-desktop-launch.
COPY vault/ /vaults/substrate-vault/
RUN PLUGIN_DIR=/vaults/substrate-vault/.obsidian/plugins/metabob-vessel \
    && mkdir -p "$PLUGIN_DIR" \
    && rm -f "$PLUGIN_DIR/main.js" "$PLUGIN_DIR/manifest.json" "$PLUGIN_DIR/styles.css" \
    && ln -sf /vessels/obsidian-vessel/main.js           "$PLUGIN_DIR/main.js" \
    && ln -sf /vessels/obsidian-vessel/manifest.json     "$PLUGIN_DIR/manifest.json" \
    && ln -sf /vessels/obsidian-vessel/styles/styles.css "$PLUGIN_DIR/styles.css" \
    && printf '%s\n' '["metabob-vessel"]' \
        > /vaults/substrate-vault/.obsidian/community-plugins.json

COPY scripts/substrate/obsidian-xorg-launch.sh /usr/local/bin/obsidian-xorg-launch
COPY scripts/substrate/obsidian-desktop-launch.sh /usr/local/bin/obsidian-desktop-launch
RUN chmod +x /usr/local/bin/obsidian-xorg-launch /usr/local/bin/obsidian-desktop-launch \
    && systemctl enable obsidian-xorg.service obsidian-desktop.service novnc.service

# In this flavour the vault is in-container on localhost, so the side-loop
# learner targets 127.0.0.1:27183 instead of the host-peer default. Drop-in
# override keeps the shared unit's host-Obsidian default intact for other images.
RUN mkdir -p /etc/systemd/system/obsidian-learn.service.d \
    && printf '[Service]\nEnvironment=OBSIDIAN_LEARN_ENDPOINT=http://127.0.0.1:27183\n' \
        > /etc/systemd/system/obsidian-learn.service.d/override.conf

ENTRYPOINT ["/usr/local/bin/substrate-entrypoint"]
