{
  "specificationName": "impulse-usage-tracking",
  "harnessFile": "tests/validation-harnesses/impulse-usage-tracking-harness.ts",
  "harnessImpulseId": "harness-impulse-usage-tracking",
  "testCases": [
    {
      "impulseId": "validation-impulse-usage-tracking-case-1",
      "testCase": "case-1-activity-with-impulses",
      "description": "Validates that an activity using impulses sends correct tracking data",
      "inputFile": "tests/validation-harnesses/test-cases/impulse-usage-tracking-case-1.json",
      "input": {
        "activityType": "activity-with-impulses",
        "impulsesCount": 2,
        "impulseTokens": 50,
        "totalInputTokens": 200
      },
      "expectedOutput": {
        "impulsesLoaded": {
          "minLength": 1
        },
        "impulsesCreated": {
          "isArray": true
        },
        "contextRatio": {
          "min": 0,
          "max": 1,
          "expectedValue": 0.5
        },
        "tokens": {
          "hasBreakdown": true,
          "fields": ["input", "output", "cache"]
        }
      }
    },
    {
      "impulseId": "validation-impulse-usage-tracking-case-2",
      "testCase": "case-2-created-impulses",
      "description": "Validates that newly created impulses are tracked in impulsesCreated array",
      "inputFile": "tests/validation-harnesses/test-cases/impulse-usage-tracking-case-2.json",
      "input": {
        "activityType": "activity-creating-impulses",
        "createdImpulsesCount": 1,
        "impulsesLoadedCount": 0
      },
      "expectedOutput": {
        "impulsesLoaded": {
          "isArray": true
        },
        "impulsesCreated": {
          "minLength": 1
        },
        "contextRatio": {
          "min": 0,
          "max": 1,
          "expectedValue": 0
        },
        "tokens": {
          "hasBreakdown": true,
          "fields": ["input", "output", "cache"]
        }
      }
    },
    {
      "impulseId": "validation-impulse-usage-tracking-case-3",
      "testCase": "case-3-context-ratio",
      "description": "Validates that context_ratio is calculated correctly as impulseTokens / totalInputTokens",
      "inputFile": "tests/validation-harnesses/test-cases/impulse-usage-tracking-case-3.json",
      "input": {
        "activityType": "activity-with-context-ratio-calculation",
        "impulseTokens": 50,
        "totalInputTokens": 200,
        "expectedRatio": 0.25
      },
      "expectedOutput": {
        "impulsesLoaded": {
          "minLength": 1
        },
        "impulsesCreated": {
          "isArray": true
        },
        "contextRatio": {
          "min": 0.24,
          "max": 0.26,
          "expectedValue": 0.25
        },
        "tokens": {
          "hasBreakdown": true,
          "fields": ["input", "output", "cache"]
        }
      }
    }
  ],
  "validationStrategy": {
    "approach": "Mock backend API to intercept reportExecutionStep calls",
    "mockClass": "MockBackend",
    "interceptedFunction": "MetabobCLI.reportExecutionStep",
    "capturedData": [
      "executionId",
      "stepOrder",
      "impulsesLoaded",
      "impulsesCreated",
      "contextRatio",
      "tokens"
    ],
    "verifications": [
      "impulsesLoaded is a non-empty array when impulses are used",
      "impulsesCreated is an array (may be empty or non-empty)",
      "contextRatio is a number between 0 and 1",
      "tokens is an object with input, output, and cache fields",
      "contextRatio calculation is accurate (impulseTokens / totalInputTokens)"
    ]
  },
  "runInstructions": {
    "cli": "bun run tests/validation-harnesses/impulse-usage-tracking-harness.ts",
    "programmatic": "import { runValidation } from './tests/validation-harnesses/impulse-usage-tracking-harness'; const result = await runValidation();",
    "exitCodes": {
      "0": "All tests passed",
      "1": "One or more tests failed"
    }
  },
  "benefits": [
    "No LLM required - tests run without API calls",
    "Fast feedback - instant validation of changes",
